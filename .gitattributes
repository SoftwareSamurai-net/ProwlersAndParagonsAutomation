# Normalise line endings so Windows checkouts and the Linux CI runners agree.
# Text files are stored LF in the repository and checked out per-platform.
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.sln       text eol=crlf
*.json      text
*.md        text
*.yml       text
*.yaml      text
*.editorconfig text
*.gitattributes text

# Read by tests that search for LF-joined text — a paragraph's end as two newlines, a twin's
# substituted line — so a CRLF checkout failed them on every Windows machine while CI on Linux
# passed. Pinned LF on every platform; nothing reads either file expecting CRLF.
mcp-play/PLAY-POLICY.md      text eol=lf
data/rules/play/combat.json  text eol=lf

# Binary — never touch these.
*.pdf       binary
*.png       binary
*.jpg       binary
*.ico       binary
