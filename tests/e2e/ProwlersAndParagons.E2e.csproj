<Project Sdk="Microsoft.NET.Sdk">

    <!-- Drives the assembled application with Playwright, and measures its accessibility with
         axe-core. The sixth thing that drives this project and the second that drives the *whole*
         of it: `scripts/e2e/drive.mjs` is the first, is green, and stays until this one has a
         track record — see PROGRESS.md item 10 for the condition under which it is retired.

         **This project references nothing in the repository, and that is the answer to "where
         does it live".** The obvious alternative was folding it into
         tests/ProwlersAndParagons.Web.Tests, which is documented as the only project that may
         reference web/ — and that is exactly the wrong home: a bUnit project reaches components
         by hand, and the whole argument for a driver is that reaching a feature by hand cannot
         notice that nothing else reaches it. This one knows a URL and nothing else. Target
         framework, nullability and the analyzer contract come from the repository root's
         Directory.Build.props, shared with every other project.

         **Not a test project, deliberately.** It reports *verdicts* — `E2E CHECK BOOT: PASS` —
         rather than test counts, because scripts/e2e.sh reads those lines to decide whether a
         deliberately-broken twin of the site turned the right check red. A `dotnet test` runner
         would give a pass/fail count and no way to say "this check said FAIL, which is what the
         twin needed". It is also why ./scripts/count-tests.sh does not know about this directory
         and should not: a suite whose figure is "nine checks" beside four suites' thousands makes
         the total meaningless. docs/guide/testing.md says so in as many words. -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>ProwlersAndParagons.E2e</RootNamespace>
        <AssemblyName>ProwlersAndParagons.E2e</AssemblyName>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Playwright drives the browser. **It does not bring a browser with it here**, which is
             the constraint that decided this whole design: `Channel = "chrome"` launches the
             Google Chrome already on the machine, so `playwright install` never runs, no ~150 MB
             of Chromium is downloaded, no Actions cache is needed, and this repository does not
             gain a *third* renderer beside the runner's own Chrome and the digest-pinned
             selenium/standalone-chrome the pixel goldens need. See docs/guide/testing.md on why
             a third one would mean regenerating every golden. Measured: Chrome 152 launched from
             this package with no install step, on Windows and on the runner.

             What the package *does* ship is its own Node driver (~90 MB of node.exe under
             .playwright/), which is why there is still no package.json and no npm dependency —
             the rule was about npm, and this is a NuGet restore. -->
        <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />

        <!-- axe-core, run inside the page Playwright is already driving. This is the half of the
             work that is genuinely new rather than a port: `theme.css` writes contrast ratios into
             its comments as *claims* ("7.5:1", "9.5:1"), two of its tokens are `color-mix()` which
             only a browser resolves, and nothing in this repository measured either in the
             assembled app. -->
        <PackageReference Include="Deque.AxeCore.Playwright" Version="4.13.0" />
    </ItemGroup>

</Project>
