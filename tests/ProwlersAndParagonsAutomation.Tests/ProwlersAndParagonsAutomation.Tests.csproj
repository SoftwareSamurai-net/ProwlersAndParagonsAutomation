<Project Sdk="Microsoft.NET.Sdk">

    <!-- Target framework, nullability and the analyzer contract come from the repository
         root's Directory.Build.props, shared with every other project. -->

    <PropertyGroup>
        <!-- xunit.v3 test projects are executables. -->
        <OutputType>Exe</OutputType>
        <RootNamespace>ProwlersAndParagonsAutomation.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>

    <ItemGroup>
        <!-- The CLI, which brings engine and sheets with it. The suite covers all three:
             it asserts on the rules data, on the engine's arithmetic, and on the text
             sheet the exporter writes. -->
        <ProjectReference Include="..\..\ProwlersAndParagonsAutomation.csproj" />
    </ItemGroup>

</Project>
