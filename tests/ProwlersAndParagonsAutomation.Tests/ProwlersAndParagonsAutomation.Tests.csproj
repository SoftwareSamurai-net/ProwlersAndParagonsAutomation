<Project Sdk="Microsoft.NET.Sdk">

    <!-- Target framework, nullability and the analyzer contract come from the repository
         root's Directory.Build.props, shared with every other project. -->

    <PropertyGroup>
        <!-- xunit.v3 test projects are executables. -->
        <OutputType>Exe</OutputType>
        <RootNamespace>ProwlersAndParagonsAutomation.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>

    <ItemGroup>
        <!-- The CLI, which brings engine and sheets with it. The suite covers all three:
             it asserts on the rules data, on the engine's arithmetic, and on the text
             sheet the exporter writes. -->
        <ProjectReference Include="..\..\ProwlersAndParagonsAutomation.csproj" />

        <!-- The MCP server, which is a front end like the CLI and is tested here for the same
             reason: it is driven through streams rather than a terminal, so a failure names a
             line. Only web/ has a test project of its own, because rendering components needs
             one. -->
        <ProjectReference Include="..\..\mcp\ProwlersAndParagons.Mcp.csproj" />

        <!-- The corpus generator. Referenced so that the part of it CI can actually run — the
             column geometry, which decides reading order — is driven against synthetic pages.
             Everything else in the tool needs the publisher's PDF, which is gitignored and is
             not on a build agent, so the corpus itself is committed and asserted as data. -->
        <ProjectReference Include="..\..\tools\RulebookExtractor\RulebookExtractor.csproj" />

        <!-- The second engine — play/ — which resolves an action where engine/ costs and
             validates a character. It is referenced here and nowhere else in the solution: the
             hosts arrive in a later slice, and PlayContractTests requires engine/ and sheets/
             never to reference it back. -->
        <ProjectReference Include="..\..\play\ProwlersAndParagons.Play.csproj" />
    </ItemGroup>

</Project>
