<Project Sdk="Microsoft.NET.Sdk">

    <!-- The terminal wizard. Everything shared with the browser front end lives in
         engine/ (rules and arithmetic) and sheets/ (the .txt and .json exports); what is
         left here is Spectre.Console presentation and the file writing. -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>ProwlersAndParagonsAutomation</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- This project sits at the repository root, so the default **/*.cs glob would
             otherwise pull in every sibling project's sources alongside its own. -->
        <Compile Remove="engine\**" />
        <Compile Remove="play\**" />
        <Compile Remove="sheets\**" />
        <Compile Remove="web\**" />
        <Compile Remove="mcp\**" />
        <Compile Remove="mcp-shared\**" />
        <Compile Remove="mcp-play\**" />
        <Compile Remove="tests\**" />
        <Compile Remove="tools\**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="engine\ProwlersAndParagons.Engine.csproj" />
        <ProjectReference Include="sheets\ProwlersAndParagons.Sheets.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Pinned exactly: a floating 0.49.* made restores non-reproducible. -->
        <PackageReference Include="Spectre.Console" Version="0.57.2" />
    </ItemGroup>

    <ItemGroup>
        <!-- Rules data ships beside the binary so a published build works without the
             repo present. Program.FindProjectRoot still prefers the repo copy in dev. -->
        <Content Include="data\rules\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="data\rules\" />
    </ItemGroup>

</Project>
