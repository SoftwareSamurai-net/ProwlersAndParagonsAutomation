     protected override void OnInitialized() => Session.Changed += StateHasChanged;
 
+    /// <summary>
+    /// The element holding the spent figure, so it can be counted to its new value.
+    /// </summary>
+    private ElementReference? _figure;
+
+    /// <summary>
+    /// The figure currently on screen — the one a count would start from.
+    ///
+    /// <para>Held here rather than read back out of the element because <b>the number in the DOM
+    /// is already the new one by the time this runs</b>: Blazor writes the render before
+    /// OnAfterRender, so reading it would count from the answer to the answer.</para>
+    /// </summary>
+    private int? _shown;
+
+    /// <summary>
+    /// Count the spent figure from what was on screen to what the engine now says.
+    ///
+    /// <para><b>Both ends are the engine's.</b> Nothing here predicts a figure — the count is an
+    /// interpolation between two answers <c>CostCalculator</c> gave, and the script assigns the
+    /// final frame rather than computing it, so what comes to rest is the answer exactly.</para>
+    ///
+    /// <para>An uncostable character leaves the figure alone. There is no number to count to, and
+    /// the strip says so in words instead.</para>
+    /// </summary>
+    protected override async Task OnAfterRenderAsync(bool firstRender)
+    {
+        _ = firstRender;
+
+        if (_figure is not { } figure) return;
+
+        var spent = CharacterSession.TryCost(() => Session.Spent);
+        if (spent is null || _shown == spent.Value) return;
+
+        // First sight of a figure is not a change: there is nothing it moved from, and counting
+        // up from zero on load would animate a character the visitor did not just build.
+        var from = _shown ?? spent.Value;
+        _shown = spent.Value;
+
+        await Js.InvokeVoidAsync("ppCount", figure, from, spent.Value);
+    }
+
     private static string Cost(Func<int> cost) =>
         CharacterSession.TryCost(cost)?.ToString() ?? "—";
 
