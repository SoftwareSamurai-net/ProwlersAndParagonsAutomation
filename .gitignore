bin/
obj/
/packages/
riderModule.iml
/_ReSharper.Caches/

# Qodana local scan cache and reports
.qodana/
qodana.sarif.json
# scripts/qodana-scan.sh's export and results. Under the repository rather than /tmp on purpose —
# Docker Desktop cannot see Git Bash's /tmp, and a mount it cannot see is an empty directory.
.qodana-scan/

# Generated character sheets — user output, not source
output/

# The published browser front end. Both .github/workflows/build.yml and deploy.yml publish
# here, so it appears in any checkout where somebody has reproduced a CI step locally — which
# is the recommended way to check the Content-Security-Policy before pushing.
publish/

# The published MCP server. The README tells a stranger to publish it here and point their
# client at the binary, so the directory appears in a checkout that has followed the setup.
mcp-server/

# Source PDFs — obtain separately; never tracked in version control. The rulebook is
# copyright LakeSide Games and must not be redistributed with this tool, so this is
# deliberately broad rather than scoped to docs/. CI fails the build if one is tracked.
*.pdf

# Rules data staged into the browser build. data/rules/ is the one copy in the repository;
# web/ProwlersAndParagons.Web.csproj copies it here so the static site can serve it.
web/wwwroot/data/

# Rider/IntelliJ project metadata. Editor-local; the repository settles style in
# .editorconfig and Directory.Build.props, which every tool reads.
.idea/
.vs/
*.user

# Qodana writes its report here when the scan is run locally (see README). The second name
# is for a scan run beside an existing report rather than over it, which is how a before and
# after are compared.
results/
results-mcp/

# Generated by ProofPages when PP_PROOF is set: static renders of the real
# components, for screenshotting and printing. Never part of the site.
web/wwwroot/proof-*.html

# Node and wrangler working directories. Nothing in this repository has a package.json:
# the accounts server is dependency-free JavaScript, and its tests run under `node --test`
# or in Docker. These appear if somebody installs wrangler to apply a D1 migration.
node_modules/
package-lock.json
.wrangler/

# The local half of the accounts server's configuration: a real Resend key, read by
# `wrangler pages dev` and by `scripts/probe-mail.mjs`. It holds a live credential, so it is
# ignored here rather than relied on to be remembered — the same reasoning that keeps the key
# out of this repository in the first place.
.dev.vars

# scripts/visual-regression.sh's scratch space: the screenshots it just took and the diff
# images it drew. Working output, not source — tests/visual-goldens/ is the committed half.
.visual-regression/
