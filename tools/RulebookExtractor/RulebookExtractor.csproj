<Project Sdk="Microsoft.NET.Sdk">

    <!-- Regenerates data/rulebook/ from the publisher's PDF.

         This is a tool, not part of the app: nothing in engine/, sheets/, cli/, web/ or mcp/
         references it, and the corpus it writes is committed, so a normal build never runs it.
         It is in the solution all the same, because the first version of this extractor was a
         throwaway scratch project that no longer existed by the time its output was found to be
         wrong — which meant the corpus could be neither audited nor regenerated. See
         docs/RULEBOOK-COVERAGE.md. -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>ProwlersAndParagonsAutomation.Tools.RulebookExtractor</RootNamespace>
        <AssemblyName>RulebookExtractor</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="PdfPig" Version="0.1.15" />
    </ItemGroup>

    <ItemGroup>
        <!-- ColumnLayout is where the reading order is decided, and it is the part that cannot be
             judged from the shipped corpus: the data cannot show you a page layout it happens not
             to contain. Nothing ran this code in CI, so an extractor regression stayed invisible
             until somebody regenerated by hand. The tests drive it against made-up pages. -->
        <InternalsVisibleTo Include="ProwlersAndParagonsAutomation.Tests" />
    </ItemGroup>

</Project>
