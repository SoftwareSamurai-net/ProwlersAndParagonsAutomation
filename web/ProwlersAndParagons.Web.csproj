<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <!-- The browser front end. It ships as a static site: the engine compiles to
         WebAssembly and runs CostCalculator and CharacterValidator as the same code the
         CLI runs, which is the whole reason this is Blazor and not a JavaScript SPA
         talking to an API. See PROGRESS.md. -->

    <PropertyGroup>
        <RootNamespace>ProwlersAndParagonsAutomation.Web</RootNamespace>
        <AssemblyName>ProwlersAndParagons.Web</AssemblyName>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

        <!-- Trimmed, with ProwlersAndParagons.Engine rooted below. RulesRepository
             deserializes the rules with reflection-based System.Text.Json, so an untrimmed
             engine keeps every model property the trimmer can only see through reflection —
             the failure mode this project cannot afford is a build that succeeds and a
             rules set that comes back silently empty at runtime.

             **Measured on a clean export of main, Docker, mcr.microsoft.com/dotnet/sdk:10.0,
             Linux, no wasm-tools workload needed because nothing here calls ILCompiler
             directly.** wwwroot went from 30,740,741 bytes across 209 _framework files to
             12,673,358 bytes across 47 — System.Private.Xml, System.Private.DataContractSerialization
             and System.Data.Common disappear entirely — and ProwlersAndParagons.Engine.wasm,
             Sheets.wasm and Web.wasm came back byte-identical to the untrimmed build: only
             Engine needed rooting, and rooting Sheets or Web besides it changed nothing.

             **"It built with 0 warnings" is not the evidence, and PROGRESS.md item 5 says so
             in as many words**: the trim analyzer has nothing to warn about for a reflective
             JsonSerializer.Deserialize<T> call, because it cannot see which properties that
             call will ask for at runtime. What actually proves the rules survived trimming is
             the POWERS e2e check (tests/e2e/Checks/Powers.cs) — the real drive of the
             published, trimmed site reads a Power's own Pros and Cons and a generic Pro back
             out of the rendered page, which is exactly the shape of the six-null-collections
             failure a source-generated reader hit instead (see PROGRESS.md item 5). A context
             over the rules types was tried for the same payload win and does not drop in:
             it returns null for non-nullable collections the reflective reader honours via
             their `= []` initializers, which is a different and worse silence than this one.

             See docs/guide/browser.md and docs/guide/testing.md. -->
        <PublishTrimmed>true</PublishTrimmed>

        <!-- **Explicit rather than relied-on**, though it is already the Blazor WebAssembly
             SDK's own default: Microsoft.NET.Sdk.BlazorWebAssembly.Current.targets sets
             JsonSerializerIsReflectionEnabledByDefault to true unconditionally, ahead of the
             general SDK's own targets, specifically so a trimmed Blazor app does not inherit
             whatever default those targets would otherwise give the feature switch (grepped
             in the installed 10.0.303 SDK: Microsoft.NET.Sdk.targets only forwards the MSBuild
             property into a RuntimeHostConfigurationOption when it is already set — it names
             no default of its own — while the Blazor WebAssembly targets file sets it to
             true before that happens). So this line changes nothing this project does not
             already get; it is written down because RulesRepository's reflection-based
             JsonSerializer.Deserialize<T> is the one thing a silent flip of that implicit
             default would break, and a thrown Deserialize is a site that cannot build a
             character. -->
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <ItemGroup>
        <!-- The one assembly the trimmer needs told to keep everything: RulesRepository reads
             every model in ProwlersAndParagonsAutomation.Engine through reflection-based
             System.Text.Json, so the trimmer cannot see which properties a Deserialize<T> call
             will ask for. Rooting it keeps every public member; Sheets and Web were measured
             rooted too and the output did not change, so they are not named here. -->
        <TrimmerRootAssembly Include="ProwlersAndParagons.Engine" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\engine\ProwlersAndParagons.Engine.csproj" />
        <ProjectReference Include="..\sheets\ProwlersAndParagons.Sheets.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- **This comment named the wrong member for a while, so it is worth being exact.**
             It cited CharacterStore.Read, and by the time anybody checked, nothing outside that
             class called it: the store's tests write a malformed payload into a fake local
             storage and go through LoadAsync, which drives the path the app runs rather than the
             one method underneath it. Read is private now, and Qodana said so the moment the file
             was touched.

             What actually needs this is ReplayLibrary's internal fetch overload, which
             ReplayLoadingTests hands a delegate to in order to make the fetch fail on demand —
             a missing recording must leave the app running, and that is not reachable through
             the UI. Removing this line fails several assertions in that file and nothing else;
             measured, not assumed.

             The alternative was a public test-only seam shipped in the WebAssembly payload. -->
        <InternalsVisibleTo Include="ProwlersAndParagons.Web.Tests" />
    </ItemGroup>

    <!-- The rules are served, not read: a browser has no filesystem, so Program.cs fetches
         these over HTTP and hands them to an InMemoryRulesSource.

         They are copied into wwwroot rather than committed there, so there is still one set
         of rules data in the repository — wwwroot/data/ is gitignored. A plain
         `Content Include="..\data\rules\*.json" LinkBase="wwwroot\data\rules"` looks like it
         should do this and does not: the static web asset gets a content root of wwwroot/
         while the file stays outside it, so every request answers 200 with an empty body and
         the engine reports the rules as malformed JSON. Copy first, then register.

         The recorded conversations the replay plays are deliberately NOT staged here any more.
         They used to be, the same way — every visitor's browser fetched all four before its
         first render, whether or not that visitor could ever reach the gated pages that play
         them back. They are bundled into the worker now, the same way the rulebook corpus is,
         and served only to a signed-in caller at api/transcripts; a copy under wwwroot would be
         a public URL and undo that. See worker/transcripts-corpus.js and ReplayLoader. -->
    <ItemGroup>
        <RulesDataFile Include="..\data\rules\*.json" />
    </ItemGroup>

    <!-- **A build cannot sweep a stale wwwroot/data/transcripts, and it was tried twice.**

         Ceasing to copy the transcripts does not remove a copy an earlier build already made:
         wwwroot/data/ is gitignored build output, so a tree built before that change still holds
         all four, and the test asserting only `rules` is staged goes red on a stale working tree
         rather than on a mistake.

         A `RemoveDir` looks like the fix and cannot be: **`wwwroot/**` is globbed when the project
         is evaluated, before any target runs.** So the files are already item-list members by the
         time a target could delete them, and `DefineStaticWebAssets` then fails resolving files
         that are no longer on disk — measured at both `ResolveProjectStaticWebAssets` and
         `BeforeBuild`, failing once and passing on a second run either way. CI never saw it,
         because a clean checkout has nothing stale; it is a fault that reaches a person and not
         the pipeline, which is the worse direction.

         Delete the directory by hand if a build ever complains, which is what the test now says.
         Note that a stale copy is inert as far as the deployed site goes — the deploy uploads the
         publish output, not this directory — so the guard is about not shipping the store, and a
         local leftover is a stale tree rather than an exposure. -->

    <Target Name="StageRulesDataInWwwroot" BeforeTargets="ResolveProjectStaticWebAssets">
        <!-- The failure this guards against is silent: with no rules served, the site
             loads, fetches nothing, and reports the rulebook as malformed at runtime.
             Better to fail the build. -->
        <Error Condition="'@(RulesDataFile)' == ''"
               Text="No rules files found at ..\data\rules\*.json. The browser build serves these; without them the site cannot start." />


        <Copy SourceFiles="@(RulesDataFile)"
              DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\data\rules"
              SkipUnchangedFiles="true" />

        <!-- Added here rather than in an evaluation-time ItemGroup because the files do not
             exist yet on a clean checkout, and a glob that matched nothing would leave the
             published site without its rules. -->
        <ItemGroup>
            <Content Include="wwwroot\data\rules\*.json" Exclude="@(Content)" />
        </ItemGroup>
    </Target>

    <!-- **The one narrow exemption to keeping data/rules/play/ out of this payload.** The owner's
         ruling: the reference page at /reference/resolve may show resolve.json alone, and every
         other play rules file stays out. An explicit single-file item rather than a widened glob —
         PlayPayloadTests.NoProjectGlobsTheRulesDirectoryRecursively still refuses "**", and
         NothingInTheApplicationNamesAPlayRulesFile exempts this one whole path under web/ and
         nothing else. See docs/guide/play-rules.md. -->
    <ItemGroup>
        <ResolveReferenceFile Include="..\data\rules\play\resolve.json" />
    </ItemGroup>

    <Target Name="StageResolveReferenceInWwwroot" BeforeTargets="ResolveProjectStaticWebAssets">
        <Error Condition="!Exists('..\data\rules\play\resolve.json')"
               Text="The Resolve reference file was not found. The reference page at /reference/resolve serves it; without it that page cannot start." />

        <Copy SourceFiles="@(ResolveReferenceFile)"
              DestinationFiles="$(MSBuildProjectDirectory)\wwwroot\data\rules\play\resolve.json"
              SkipUnchangedFiles="true" />

        <ItemGroup>
            <Content Include="wwwroot\data\rules\play\resolve.json" Exclude="@(Content)" />
        </ItemGroup>
    </Target>

</Project>
