@* One Ability or Talent: name, a stepper, and pips showing how the rank divides between
   what a package granted and what was bought on top. A package buys the ranks it grants,
   so those pips are already paid for — CostCalculator only charges for the rest. *@

<div class="rank-row">
    <div class="rank-name">
        @Name
        @if (Sub is not null)
        {
            <small>@Sub</small>
        }
    </div>

    @* **The pips are the control, not a picture of one.** They were `aria-hidden` decoration
       beside the stepper, which meant the only way from 2d to 9d was seven clicks on `+`.
       Clicking the fifth pip sets 5d; the arrow keys move by one; Home and End go to the ends.

       `role="slider"` rather than a radio group: a rank is a value on a range, the range is
       bounded and ordered, and one focusable element beats twelve. The stepper stays — it is
       discoverable, it is a bigger touch target, and a slider and its buttons are an ordinary
       pairing.

       **The individual pips stay `aria-hidden`.** They are the slider's own rendering, and a
       reader told "4d Noteworthy, slider" does not also want twelve unlabelled children. *@
    <div class="pips"
         role="slider"
         tabindex="0"
         aria-label="@($"{Name} rank")"
         aria-valuemin="@Min"
         aria-valuemax="@Max"
         aria-valuenow="@Rank"
         aria-valuetext="@ValueText"
         @onkeydown="Key">
        @for (var i = 1; i <= Max; i++)
        {
            var rank = i;
            var cls = i <= PackageFloor ? "pip on package" : i <= Rank ? "pip on" : "pip";
            <span class="@cls" aria-hidden="true" @onclick="() => Set(rank)"></span>
        }
    </div>

    <div class="stepper">
        <button type="button" aria-label="@($"Lower {Name}")"
                disabled="@(Rank <= Floor)"
                @onclick="() => Set(Rank - 1)">−</button>
        <span class="value">@(Rank)d</span>
        <button type="button" aria-label="@($"Raise {Name}")"
                disabled="@(Rank >= Max)"
                @onclick="() => Set(Rank + 1)">+</button>
    </div>

    @* The rulebook's word for this rank. Outside the stepper, because it is a gloss on the
       number rather than one of its controls, and it is left as an empty cell above 6d so
       the ranks below stay in a column. *@
    <div class="rank-word">@Word</div>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? Sub { get; set; }
    [Parameter] public int Rank { get; set; }
    [Parameter] public int Max { get; set; }

    /// <summary>
    /// The lowest rank allowed at all: 1d for both. Ch.2 states it once for Abilities (p.17)
    /// and again for Talents (p.18) — "No Ability can have a rank lower than 1d", "No Talent can
    /// have a rank lower than 1d". The Talents tab used 0d, which the book contradicts.
    /// </summary>
    [Parameter] public int Floor { get; set; }

    /// <summary>The rank a starting package already grants, and so pays for.</summary>
    [Parameter] public int PackageFloor { get; set; }

    /// <summary>
    /// Ch.2's word for each rank of this Trait — the ABILITY RANKS table on printed p.17
    /// (Impaired, Undeveloped, Developed, Noteworthy, Exceptional, Peak) and the TALENT RANKS
    /// table on p.18 (Clueless, Unskilled, Proficient, Advanced, Expert, Master).
    ///
    /// <para>Passed in rather than looked up here, so this component still knows nothing about
    /// the rules; the tabs hand over <c>AbilityModel.RankGuide</c> or
    /// <c>TalentModel.RankGuide</c>, which have carried this the whole time with nothing
    /// showing them.</para>
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, string>? RankGuide { get; set; }

    [Parameter] public EventCallback<int> RankChanged { get; set; }

    /// <summary>
    /// The word for the rank as it stands, or nothing.
    ///
    /// <para><b>Both tables stop at 6d, and above that there is deliberately no word.</b> The
    /// rulebook stops because a 7d Trait is beyond what the scale describes — so a rank with
    /// no entry shows an empty cell rather than the nearest word, which would be this program
    /// inventing a rung the book does not have.</para>
    ///
    /// <para>The stored value carries a gloss on two of the rungs — "Undeveloped (ordinary
    /// human average)" — and only the word is shown here. The gloss is a sentence about
    /// people in general and this is a label on one row of a form.</para>
    /// </summary>
    private string? Word
    {
        get
        {
            if (RankGuide is null || !RankGuide.TryGetValue($"{Rank}d", out var entry)) return null;

            var gloss = entry.IndexOf(" (", StringComparison.Ordinal);
            return gloss < 0 ? entry : entry[..gloss];
        }
    }

    /// <summary>
    /// The lowest rank this row can actually be set to: the Trait's own floor, or the package's
    /// granted rank where that is higher, since a package's ranks "cannot be lowered below the
    /// package rank". The same figure <see cref="Set"/> clamps to, read once so the announced
    /// minimum and the enforced one cannot disagree.
    /// </summary>
    private int Min => Math.Max(Floor, PackageFloor);

    /// <summary>
    /// What a screen reader is told the value is. The bare number would be read as a quantity;
    /// the rulebook's own word for the rung is the thing a player is choosing between, and it is
    /// already on screen for everybody else.
    /// </summary>
    private string ValueText => Word is { } word ? $"{Rank}d {word}" : $"{Rank}d";

    /// <summary>
    /// The keys a slider is expected to answer to.
    ///
    /// <para><b>Nothing here suppresses the browser's default, and that is a compromise rather
    /// than a preference.</b> Blazor fixes <c>preventDefault</c> at render time rather than per
    /// event, so suppressing it on this element would also swallow Tab and trap focus inside a
    /// rank row — much worse than what it would fix. The consequence is that Home and End still
    /// scroll the document as well as moving the rank. Left and Right are the pair to reach for:
    /// the pips are horizontal, and this app is held to no horizontal overflow by a harness in
    /// CI, so those two scroll nothing.</para>
    /// </summary>
    private Task Key(KeyboardEventArgs e) => e.Key switch
    {
        "ArrowRight" or "ArrowUp" => Set(Rank + 1),
        "ArrowLeft" or "ArrowDown" => Set(Rank - 1),
        "Home" => Set(Min),
        "End" => Set(Max),
        _ => Task.CompletedTask,
    };

    private Task Set(int value) =>
        RankChanged.InvokeAsync(Math.Clamp(value, Min, Max));
}
