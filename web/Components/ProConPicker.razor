@* Adds and removes Pros and Cons.

   Which generic options are on offer is ProConApplicability's answer, never this
   component's: the rulebook states applicability inside each option ("This Pro applies to
   Zone Powers"), not inside the Power, and the per-Power lists that used to exist here
   were invented and wrong. Anything the option states that the data cannot check travels
   as a caveat shown beside it — a caveat must never become a filter, and there is a test
   in the engine's suite that says so.

   A Power's own Pros and Cons come first, marked, because they are printed in its
   rulebook entry and are what a player reading the book expects to be offered. *@

<Field Label="@(IsPro ? "Pros" : "Cons")">
    @if (Selected.Count == 0)
    {
        @* Worded for either subject. This picker serves Powers and Abilities both, so
           "the Power" would be wrong half the time it is shown. *@
        <EmptyState>
            @if (IsPro)
            {
                <text>None yet. A Pro widens what this does, and adds to what it costs.</text>
            }
            else
            {
                <text>None yet. A Con narrows what this does, and discounts it.</text>
            }
        </EmptyState>
    }
    else
    {
        <ChosenList>
            @foreach (var choice in Selected.ToList())
            {
                <ChosenRow>
                    <Body>
                        <b>@DisplayName(choice.Id)</b>
                        @if (choice.VariantKey is not null)
                        {
                            <span class="muted small"> — @Labels.Humanise(choice.VariantKey)</span>
                        }
                        @if (choice.Units is { } u)
                        {
                            <span class="muted small"> ×@u</span>
                        }
                        @if (Own(choice.Id) is not null)
                        {
                            <span class="tag own">this Power</span>
                        }
                    </Body>
                    <Actions>
                        <button type="button" class="btn small danger" @onclick="() => Remove(choice)">Remove</button>
                    </Actions>
                </ChosenRow>
            }
        </ChosenList>
    }

    @if (_pending is null)
    {
        <button type="button" class="btn small" @onclick="() => _adding = !_adding">
            @(_adding ? "Cancel" : $"Add a {(IsPro ? "Pro" : "Con")}")
        </button>
    }

    @if (_adding && _pending is null)
    {
        <OptionList Class="spaced" Placeholder="Filter these Pros and Cons">
            @foreach (var own in OwnEntries)
            {
                <OptionRow Name="@own.Name" Caveat="@own.Description" Cost="@PowerProConCost(own)"
                           OnSelect="() => Begin(own.Id)">
                    <NameExtra>
                        <span class="tag own">this Power</span>
                    </NameExtra>
                </OptionRow>
            }
            @* A Power's own Pros and Cons showed their description and the generic ones did
               not, so half this list was bare names and prices — unusable without the book
               open. Both halves describe themselves now, and the applicability caveat is
               appended where the option states one the data cannot check. *@
            @foreach (var option in GenericOptions)
            {
                <OptionRow Name="@option.Name"
                           Caveat="@GenericCaveat(option)"
                           Cost="@GenericCost(option)"
                           OnSelect="() => Begin(option.Id)" />
            }
        </OptionList>
    }

    @if (_pending is { } pending)
    {
        <Panel Class="spaced">
            <b>@DisplayName(pending.Id)</b>

            @* The ids carry an instance suffix because two of these are on screen at once —
               the Pros picker and the Cons picker — and a page with two id="pcv" points
               both <label for> at the first one, so clicking the Cons label focuses the
               Pros control and a screen reader reads out the wrong question. *@
            @if (VariantsFor(pending.Id) is { Count: > 0 } variants)
            {
                <Field For="@($"pcv-{Slot}")" Label="This one is graded — which version?">
                    <select id="@($"pcv-{Slot}")" @bind="_variantKey">
                        <option value="">Choose…</option>
                        @foreach (var v in variants)
                        {
                            <option value="@v.Key">@Labels.Humanise(v.Key) — @v.Value</option>
                        }
                    </select>
                </Field>
            }

            @if (NeedsUnits(pending.Id))
            {
                <Field For="@($"pcu-{Slot}")" Label="@($"How many {Own(pending.Id)?.CostUnitLabel ?? "unit"}s?")">
                    <input id="@($"pcu-{Slot}")" type="number" min="1" @bind="_units" />
                </Field>
            }

            <div class="inline">
                <button type="button" class="btn primary small" disabled="@(!CanConfirm())" @onclick="Confirm">Add</button>
                <button type="button" class="btn small" @onclick="() => _pending = null">Cancel</button>
            </div>
        </Panel>
    }
</Field>

@code {
    /// <summary>What the Pros and Cons are being applied to.</summary>
    public enum Target
    {
        /// <summary>A Power. Range and rank-type constraints apply, via ProConApplicability.</summary>
        Power,

        /// <summary>
        /// An Ability. The rulebook allows this — Overkill on Might is the Brute Option,
        /// and Stronghold buys four Abilities through his armour with the Item Con — and
        /// each option's own entry says whether it can be. Exactly two Cons and no Pros
        /// name Abilities, which is why this is a filter rather than the whole list.
        /// </summary>
        Ability,

        /// <summary>
        /// A piece of gear. Ch.6: Pros and Cons "cost the same when applied to gear as
        /// when applied to Powers", and the page names no further constraint, so the
        /// Power list stands. Gear floors at 0 HP rather than 1, but that is
        /// CostCalculator's business, not this component's.
        /// </summary>
        Gear
    }

    /// <summary>The Power these apply to. Null unless <see cref="Scope"/> is Power.</summary>
    [Parameter] public PowerModel? Power { get; set; }

    [Parameter] public Target Scope { get; set; } = Target.Power;

    [Parameter, EditorRequired] public List<SelectedProCon> Selected { get; set; } = [];
    [Parameter] public bool IsPro { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    [Inject] private CharacterSession Session { get; set; } = null!;

    /// <summary>
    /// Distinguishes this picker's control ids from its sibling's. Only ever two of these
    /// are on screen together — a Pros picker and a Cons picker on the same target — so the
    /// pair of values is enough, and being derived rather than random keeps the ids stable
    /// across renders.
    /// </summary>
    private string Slot => IsPro ? "pro" : "con";

    private bool _adding;
    private SelectedProCon? _pending;
    private string _variantKey = "";
    private int _units = 1;

    /// <summary>
    /// The Power's own Pros or Cons, printed inside its rulebook entry. An Ability or a
    /// piece of gear has none — they take the generic options only.
    /// </summary>
    private IReadOnlyList<PowerProConModel> OwnEntries =>
        Power is null ? [] : (IsPro ? Power.PowerPros : Power.PowerCons);

    private IReadOnlyList<IGenericProCon> GenericOptions
    {
        get
        {
            var all = IsPro
                ? Session.Rules.Pros.Cast<IGenericProCon>().ToList()
                : Session.Rules.Cons.Cast<IGenericProCon>().ToList();

            return Scope switch
            {
                // Range and rank type, plus the one widening a Power's own printed text can
                // make to the Range rule — see ProConApplicability.
                Target.Power when Power is not null => IsPro
                    ? Session.Applicability.ProsFor(Power).Cast<IGenericProCon>().ToList()
                    : Session.Applicability.ConsFor(Power).Cast<IGenericProCon>().ToList(),

                // Each option's entry says what it may be applied to. Two Cons name
                // Abilities; no Pro does.
                Target.Ability => all.Where(NamesAbilities).ToList(),

                _ => all
            };
        }
    }

    private static bool NamesAbilities(IGenericProCon option) => option switch
    {
        ProModel p => p.ApplicableTo.Contains("abilities", StringComparer.Ordinal),
        ConModel c => c.ApplicableTo.Contains("abilities", StringComparer.Ordinal),
        _          => false
    };

    private PowerProConModel? Own(string id) => OwnEntries.FirstOrDefault(e => e.Id == id);

    private string DisplayName(string id) =>
        Own(id)?.Name
        ?? (IsPro ? Session.Rules.GetPro(id)?.Name : Session.Rules.GetCon(id)?.Name)
        ?? id;

    private void Begin(string id)
    {
        _pending    = new SelectedProCon(id);
        _variantKey = "";
        _units      = 1;
        _adding     = false;
    }

    private async Task Confirm()
    {
        if (_pending is null) return;

        Selected.Add(new SelectedProCon(
            _pending.Id,
            string.IsNullOrEmpty(_variantKey) ? null : _variantKey)
        {
            Units = NeedsUnits(_pending.Id) ? _units : null
        });

        _pending = null;
        await OnChanged.InvokeAsync();
    }

    private async Task Remove(SelectedProCon choice)
    {
        Selected.Remove(choice);
        await OnChanged.InvokeAsync();
    }

    private bool CanConfirm() =>
        _pending is not null
        && (VariantsFor(_pending.Id) is not { Count: > 0 } || !string.IsNullOrEmpty(_variantKey));

    /// <summary>
    /// The grades an option offers, as label/price pairs. A Power's own entry can be
    /// graded per rank as well as flat — Constructs' Devices is +2 HP <i>per rank</i>, so
    /// the price shown has to say which.
    /// </summary>
    private Dictionary<string, string>? VariantsFor(string id)
    {
        if (Own(id) is { } own)
        {
            if (own.CostModifierRange is { } flat)
                return flat.ToDictionary(kv => kv.Key, kv => $"{Signed(kv.Value)} HP");
            if (own.CostPerRankRange is { } rate)
                return rate.ToDictionary(kv => kv.Key, kv => $"{Signed(rate[kv.Key])} HP per rank");
            return null;
        }

        var option = IsPro ? (IGenericProCon?)Session.Rules.GetPro(id) : Session.Rules.GetCon(id);
        var range  = IsPro
            ? Session.Rules.GetPro(id)?.CostModifierRange
            : Session.Rules.GetCon(id)?.CostModifierRange;

        if (range is null || option is null) return null;

        // Not every printed grade, where the Power reached this option through its own text:
        // Zone/Nova and Ranged price by the base Power's Range, and Force Field is Self, which
        // the rulebook does not price. Asked of the engine so the picker cannot offer a grade
        // the validator would then refuse.
        var grades = ProConApplicability.GradesFor(option, Power, range.Keys);

        return range.Where(kv => grades.Contains(kv.Key, StringComparer.Ordinal))
                    .ToDictionary(kv => kv.Key, kv => $"{Signed(kv.Value)} HP");
    }

    private bool NeedsUnits(string id) => Own(id)?.CostType == "per_rank_per_unit";

    private string PowerProConCost(PowerProConModel e) => e.CostType switch
    {
        "flat"              => $"{Signed(e.CostModifier ?? 0)} HP",
        "per_rank"          => $"{Signed(e.CostPerRank ?? 0)} HP per rank",
        "per_unit"          => $"{Signed(e.CostPerUnit ?? 0)} HP per {e.CostUnitLabel}",
        "per_rank_per_unit" => $"{Signed(e.CostPerRank ?? 0)} HP per rank per {e.CostUnitLabel}",
        "flat_variable"     => "graded",
        "per_rank_variable" => "graded, per rank",
        _                   => e.CostType
    };

    /// <summary>
    /// Overkill and Weak are the two options priced "special": they reduce the Power's
    /// rate by 1 HP per rank rather than changing its total, so there is no flat figure to
    /// print. CostCalculator applies them; saying "graded" here would be a lie.
    /// </summary>
    private static string GenericCost(IGenericProCon option) => option switch
    {
        ProModel { CostModifier: { } m } => $"{Signed(m)} HP",
        ConModel { CostModifier: { } m } => $"{Signed(m)} HP",
        ProModel { CostType: "special" } or ConModel { CostType: "special" } => "−1 HP per rank",
        _                                => "graded"
    };

    /// <summary>
    /// What a generic option says about itself: its description, then the constraint its own
    /// rulebook entry states where that constraint is one the data cannot check for us. The
    /// caveat is shown, never enforced — see ProConApplicability.
    /// </summary>
    private static string? GenericCaveat(IGenericProCon option)
    {
        var description = option switch
        {
            ProModel p => p.Description,
            ConModel c => c.Description,
            _          => null
        };

        var caveat = option.ApplicabilityCaveat is null ? null : $"{option.ApplicabilityCaveat} The GM decides.";

        return string.Join(" ", new[] { description, caveat }.Where(s => !string.IsNullOrWhiteSpace(s)))
            is { Length: > 0 } text ? text : null;
    }

    private static string Signed(double value) => value > 0 ? $"+{value:0.##}" : $"{value:0.##}";

}
