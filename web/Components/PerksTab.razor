@implements IDisposable
@inject CharacterSession Session
@inject Companionship Companions
@inject AccountCharacterStore Store
@inject NavigationManager Nav

<Panel Title="Perks"
       Aside="Social advantages from the world around you — no ranks, no Pros or Cons"
       Cost="@($"{Session.Costs.TotalPerksCost(Session.Sheet)} HP")">

    @if (Session.Sheet.Perks.Count == 0)
    {
        <EmptyState>
            No Perks yet, and they are optional. Add one below if the character has an
            advantage the world gives them rather than one they carry or can do.
        </EmptyState>
    }
    else
    {
        <ChosenList>
            @foreach (var sp in Session.Sheet.Perks.ToList())
            {
                <ChosenRow Cost="@($"{Session.Costs.PerkCost(sp)} HP")"
                           Findings="SheetFindings.ForPerk(Validation, sp.PerkId)">
                    <Body>
                        <div>
                            <b>@(Session.Rules.GetPerk(sp.PerkId)?.Name ?? sp.PerkId)</b>
                            @if (sp.Units > 1)
                            {
                                <span class="muted"> ×@sp.Units</span>
                            }
                        </div>
                        @if (sp.NarrativeDetail is not null)
                        {
                            <div class="small muted">@sp.NarrativeDetail</div>
                        }
                        @* Pet/Sidekick buys a second character (Ch.2 p.55), so its row says what
                           that character gets and opens it — on an owner's sheet only: a
                           companion's own purchase is refused, and the row's finding says so. *@
                        @if (CompanionRule(sp) is { } rule && !CompanionRoster.IsCompanion(Session.Sheet))
                        {
                            <div class="small muted companion-line">@CompanionLine(sp, rule)</div>
                        }
                    </Body>
                    <Actions>
                        @if (CompanionRule(sp) is not null && !CompanionRoster.IsCompanion(Session.Sheet))
                        {
                            @if (CompanionOf(sp) is { } companion)
                            {
                                <button type="button" class="btn small" disabled="@_busy"
                                        @onclick="() => OpenCompanion(companion.Id)">Open @companion.Name</button>
                            }
                            else
                            {
                                <button type="button" class="btn small" disabled="@_busy"
                                        @onclick="() => BuildCompanion(sp)">Build the companion</button>
                            }
                        }
                        <button type="button" class="btn small danger" @onclick="() => Remove(sp)">Remove</button>
                    </Actions>
                </ChosenRow>
            }
        </ChosenList>
    }

    @if (_refusal is not null)
    {
        <p class="small muted spaced" role="status">@_refusal</p>
    }
</Panel>

@if (_pending is { } perk)
{
    <Panel Title="@perk.Name" Level="3">
        <p class="small">@perk.Description</p>

        @if (perk.CostType == "per_unit")
        {
            @* "How many" and the unit as written, not "{unit}s?". Several unit labels carry
               their own parenthetical — "Hero Point (= 25 Vehicle Points)" — and pluralising
               by appending an s produced "How many Hero Point (= 25 Vehicle Points)s?". *@
            <Field For="pk-units"
                   Label="@($"How many, at {perk.CostPerUnit} HP per {perk.UnitLabel ?? "unit"}?")">
                <input id="pk-units" type="number" min="1" @bind="_units" />
            </Field>
        }

        @* **Each question its own box**, from `PerkQuestions` — the same list the terminal asks.
           Patron's constraint is three questions and Contacts' is one per contact type bought, and
           a single line invited a single answer to both. The answers are joined into the one line
           of detail the sheet has always stored. *@
        @if (perk.NarrativePerUnit && perk.NarrativeConstraint is { } heading)
        {
            <p class="small">@heading</p>
        }

        @for (var i = 0; i < Questions(perk).Count; i++)
        {
            var at = i;
            var question = Questions(perk)[at];

            @if (question.Choices is { } choices)
            {
                <fieldset class="perk-identity">
                    <legend class="small">@question.Ask</legend>
                    @foreach (var choice in choices)
                    {
                        <label class="small">
                            <input type="radio" name="pk-identity" value="@choice"
                                   checked="@(Answer(at) == choice)"
                                   @onchange="() => SetAnswer(at, choice)" />
                            @choice
                        </label>
                    }
                </fieldset>
            }
            else
            {
                <Field For="@($"pk-detail-{at}")" Label="@question.Ask">
                    <input id="@($"pk-detail-{at}")" type="text" class="wide"
                           value="@Answer(at)" @oninput="e => SetAnswer(at, e.Value?.ToString())" />
                </Field>
            }
        }

        <div class="inline">
            <button type="button" class="btn primary" disabled="@(!CanAdd(perk))" @onclick="() => Add(perk)">Add perk</button>
            <button type="button" class="btn" @onclick="() => _pending = null">Cancel</button>
        </div>
    </Panel>
}
else
{
    <Panel Title="Add a perk" Level="3">
        <OptionList Placeholder="Filter Perks by name or description">
            @foreach (var option in Available)
            {
                <OptionRow Name="@option.Name"
                           Caveat="@option.Description"
                           Cost="@(option.CostType == "flat"
                                     ? $"{option.Cost} HP"
                                     : $"{option.CostPerUnit} HP per {option.UnitLabel ?? "unit"}")"
                           OnSelect="() => Begin(option)" />
            }
        </OptionList>
        @if (Available.Count == 0)
        {
            <p class="small muted">Every perk is already on the sheet.</p>
        }
    </Panel>
}

@code {
    /// <summary>Read fresh on every render — see <c>Review.razor</c>'s own <c>Validation</c>.</summary>
    private ValidationResult Validation => Session.Validate();

    private PerkModel? _pending;
    private int _units = 1;

    /// <summary>The answers so far, by question. Kept when the unit count moves, so raising it adds empty boxes rather than clearing filled ones.</summary>
    private readonly List<string?> _answers = [];

    private IReadOnlyList<PerkQuestion> Questions(PerkModel perk) =>
        PerkQuestions.For(perk, perk.CostType == "per_unit" ? Math.Max(1, _units) : 1, Session.Sheet);

    private string? Answer(int at) => at < _answers.Count ? _answers[at] : null;

    private void SetAnswer(int at, string? value)
    {
        while (_answers.Count <= at) _answers.Add(null);
        _answers[at] = value;
    }

    /// <summary>The one line the answers make, or null while any is missing.</summary>
    private string? Detail(PerkModel perk) => PerkQuestions.Compose(Questions(perk), _answers);

    private List<PerkModel> Available =>
        Session.Rules.Perks
            .Where(p => Session.Sheet.Perks.All(sp => sp.PerkId != p.Id))
            .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private void Begin(PerkModel perk)
    {
        _pending = perk;
        _units   = 1;
        _answers.Clear();
    }

    /// <summary>
    /// A perk that asks something needs every answer before it means anything — "Contacts"
    /// with no contact type named is not a perk, it is a blank, and two contact types with one
    /// named is half of one. The CLI refuses an empty answer for the same reason.
    /// </summary>
    private bool CanAdd(PerkModel perk) =>
        Questions(perk).Count == 0 || Detail(perk) is not null;

    private void Add(PerkModel perk)
    {
        Session.Sheet.Perks.Add(new SelectedPerk(
            perk.Id,
            perk.CostType == "per_unit" ? Math.Max(1, _units) : 1,
            Detail(perk)));

        _pending = null;
        Session.NotifyChanged();
    }

    private void Remove(SelectedPerk sp)
    {
        Session.Sheet.Perks.Remove(sp);
        Session.NotifyChanged();
    }

    // ── Pet/Sidekick ─────────────────────────────────────────────────────

    private bool _busy;
    private string? _refusal;

    protected override async Task OnInitializedAsync()
    {
        Companions.Changed += Redraw;
        await Companions.EnsureAsync();
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => Companions.Changed -= Redraw;

    private PerkCompanionRule? CompanionRule(SelectedPerk sp) =>
        sp.PerkId is null ? null : Session.Rules.GetPerk(sp.PerkId)?.Companion;

    /// <summary>
    /// What this purchase gives, and the ceiling — the owner's own tier halved, which the engine
    /// answers. Without a budget limit there is no tier figure to halve, so the ceiling is the GM's.
    /// </summary>
    private string CompanionLine(SelectedPerk sp, PerkCompanionRule rule)
    {
        var gives = $"Gives a companion {rule.HeroPointsFor(sp.Units)} Hero Points (p.{rule.Page}).";

        if (!Session.ShowBudget) return $"{gives} With no budget limit, how many it may have is the GM's call.";
        if (Session.Budget <= 0) return gives;

        return $"{gives} At most {rule.MostUnitsFor(Session.Budget)}: a companion may have half of {Session.Budget}.";
    }

    /// <summary>
    /// The companion the engine matched to this purchase — the one whose budget is what this
    /// purchase gives — or null while none is built. Two purchases of one size share the
    /// companions of that size in roster order.
    /// </summary>
    private (string Id, string Name)? CompanionOf(SelectedPerk sp)
    {
        if (Companions.Current is not { ShownIsCompanion: false } family || CompanionRule(sp) is not { } rule) return null;

        var same = Session.Sheet.Perks.Where(p => CompanionRule(p) is not null && p.Units == sp.Units).ToList();
        var nth  = same.IndexOf(sp);
        var hp   = rule.HeroPointsFor(sp.Units);

        var matched = family.Companions
            .Where(c => family.Family.Budget.GetValueOrDefault(c.Id) is { } budget && budget == hp)
            .ToList();

        return nth >= 0 && nth < matched.Count ? matched[nth] : null;
    }

    /// <summary>
    /// Makes the companion a character of its own, linked to this one, and opens it.
    ///
    /// <para><b>The owner is written down under its own id first</b>, so the purchase that pays
    /// for the companion is in storage before the pointer moves to the new one — otherwise the
    /// first write to the companion's slot could land before the owner's last edit did.</para>
    /// </summary>
    private async Task BuildCompanion(SelectedPerk sp)
    {
        _busy = true;
        _refusal = null;

        try
        {
            var owner   = Session.Sheet;
            var ownerId = await Companions.CurrentIdAsync();
            var ownerName = string.IsNullOrWhiteSpace(owner.Name) ? "Unnamed character" : owner.Name;

            if (!await Store.RestoreAsync(ownerId, ownerName, owner, Session.Mode))
            {
                _refusal = "This character could not be saved, so its companion was not made. Try again in a moment.";
                return;
            }

            var companion = Engine.Companions.Begin(owner, ownerId, $"{ownerName}'s companion");
            companion.IsVillain = owner.IsVillain;

            var id = SavedCharacters.NewId();
            if (!await Store.RestoreAsync(id, companion.Name, companion, Session.Mode))
            {
                _refusal = "The companion could not be saved. If your account is full, make room in your characters first.";
                return;
            }

            await OpenCompanion(id);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenCompanion(string id)
    {
        if (await Store.OpenAsync(id) is not { } opened)
        {
            _refusal = "The companion could not be opened.";
            return;
        }

        Session.Open(opened.Sheet, opened.Mode, id);
        Nav.NavigateTo("build");
    }
}
