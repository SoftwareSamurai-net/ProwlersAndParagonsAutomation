@inject CharacterSession Session

<Panel Title="Perks"
       Aside="Social advantages from the world around you — no ranks, no Pros or Cons"
       Cost="@($"{Session.Costs.TotalPerksCost(Session.Sheet)} HP")">

    @if (Session.Sheet.Perks.Count == 0)
    {
        <EmptyState>
            No Perks yet, and they are optional. Add one below if the character has an
            advantage the world gives them rather than one they carry or can do.
        </EmptyState>
    }
    else
    {
        <ChosenList>
            @foreach (var sp in Session.Sheet.Perks.ToList())
            {
                <ChosenRow Cost="@($"{Session.Costs.PerkCost(sp)} HP")"
                           Findings="SheetFindings.ForPerk(Validation, sp.PerkId)">
                    <Body>
                        <div>
                            <b>@(Session.Rules.GetPerk(sp.PerkId)?.Name ?? sp.PerkId)</b>
                            @if (sp.Units > 1)
                            {
                                <span class="muted"> ×@sp.Units</span>
                            }
                        </div>
                        @if (sp.NarrativeDetail is not null)
                        {
                            <div class="small muted">@sp.NarrativeDetail</div>
                        }
                    </Body>
                    <Actions>
                        <button type="button" class="btn small danger" @onclick="() => Remove(sp)">Remove</button>
                    </Actions>
                </ChosenRow>
            }
        </ChosenList>
    }
</Panel>

@if (_pending is { } perk)
{
    <Panel Title="@perk.Name" Level="3">
        <p class="small">@perk.Description</p>

        @if (perk.CostType == "per_unit")
        {
            @* "How many" and the unit as written, not "{unit}s?". Several unit labels carry
               their own parenthetical — "Hero Point (= 25 Vehicle Points)" — and pluralising
               by appending an s produced "How many Hero Point (= 25 Vehicle Points)s?". *@
            <Field For="pk-units"
                   Label="@($"How many, at {perk.CostPerUnit} HP per {perk.UnitLabel ?? "unit"}?")">
                <input id="pk-units" type="number" min="1" @bind="_units" />
            </Field>
        }

        @* **Each question its own box**, from `PerkQuestions` — the same list the terminal asks.
           Patron's constraint is three questions and Contacts' is one per contact type bought, and
           a single line invited a single answer to both. The answers are joined into the one line
           of detail the sheet has always stored. *@
        @if (perk.NarrativePerUnit && perk.NarrativeConstraint is { } heading)
        {
            <p class="small">@heading</p>
        }

        @for (var i = 0; i < Questions(perk).Count; i++)
        {
            var at = i;
            var question = Questions(perk)[at];

            @if (question.Choices is { } choices)
            {
                <fieldset class="perk-identity">
                    <legend class="small">@question.Ask</legend>
                    @foreach (var choice in choices)
                    {
                        <label class="small">
                            <input type="radio" name="pk-identity" value="@choice"
                                   checked="@(Answer(at) == choice)"
                                   @onchange="() => SetAnswer(at, choice)" />
                            @choice
                        </label>
                    }
                </fieldset>
            }
            else
            {
                <Field For="@($"pk-detail-{at}")" Label="@question.Ask">
                    <input id="@($"pk-detail-{at}")" type="text" class="wide"
                           value="@Answer(at)" @oninput="e => SetAnswer(at, e.Value?.ToString())" />
                </Field>
            }
        }

        <div class="inline">
            <button type="button" class="btn primary" disabled="@(!CanAdd(perk))" @onclick="() => Add(perk)">Add perk</button>
            <button type="button" class="btn" @onclick="() => _pending = null">Cancel</button>
        </div>
    </Panel>
}
else
{
    <Panel Title="Add a perk" Level="3">
        <OptionList Placeholder="Filter Perks by name or description">
            @foreach (var option in Available)
            {
                <OptionRow Name="@option.Name"
                           Caveat="@option.Description"
                           Cost="@(option.CostType == "flat"
                                     ? $"{option.Cost} HP"
                                     : $"{option.CostPerUnit} HP per {option.UnitLabel ?? "unit"}")"
                           OnSelect="() => Begin(option)" />
            }
        </OptionList>
        @if (Available.Count == 0)
        {
            <p class="small muted">Every perk is already on the sheet.</p>
        }
    </Panel>
}

@code {
    /// <summary>Read fresh on every render — see <c>Review.razor</c>'s own <c>Validation</c>.</summary>
    private ValidationResult Validation => Session.Validate();

    private PerkModel? _pending;
    private int _units = 1;

    /// <summary>The answers so far, by question. Kept when the unit count moves, so raising it adds empty boxes rather than clearing filled ones.</summary>
    private readonly List<string?> _answers = [];

    private IReadOnlyList<PerkQuestion> Questions(PerkModel perk) =>
        PerkQuestions.For(perk, perk.CostType == "per_unit" ? Math.Max(1, _units) : 1, Session.Sheet);

    private string? Answer(int at) => at < _answers.Count ? _answers[at] : null;

    private void SetAnswer(int at, string? value)
    {
        while (_answers.Count <= at) _answers.Add(null);
        _answers[at] = value;
    }

    /// <summary>The one line the answers make, or null while any is missing.</summary>
    private string? Detail(PerkModel perk) => PerkQuestions.Compose(Questions(perk), _answers);

    private List<PerkModel> Available =>
        Session.Rules.Perks
            .Where(p => Session.Sheet.Perks.All(sp => sp.PerkId != p.Id))
            .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private void Begin(PerkModel perk)
    {
        _pending = perk;
        _units   = 1;
        _answers.Clear();
    }

    /// <summary>
    /// A perk that asks something needs every answer before it means anything — "Contacts"
    /// with no contact type named is not a perk, it is a blank, and two contact types with one
    /// named is half of one. The CLI refuses an empty answer for the same reason.
    /// </summary>
    private bool CanAdd(PerkModel perk) =>
        Questions(perk).Count == 0 || Detail(perk) is not null;

    private void Add(PerkModel perk)
    {
        Session.Sheet.Perks.Add(new SelectedPerk(
            perk.Id,
            perk.CostType == "per_unit" ? Math.Max(1, _units) : 1,
            Detail(perk)));

        _pending = null;
        Session.NotifyChanged();
    }

    private void Remove(SelectedPerk sp)
    {
        Session.Sheet.Perks.Remove(sp);
        Session.NotifyChanged();
    }
}
