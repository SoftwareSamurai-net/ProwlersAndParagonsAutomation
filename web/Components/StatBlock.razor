@* One ruled box with a label over a big number, the way the published sheet sets Edge,
   Health, Resolve and Hero Points. *@

<div class="stat-block">
    <div class="label">@Label</div>
    <div class="value">@Value</div>
    @if (Sub is not null)
    {
        <div class="sub">@Sub</div>
    }
    @if (Formula is not null)
    {
        <div class="formula">@Formula</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";

    /// <summary>
    /// A smaller second line under the figure. The budget needs one: "105/125" set at the
    /// size these boxes use runs straight out of the box, and the number that matters is
    /// the spend — the budget is context for it.
    /// </summary>
    [Parameter] public string? Sub { get; set; }

    /// <summary>
    /// The rule the figure above came out of, in words.
    ///
    /// <para><b>It is a statement of the rule and never a working of it.</b> The engine
    /// returns a number and not the terms it added up, and reconstructing them here would be
    /// arithmetic in the browser — which is the one thing this front end exists not to do.
    /// So this says how Edge is worked out; what Edge *is* comes from the engine, beside
    /// it.</para>
    /// </summary>
    [Parameter] public string? Formula { get; set; }
}
