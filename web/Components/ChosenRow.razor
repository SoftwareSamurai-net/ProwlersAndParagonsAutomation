@inject CharacterSession Session
@inject DismissedFindings Dismissed
@* One entry in a <ChosenList>: what was chosen, what it cost, and what can be done to it.

   Both slots are named because Blazor will not mix named child content with unnamed.

   **The row's own content sits in a wrapper, `chosen-row`, so a finding can sit below it and
   still be one list item.** `.chosen > li` used to be the flex row itself; a finding rendered as
   a fourth flex child would sit beside the buttons rather than under them, on whatever room was
   left. Moving the flex layout onto the wrapper leaves the `<li>` free to stack the row and the
   finding in the ordinary block direction.

   **This is one of the three places a dismissed Warning is hidden**, alongside `AbilitiesTab`
   and `TalentsTab` — see `DismissedFindings`. `Findings` still carries everything
   `SheetFindings` routed here, dismissed or not, because dismissing one more needs the full list
   to prune correctly against; `Visible` is what actually reaches `RowFinding`. *@

<li>
    <div class="chosen-row">
        <div class="body">@Body</div>
        @if (Cost is not null)
        {
            <span class="cost">@Cost</span>
        }
        @Actions
    </div>
    <RowFinding Issues="Visible" OnDismiss="Dismiss" />
</li>

@code {
    [Parameter] public RenderFragment? Body { get; set; }

    /// <summary>A Hero Point figure, between the body and the buttons.</summary>
    [Parameter] public string? Cost { get; set; }

    /// <summary>Edit, Remove, Choose — whatever this row offers.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>
    /// Findings the engine has against whatever this row represents, already routed to it by
    /// <see cref="SheetFindings"/> — every one, dismissed or not. Null or empty for a row
    /// nothing is wrong with — see <see cref="RowFinding"/>.
    /// </summary>
    [Parameter] public IReadOnlyList<ValidationIssue>? Findings { get; set; }

    private string CharacterId => DismissedFindings.CharacterKey(Session);

    /// <summary>What actually reaches <see cref="RowFinding"/>: <see cref="Findings"/> minus
    /// whatever is currently dismissed for this character.</summary>
    private List<ValidationIssue> Visible =>
        Findings is null ? [] : [.. Findings.Where(i => !Dismissed.IsDismissed(CharacterId, i))];

    /// <summary>
    /// Re-read on every render this component takes part in, so a character switch — which
    /// re-renders this tree without necessarily recreating it — never draws with a stale id's
    /// dismissals.
    /// </summary>
    protected override async Task OnParametersSetAsync() => await Dismissed.LoadAsync(CharacterId);

    private async Task Dismiss(ValidationIssue issue)
    {
        await Dismissed.DismissAsync(CharacterId, issue, Findings ?? []);
        StateHasChanged();
    }
}
