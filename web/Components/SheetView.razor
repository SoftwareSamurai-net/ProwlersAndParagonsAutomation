@implements IDisposable
@inject CharacterSession Session

@* The character sheet, laid out the way the published Ultimate Edition Hero Sheet is:
   three columns under a masthead, every section in its own ruled box under a centred
   heading, and a row of the four figures a player reads off mid-scene.

   What is reproduced is the *structure* — which boxes exist, what goes in them, and in
   what order a reader looks for them. None of the trade dress is: no hex pattern, no
   wordmark, no colour scheme. Those are LakeSide Games', and this project ships none of
   their content.

   Two things follow from the reference sheet being a *form*:

     - Every Ability and all twelve Talents are listed whether or not a rank was bought,
       with a rule where the number goes. A sheet that hides a Talent at 0d is a summary of
       what the tool knows; the published one is something you can write on.
     - Alias, Team, Origin, Notes and Details have no equivalent in this engine, and they
       are printed as labelled blank rules rather than dropped. See PROGRESS.md — printing
       room to write is the honest answer, and reaching across the layer to invent fields
       would not be.

   One layout serves Hero and Villain. Ch.9 builds Villains exactly like Heroes and prints
   no separate stat-block format, so only the palette differs — and every colour here comes
   from a token, so the difference is one attribute on <html>. *@

<article class="sheet">
    <div class="sheet-body">

        @* ── Masthead ──────────────────────────────────────────────────────── *@
        <div class="sheet-masthead">
            <SheetSection Class="identity">
                <div class="ident-name">@DisplayName</div>
                <dl class="ident-fields">
                    <dt>Alias</dt><dd><RuledLines Count="1" Inline="true" /></dd>
                    <dt>Team</dt><dd><RuledLines Count="1" Inline="true" /></dd>
                    <dt>Motivation</dt>
                    @* Was a MarkupString with a hand-rolled HtmlEncode — the one raw-HTML
                       sink in a file whose whole argument is that markup lives in
                       components. Razor escapes an expression on its own. *@
                    <dd>
                        @if (string.IsNullOrWhiteSpace(Sheet.Motivation))
                        {
                            <RuledLines Count="1" Inline="true" />
                        }
                        else
                        {
                            @Sheet.Motivation
                        }
                    </dd>
                </dl>
            </SheetSection>

            <SheetSection Class="title-block">
                <div class="title-main">Prowlers &amp; Paragons</div>
                <div class="title-sub">Ultimate Edition — Character Sheet</div>
                <div class="title-meta">@Meta</div>
            </SheetSection>

            <SheetSection Title="Quote">
                @if (string.IsNullOrWhiteSpace(Sheet.Quote))
                {
                    <RuledLines Count="3" />
                }
                else
                {
                    <p class="quote">“@Sheet.Quote”</p>
                }
            </SheetSection>
        </div>

        @* ── Three columns ─────────────────────────────────────────────────── *@
        <div class="sheet-columns">

            <div class="sheet-col">
                <SheetSection Title="Abilities">
                    <table class="stat-table trait-table">
                        <tbody>
                            @foreach (var ability in Session.Rules.Abilities)
                            {
                                <tr>
                                    <td><Term Name="@ability.Name" Text="@ability.Description" Enabled="@Explain" /></td>
                                    <td>@Rank(Sheet.GetAbilityRank(ability.Id))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </SheetSection>

                <SheetSection Title="Talents">
                    <table class="stat-table trait-table">
                        <tbody>
                            @foreach (var talent in Session.Rules.Talents)
                            {
                                <tr>
                                    <td><Term Name="@talent.Name" Text="@talent.Description" Enabled="@Explain" /></td>
                                    <td>@Rank(Sheet.GetTalentRank(talent.Id))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </SheetSection>

                <SheetSection Title="Notes" Class="fill">
                    <RuledLines Count="11" />
                </SheetSection>
            </div>

            <div class="sheet-col">
                @if (Groups.Count == 0)
                {
                    <SheetSection Title="Powers">
                        <RuledLines Count="12" />
                    </SheetSection>
                }
                else
                {
                    @* SourceGrouping is the engine's answer, shared with the text sheet and
                       the JSON export, so all three print the same headings in the same
                       order. A Power with no Source still appears, under a plain POWERS
                       heading at the end — leaving one off its own sheet would be worse.

                       "powers" opts the box out of the no-break rule: it is the one section
                       that can be taller than a page, and asking not to be broken pushed it
                       whole to the next page, leaving two thirds of the previous one white. *@
                    @foreach (var group in Groups)
                    {
                        @* The Source is what a group of Powers has in common, and the heading
                           is the only place the sheet says it. "TECH POWERS" does not tell a
                           reader what a Source is for. *@
                        <SheetSection Title="@group.Heading" Class="powers"
                                      TitleTerm="@(Explain ? group.Source?.Description : null)">
                            @* An Ability's or Talent's Source is printed here, inside the
                               Power group, and not as a marking on the Abilities table —
                               that is where the published sheets put it. Stronghold's
                               TECH POWERS opens with his four armoured Abilities. *@
                            @foreach (var line in group.TraitLines)
                            {
                                <div class="power-entry trait-sources">@line</div>
                            }
                            @foreach (var sp in group.Powers)
                            {
                                var power = Session.Rules.GetPower(sp.PowerId);
                                var rank  = power is null ? 0 : Session.Derived.GetEffectiveRank(sp, Sheet);
                                <div class="power-entry">
                                    <div class="head">
                                        @* One expression: Razor strips the leading
                                           whitespace inside a <text> block and inside an
                                           element that follows an expression, which printed
                                           "Armor8d" on every ranked Power. *@
                                        <span class="pname">@* The rank stays in one expression
                                            with whatever precedes it: Razor strips the leading
                                            whitespace inside an element following an expression,
                                            which printed "Armor8d" here once already. *@
                                            <Term Name="@(power?.Name ?? sp.PowerId)"
                                                  Text="@power?.Description" Enabled="@Explain" />@Ranked(power, rank)</span>
                                        <span class="hp">@(CharacterSession.TryCost(() => Session.Costs.PowerCost(sp))?.ToString() ?? "—") HP</span>
                                    </div>
                                    @if (power is not null)
                                    {
                                        <div class="statline">@PowerFormatter.StatLine(power)</div>
                                    }
                                    @* A rankless Power has no rank of its own, but it is not
                                       rankless when another Power acts on it: its Source
                                       names an Ability that stands in. That is the number a
                                       player needs the moment someone Drains it, and the
                                       sheet is where they will look for it. *@
                                    @if (StandInRank(sp, power) is { } stand)
                                    {
                                        <div class="statline">@stand</div>
                                    }
                                    @* Labelled, not run together: a reader has to be able to
                                       tell which of these cost Hero Points and which paid
                                       for the rest. *@
                                    @if (sp.Pros.Count > 0)
                                    {
                                        <div class="statline">Pros: @PowerFormatter.ModifierLine(sp.Pros, c => Label(c, power))</div>
                                    }
                                    @if (sp.Cons.Count > 0)
                                    {
                                        <div class="statline">Cons: @PowerFormatter.ModifierLine(sp.Cons, c => Label(c, power))</div>
                                    }
                                </div>
                            }
                        </SheetSection>
                    }
                }

                <SheetSection Title="Perks">
                    @if (Sheet.Perks.Count == 0)
                    {
                        <RuledLines Count="5" />
                    }
                    else
                    {
                        <table class="stat-table">
                            <tbody>
                                @foreach (var sp in Sheet.Perks)
                                {
                                    <tr>
                                        <td>
                                            <Term Name="@(Session.Rules.GetPerk(sp.PerkId)?.Name ?? sp.PerkId)"
                                                  Text="@Session.Rules.GetPerk(sp.PerkId)?.Description"
                                                  Enabled="@Explain" />@(sp.Units > 1 ? $" ×{sp.Units}" : "")
                                            @if (sp.NarrativeDetail is not null)
                                            {
                                                <span class="muted small"> — @sp.NarrativeDetail</span>
                                            }
                                        </td>
                                        <td><span class="hp">@Cost(() => Session.Costs.PerkCost(sp)) HP</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </SheetSection>

                <SheetSection Title="Gear">
                    @if (Sheet.Gear.Count == 0)
                    {
                        <RuledLines Count="5" />
                    }
                    else
                    {
                        <table class="stat-table">
                            <tbody>
                                @foreach (var item in Sheet.Gear)
                                {
                                    <tr><td colspan="2">@Describe(item)</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                </SheetSection>

                <SheetSection Title="Flaws">
                    @if (Sheet.Flaws.Count == 0)
                    {
                        <RuledLines Count="5" />
                    }
                    else
                    {
                        <table class="stat-table">
                            <tbody>
                                @foreach (var sf in Sheet.Flaws)
                                {
                                    var flaw = Session.Rules.GetFlaw(sf.FlawId);
                                    <tr>
                                        <td>
                                            <Term Name="@(flaw?.Name ?? sf.FlawId)" Text="@flaw?.Description"
                                                  Enabled="@Explain" />
                                            @if (sf.NarrativeDetail is not null)
                                            {
                                                <span class="muted small"> — @sf.NarrativeDetail</span>
                                            }
                                        </td>
                                        <td>@FlawType(flaw?.FlawType ?? "regular")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </SheetSection>
            </div>

            <div class="sheet-col">
                @* The four figures a player reads off mid-scene, set as big as the
                   published sheet sets them. Hero Points is the tier budget: a Villain has
                   none (Ch.9), so that box carries what the character cost instead. *@
                <DerivedStatBlocks Class="quad" WithPoints="true" Explain="@Explain"
                                   Character="@Character" ShowBudget="@ShowBudget" />

                <SheetSection Title="Origin" Class="fill">
                    @if (Sources.Count > 0)
                    {
                        <p class="small">@string.Join(" · ", Sources)</p>
                    }
                    <RuledLines Count="@(Sources.Count > 0 ? 12 : 14)" />
                </SheetSection>
            </div>
        </div>

        @* ── Foot ──────────────────────────────────────────────────────────── *@
        <div class="grid three sheet-foot">
            <SheetSection Title="Description">
                @if (string.IsNullOrWhiteSpace(Sheet.Appearance))
                {
                    <RuledLines Count="8" />
                }
                else
                {
                    <p class="small">@Sheet.Appearance</p>
                }
            </SheetSection>

            <SheetSection Title="Details">
                <RuledLines Count="8" />
            </SheetSection>

            <SheetSection Title="Connections">
                @if (Sheet.Connections.Count == 0)
                {
                    <RuledLines Count="8" />
                }
                else
                {
                    <ul class="plain-list small">
                        @foreach (var connection in Sheet.Connections)
                        {
                            <li>@connection</li>
                        }
                    </ul>
                }
            </SheetSection>
        </div>

        @* A colophon, printed once at the end and never shown on screen, so the last page
           of a sheet that has come apart on a table still says whose it is.

           It was a running footer on every page first, and that does not work: `position:
           fixed` in Chrome's print output lands the element at the top of page two rather
           than in each page's bottom margin. *@
        <footer class="sheet-footer">
            @DisplayName · Prowlers &amp; Paragons@(Tier is null ? "" : $" · {Tier.Name}")
        </footer>
    </div>
</article>

@code {
    /// <summary>
    /// A character to print instead of the one being built.
    ///
    /// <para>It exists so the replay can put a recorded character's sheet in front of somebody
    /// without loading it over theirs first. There is deliberately only <b>one</b> sheet
    /// component in this app: a second copy would look right for exactly as long as it took
    /// the first to change, and the printed sheet is the thing this whole tool produces.</para>
    ///
    /// <para>It replaces the character and nothing else. The rules, the calculators and the
    /// Source grouping still come from the session, because they are the same for everyone —
    /// only the sheet being read differs.</para>
    /// </summary>
    [Parameter] public CharacterSheet? Character { get; set; }

    /// <summary>
    /// Whether every name on the sheet carries what it means, on hover and on focus.
    ///
    /// <para><b>On by default, which reverses what this said.</b> It used to be off everywhere but
    /// one address, on the argument that "the printed sheet is what this whole tool produces and a
    /// sheet that gained forty controls would be a different document". The premise was right and
    /// the conclusion did not follow: **the printed sheet gains nothing.** The print block
    /// neutralises a term outright — <c>.row-tip</c> is shut unless hovered and paper cannot be
    /// hovered, the <c>sr-only</c> copy is a clipped 1px box, and <c>.term-name</c> gives up its
    /// underline and its cursor — so the page that comes out of the printer is identical either
    /// way. What the old default actually cost was the screen: a second address for the same sheet,
    /// and a reader who had to know to ask.</para>
    ///
    /// <para><b>Off is still a real setting and is still exercised</b>, because the fallback it
    /// selects is not decoration: <c>Term</c> draws the bare name when there is nothing to say, and
    /// that path has to keep rendering exactly what the sheet rendered before. It is what
    /// <c>ExplainedSheetTests</c> compares the explained sheet against, word for word.</para>
    ///
    /// <para>The descriptions are the ones in <c>data/rules</c>, which is verified entry by entry
    /// against the page. Nothing here writes a sentence about a rule.</para>
    /// </summary>
    [Parameter] public bool Explain { get; set; } = true;

    /// <summary>
    /// Whether the four-figure block measures the spend against a budget. Defaults to the
    /// app's own mode; passed only when printing somebody else's character, because whether
    /// <em>that</em> one is a Villain has nothing to do with the palette this visitor is in.
    /// </summary>
    [Parameter] public bool? ShowBudget { get; set; }

    private CharacterSheet Sheet => Character ?? Session.Sheet;

    /// <summary>
    /// Redraw when the character being built changes.
    ///
    /// <para><b>Nothing else can make this component notice.</b> It reads the session and takes
    /// no parameter that changes, so Blazor has nothing to compare and skips it when the parent
    /// re-renders — measured, not assumed: the step above it redrew its tab strip to "Powers 1"
    /// while the sheet beside it still showed twelve blank rules. That was invisible while the
    /// only sheet on screen was the review step's, where the character is finished by the time
    /// anybody looks.</para>
    ///
    /// <para><b>Only when this is the session's own character.</b> A recording is handed over as
    /// a parameter and is fixed for the life of the render; subscribing there would tie a
    /// recorded sheet to the visitor's own edits, which is the exact influence the replay guard
    /// renders two pages to forbid.</para>
    /// </summary>
    /// <summary>
    /// Whether this instance subscribed, latched at initialisation.
    ///
    /// <para><b>Re-reading <see cref="Character"/> at disposal was a leak</b>, and it went
    /// unnoticed until a host existed where the parameter transitions on a reused instance:
    /// <c>/sheet</c> to <c>/sheet/{id}</c> creates this component with no character and disposes
    /// it with one, so the condition answered true on the way in and false on the way out and the
    /// handler stayed attached to <see cref="CharacterSession.Changed"/> for the life of the
    /// session. Whether it subscribed is a fact about what happened, not a question to ask the
    /// parameters again later.</para>
    /// </summary>
    private bool _subscribed;

    protected override void OnInitialized()
    {
        _subscribed = Character is null;
        if (_subscribed) Session.Changed += StateHasChanged;
    }

    public void Dispose()
    {
        if (_subscribed) Session.Changed -= StateHasChanged;
    }

    /// <summary>
    /// A Hero Point figure, or a dash. Every other cost on this sheet already went through
    /// this and the Perk and Gear boxes did not, which was a real crash rather than an
    /// inconsistency: the engine throws rather than guessing on an id it does not have, and a
    /// throw during render in the browser takes down the whole app rather than one box. That
    /// reaches an unknown perk id in a restored character as well as in a recorded one.
    /// </summary>
    private static string Cost(Func<int> cost) =>
        CharacterSession.TryCost(cost)?.ToString() ?? "—";

    /// <summary>
    /// One line of gear, or the item's bare name if it cannot be priced. Same objection as
    /// <see cref="Cost"/>, and the name is the part worth keeping on the page: a piece of gear
    /// nobody can cost is still a piece of gear the character is carrying.
    /// </summary>
    /// <remarks>
    /// <c>Name</c> is declared non-null and a deserializer puts a null there anyway — the same
    /// story as the null checks in <c>CharacterValidator</c>, and silenced in
    /// <c>.editorconfig</c> for the same reason. Written as a coalesce rather than as a
    /// nullable return because the two spellings pull opposite inspections: dropping the
    /// coalesce trades "this can never be null" for "then why is the return type nullable",
    /// and only one of the two can be silenced honestly.
    /// </remarks>
    private string Describe(SelectedGear item)
    {
        try { return GearFormatter.Describe(item, Session.Rules, Session.Costs); }
        catch (InvalidOperationException) { return item.Name ?? ""; }
    }

    private string DisplayName =>
        string.IsNullOrWhiteSpace(Sheet.Name) ? "Unnamed" : Sheet.Name;

    private TierModel? Tier =>
        Sheet.SelectedTierId is null ? null : Session.Rules.GetTier(Sheet.SelectedTierId);

    private OptionalPackage? Package =>
        Sheet.SelectedPackageId is null
            ? null
            : Session.Rules.CreationRules.OptionalPackages
                .FirstOrDefault(p => p.Id == Sheet.SelectedPackageId);

    /// <summary>Tier, package and Trait Cap — the frame the rest of the sheet is measured in.</summary>
    private string Meta
    {
        get
        {
            var parts = new List<string> { Tier?.Name ?? "No tier" };
            if (Package is { } pkg) parts.Add(pkg.Name);
            // The cap this character is built to, which is the tier's until a game tightens it —
            // and then the tier's is said too, because a sheet reading "Trait Cap 6d" at Standard
            // looks like a mistake to anybody who knows the tier allows 12d.
            if (DerivedStatsCalculator.EffectiveTraitCap(Sheet, Tier) is { } cap)
            {
                parts.Add(Tier is { } tier && cap != tier.TraitCapRank
                    ? $"Trait Cap {cap}d (tier {tier.TraitCapRank}d)"
                    : $"Trait Cap {cap}d");
            }
            return string.Join(" · ", parts);
        }
    }

    /// <summary>
    /// The Source groups this sheet prints. Named rather than repeated inline because three
    /// places ask for it: whether the Powers column is a blank form, the groups themselves,
    /// and the Origin box.
    ///
    /// <para>It is <b>recomputed on each of those reads</b> — this is an expression-bodied
    /// property, not a cache. That is deliberate: <c>GroupBySource</c> is pure and cheap
    /// against six Sources, six Abilities and twelve Talents, and caching it in a field
    /// would add a way for the sheet to render a character it no longer holds.</para>
    /// </summary>
    private IReadOnlyList<SourceGrouping.Group> Groups =>
        Session.Grouping.GroupBySource(Sheet);

    /// <summary>
    /// The Sources this character draws on, in the rulebook's order. Read off the groups
    /// rather than off the Powers, so a Trait bought through powered armour puts Tech here
    /// even on a character with no Tech Power.
    /// </summary>
    private List<string> Sources =>
        Groups.Where(g => g.Source is not null).Select(g => g.Source!.Name).ToList();

    /// <summary>
    /// A Trait's rank, always as a number. An unbought Trait is 0d — which is a fact about
    /// the character, not a gap in the sheet — so it says 0d rather than leaving a rule to
    /// write on. The blank rules are for the fields the tool genuinely has no answer for.
    /// </summary>
    private static string Rank(int rank) => $"{rank}d";

    /// <summary>
    /// A Power's rank, printed whenever the Power has one at all — including 0d, and
    /// including a baseline Power whose nominated Trait happens to be 0d, because "Armor 0d"
    /// tells a reader something and a missing number tells them nothing.
    ///
    /// <para>Only a genuinely rankless Power gets no figure. Its stat line already says
    /// "Default Rank (no rank)", and printing 0d beside that would read as a rank of zero
    /// rather than as the absence of one — which are different things: a rankless Power
    /// stands in at its Source's Ability whenever another Power acts on it.</para>
    /// </summary>
    private static string Ranked(PowerModel? power, int rank) =>
        power is null || power.RankType is "default" or "special" ? "" : $" {rank}d";

    /// <summary>
    /// For a rankless Power with a Source: which Ability stands in for its rank when another
    /// Power acts on it, and what that comes to. Null for anything with a rank of its own,
    /// and for a rankless Power with no Source recorded — the validator warns about that.
    /// </summary>
    private string? StandInRank(SelectedPower sp, PowerModel? power)
    {
        if (power is null || power.RankType is not ("default" or "special")) return null;
        if (sp.SourceId is null || Session.Rules.GetSource(sp.SourceId) is not { } source) return null;

        var ability = Session.Rules.GetAbility(source.DefaultRankAbility)?.Name ?? source.DefaultRankAbility;

        return $"Against other Powers: {ability} {Session.Derived.GetRankAgainstPowers(sp, Sheet)}d";
    }

    private static string FlawType(string flawType) => flawType switch
    {
        "condition"               => "Condition",
        "plot_hook"               => "Plot Hook",
        "plot_hook_and_condition" => "Plot Hook + Condition",
        _                         => ""
    };

    private string Label(SelectedProCon choice, PowerModel? power)
    {
        var name = power?.PowerPros.Concat(power.PowerCons).FirstOrDefault(e => e.Id == choice.Id)?.Name
                   ?? Session.Rules.GetPro(choice.Id)?.Name
                   ?? Session.Rules.GetCon(choice.Id)?.Name
                   ?? choice.Id;
        return choice.VariantKey is null ? name : $"{name} ({Labels.Humanise(choice.VariantKey)})";
    }
}
