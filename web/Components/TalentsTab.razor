@inject CharacterSession Session
@inject DismissedFindings Dismissed

<Panel Title="Talents"
       Aside="1 HP per rank · an ordinary human averages 2d"
       Cost="@($"{Session.Costs.TalentCost(Session.Sheet)} HP")">

    @foreach (var talent in Session.Rules.Talents)
    {
        var id = talent.Id;
        <RankRow Name="@talent.Name"
                 Sub="@($"linked to {Session.Rules.GetAbility(talent.LinkedAbility)?.Name ?? talent.LinkedAbility}")"
                 Rank="Session.Sheet.GetTalentRank(id)"
                 Floor="1"
                 PackageFloor="@PackageTalentRank"
                 Max="@Session.TraitCap"
                 Description="@talent.Description"
                 RankGuide="@talent.RankGuide"
                 RankChanged="rank => SetTalent(id, rank)" />

        <RowFinding Issues="Visible(SheetFindings.ForTalent(Validation, id))"
                    OnDismiss="issue => Dismiss(issue, SheetFindings.ForTalent(Validation, id))" />
    }
</Panel>

<TraitSourcePicker Title="Sources for these Talents" Scope="talent"
                   Traits="@Session.Rules.Talents.Select(t => (t.Id, t.Name)).ToList()"
                   Sources="Session.Sheet.TalentSources"
                   DefaultSourceId="@SourceGrouping.DefaultTalentSourceId" />

@code {
    /// <summary>Read fresh on every render — see <c>Review.razor</c>'s own <c>Validation</c>.</summary>
    private ValidationResult Validation => Session.Validate();

    private string CharacterId => DismissedFindings.CharacterKey(Session);

    /// <summary>
    /// Re-read on every render this component takes part in, so a character switch that leaves
    /// this component in place never draws with a stale id's dismissals — see
    /// <c>ChosenRow</c>'s own copy of this reasoning.
    /// </summary>
    protected override async Task OnParametersSetAsync() => await Dismissed.LoadAsync(CharacterId);

    private List<ValidationIssue> Visible(IReadOnlyList<ValidationIssue> routed) =>
        [.. routed.Where(i => !Dismissed.IsDismissed(CharacterId, i))];

    private async Task Dismiss(ValidationIssue issue, IReadOnlyList<ValidationIssue> routed)
    {
        await Dismissed.DismissAsync(CharacterId, issue, routed);
        StateHasChanged();
    }

    private int PackageTalentRank =>
        Session.Sheet.SelectedPackageId is null
            ? 0
            : Session.Rules.CreationRules.OptionalPackages
                .FirstOrDefault(p => p.Id == Session.Sheet.SelectedPackageId)?.TalentsRank ?? 0;

    private void SetTalent(string id, int rank)
    {
        Session.Sheet.TalentRanks[id] = rank;
        Session.NotifyChanged();
    }
}
