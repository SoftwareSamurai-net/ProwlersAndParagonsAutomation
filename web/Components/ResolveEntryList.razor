@* One block of the Resolve reference page: a plain list of entries, each with its name, a
   plain-words cost where the data gives one, its player-facing summary, and the printed page it
   comes from. The entry's `description` is a maintainer's transcription note and is never shown
   here — see docs/guide/play-rules.md. Built on <ChosenList>/<ChosenRow> rather than
   hand-written markup, so this is not a second component writing the "chosen" and "chosen-row"
   classes those already own. *@

@if (Rows is null || !Rows.Any())
{
    <EmptyState>Nothing landed in this block.</EmptyState>
}
else
{
    <ChosenList>
        @foreach (var entry in Rows)
        {
            <ChosenRow Cost="@ResolveReferenceBlocks.PrintedPage(entry.SourceRef)">
                <Body>
                    <div>
                        <b>@entry.Name</b>
                        @if (ResolveReferenceBlocks.CostWords(entry) is { } cost)
                        {
                            <span class="tag">@cost</span>
                        }
                    </div>
                    <div class="small muted">@entry.Summary</div>
                </Body>
            </ChosenRow>
        }
    </ChosenList>
}

@code {
    [Parameter] public IEnumerable<ResolveEntry>? Rows { get; set; }
}
