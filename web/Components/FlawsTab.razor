@inject CharacterSession Session

<Panel Title="Flaws"
       Aside="@($"{Rules.MinAtCreation}–{Rules.MaxAtCreation} at creation, {Rules.MaxEver} ever · each one beyond {Rules.MaxAtCreation} costs {Rules.ExtraFlawCostHp} HP")"
       Cost="@($"{Session.Sheet.Flaws.Count} chosen")">

    <p class="small muted">
        Flaws are narrative disadvantages that earn Resolve when they cause trouble. A
        Condition is always in effect; a Plot Hook is something the GM can reach for. Each
        of either adds 1 to starting Resolve, which is why the count is a rules matter and
        not just flavour.
    </p>

    @if (Session.Sheet.Flaws.Count == 0)
    {
        @* The next action, and the reason it is not optional. The Resolve rule is already
           stated above, so repeating it here would be the duplication the derived step just
           lost; what this adds is the count the rules require, read from the same place the
           heading reads it rather than written out again. *@
        <EmptyState>
            No Flaws yet, and the rules ask for at least @Rules.MinAtCreation at creation.
            Add one below.
        </EmptyState>
    }
    else
    {
        <ChosenList>
            @foreach (var sf in Session.Sheet.Flaws.ToList())
            {
                var chosen = Session.Rules.GetFlaw(sf.FlawId);
                <ChosenRow>
                    <Body>
                        <div>
                            <b>@(chosen?.Name ?? sf.FlawId)</b>
                            <span class="tag">@TypeLabel(chosen?.FlawType ?? "regular")</span>
                        </div>
                        @if (sf.NarrativeDetail is not null)
                        {
                            <div class="small muted">@sf.NarrativeDetail</div>
                        }
                    </Body>
                    <Actions>
                        <button type="button" class="btn small danger" @onclick="() => Remove(sf)">Remove</button>
                    </Actions>
                </ChosenRow>
            }
        </ChosenList>
    }
</Panel>

@if (_pending is { } flaw)
{
    <Panel Title="@flaw.Name" Level="3">
        <Head>
            <span class="tag">@TypeLabel(flaw.FlawType)</span>
        </Head>
        <ChildContent>
            <p class="small">@flaw.Description</p>

            @if (flaw.NarrativeConstraint is not null)
            {
                <Field For="fl-detail" Label="@flaw.NarrativeConstraint">
                    <input id="fl-detail" type="text" class="wide" @bind="_detail" @bind:event="oninput" />
                </Field>
            }

            <div class="inline">
                <button type="button" class="btn primary" disabled="@(!CanAdd(flaw))" @onclick="() => Add(flaw)">Add flaw</button>
                <button type="button" class="btn" @onclick="() => _pending = null">Cancel</button>
            </div>
        </ChildContent>
    </Panel>
}
else
{
    <Panel Title="Add a flaw" Level="3">
        <OptionList Placeholder="Filter Flaws by name or description">
            @foreach (var option in Available)
            {
                <OptionRow Name="@option.Name"
                           Caveat="@option.Description"
                           Cost="@TypeLabel(option.FlawType)"
                           OnSelect="() => Begin(option)" />
            }
        </OptionList>
    </Panel>
}

@code {
    private FlawModel? _pending;
    private string _detail = "";

    private FlawRules Rules => Session.Rules.CreationRules.FlawRules;

    private List<FlawModel> Available =>
        Session.Rules.Flaws
            .Where(f => Session.Sheet.Flaws.All(sf => sf.FlawId != f.Id))
            .OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private void Begin(FlawModel flaw)
    {
        _pending = flaw;
        _detail  = "";
    }

    private bool CanAdd(FlawModel flaw) =>
        flaw.NarrativeConstraint is null || !string.IsNullOrWhiteSpace(_detail);

    /// <summary>
    /// The count is not capped here. CharacterValidator owns the creation minimum and
    /// maximum and reports them on the review step, and a page that quietly refused the
    /// fourth flaw would be a second copy of that rule in a place with no test on it.
    /// </summary>
    private void Add(FlawModel flaw)
    {
        Session.Sheet.Flaws.Add(new SelectedFlaw(
            flaw.Id,
            string.IsNullOrWhiteSpace(_detail) ? null : _detail.Trim()));

        _pending = null;
        Session.NotifyChanged();
    }

    private void Remove(SelectedFlaw sf)
    {
        Session.Sheet.Flaws.Remove(sf);
        Session.NotifyChanged();
    }

    private static string TypeLabel(string flawType) => flawType switch
    {
        "condition"               => "Condition",
        "plot_hook"               => "Plot Hook",
        "plot_hook_and_condition" => "Plot Hook + Condition",
        _                         => "Regular"
    };
}
