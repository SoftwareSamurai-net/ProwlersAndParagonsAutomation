@inject CharacterSession Session
@inject Commands Commands

@if (_editing is { } editing)
{
    <PowerEditor Power="editing.Power" Existing="editing.Existing"
                 OnCommit="Commit" OnCancel="() => _editing = null" />
}
else
{
    <Panel Title="Powers on this character" Cost="@PowersCost()">
        @if (Session.Sheet.SelectedPowers.Count == 0)
        {
            @* An empty state names the next action. "None yet." is a full stop: it reports a
               fact the reader can already see and leaves them to work out what to do about it. *@
            <EmptyState>
                No Powers yet. Pick one from <b>Add a Power</b> below — the list shows each
                one's range, rank type and cost before you choose it.
            </EmptyState>
        }
        else
        {
            @* Grouped under Source headings the way a published sheet prints them —
               TECH POWERS, MAGIC POWERS. SourceGrouping is the engine's answer, shared
               with the text sheet and the JSON export. *@
            @* Groups holding only an Abilities (…) line are skipped here: this panel edits
               Powers, and a heading with nothing under it says less than no heading. The
               sheet prints those lines, which is where the published layout puts them. *@
            @foreach (var group in Session.Grouping.GroupBySource(Session.Sheet).Where(g => g.Powers.Count > 0))
            {
                <h3>@group.Heading</h3>
                <ChosenList>
                    @foreach (var sp in group.Powers)
                    {
                        var power = Session.Rules.GetPower(sp.PowerId);
                        var rank  = power is null ? 0 : Session.Derived.GetEffectiveRank(sp, Session.Sheet);
                        <ChosenRow Cost="@($"{CharacterSession.TryCost(() => Session.Costs.PowerCost(sp, Session.Sheet.ImmortalityCost))?.ToString() ?? "—"} HP")"
                                   Findings="SheetFindings.ForPower(Validation, sp.PowerId)">
                            <Body>
                                @* One expression for the name and the rank. A leading space
                                   inside the following element is stripped by Razor, which
                                   is what printed "Armor8d" here and on the sheet. *@
                                @* "No rank" belongs to a Power the rulebook gives no rank,
                                   not to one that happens to sit at 0d — a ranked Power with
                                   nothing bought yet is 0d, which is a fact about the
                                   character. Keyed on the rank alone, this said "no rank" for
                                   both and disagreed with the sheet about the same Power. *@
                                <div>
                                    <b>@(power?.Name ?? sp.PowerId)</b>
                                    @if (power is null || power.RankType is "default" or "special")
                                    {
                                        <span class="muted small">@(" no rank")</span>
                                    }
                                    else
                                    {
                                        <span class="muted">@($" {rank}d")</span>
                                    }
                                    @if (power?.NeedsReview == true)
                                    {
                                        <span class="tag warn">not checked against the book</span>
                                    }
                                </div>
                                @* Labelled separately, as on the sheet. Run together into one
                                   list a player cannot tell which of these cost Hero Points
                                   and which paid for the rest — which is the whole question
                                   they are on this page to answer. *@
                                @if (sp.Pros.Count > 0)
                                {
                                    <div class="small muted">Pros: @PowerFormatter.ModifierLine(sp.Pros, c => Label(c, power))</div>
                                }
                                @if (sp.Cons.Count > 0)
                                {
                                    <div class="small muted">Cons: @PowerFormatter.ModifierLine(sp.Cons, c => Label(c, power))</div>
                                }
                            </Body>
                            <Actions>
                                <button type="button" class="btn small" @onclick="() => Edit(sp)">Edit</button>
                                <button type="button" class="btn small danger" @onclick="() => Remove(sp)">Remove</button>
                            </Actions>
                        </ChosenRow>
                    }
                </ChosenList>
            }
        }
    </Panel>

    <Panel Title="Add a Power">
        @* The category is a facet and stays here; the text search is not, and moved into
           OptionList so that every other list of options got one too. Tags are passed
           through as keywords because they are searchable and never printed — the box used
           to read them and a filter that could only see the row would have narrowed it. *@
        <Field Class="inline">
            <select @bind="_category" aria-label="Category">
                <option value="">Every category</option>
                @foreach (var c in Categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </Field>

        <OptionList Placeholder="Filter Powers by name or tag">
            @foreach (var power in Matches)
            {
                <OptionRow Name="@power.Name"
                           Caveat="@PowerFormatter.StatLine(power)"
                           Description="@power.Description"
                           Cost="@power.Category"
                           Keywords="@power.Tags"
                           OnSelect="() => Add(power)">
                    <NameExtra>
                        @if (Session.Sheet.HasPower(power.Id))
                        {
                            <span class="tag own">on the sheet</span>
                        }
                    </NameExtra>
                </OptionRow>
            }
        </OptionList>
    </Panel>
}

@code {
    private sealed record Editing(PowerModel Power, SelectedPower? Existing);

    private Editing? _editing;
    private string _category = "";

    /// <summary>
    /// Read fresh on every render, the same as <c>Review.razor</c>'s own — the engine is cheap
    /// to ask and a cached answer would go stale the moment a Pro was added.
    /// </summary>
    private ValidationResult Validation => Session.Validate();

    /// <summary>
    /// Open the Power the palette was asked for, if there is one waiting.
    ///
    /// <para><b>Taken rather than read, and on parameters rather than on initialisation.</b>
    /// Taking is what stops the editor reopening over whatever the reader moved on to, since
    /// this runs again on every render of the step above. Initialisation would miss the case
    /// where they were already looking at this section, because nothing is created then.</para>
    ///
    /// <para>It opens the same editor a click on the list opens. The palette is a way to reach
    /// a control, never a second way to change a character: ranks, variants and the Pros and
    /// Cons are still chosen in the one component that knows how to price them.</para>
    /// </summary>
    protected override void OnParametersSet()
    {
        if (Commands.TakeRequestedPower() is not { } id) return;
        if (Session.Rules.GetPower(id) is { } power) Add(power);
    }

    private IEnumerable<string> Categories =>
        Session.Rules.Powers.Select(p => p.Category).Distinct().Order();

    /// <summary>
    /// Every Power in the chosen category. The text filter is <see cref="OptionList"/>'s and
    /// is deliberately not repeated here — the whole point of moving it was that this tab
    /// stops being the only one of the five with a search box.
    /// </summary>
    private List<PowerModel> Matches =>
        Session.Rules.Powers
            .Where(p => _category.Length == 0 || p.Category == _category)
            .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private void Add(PowerModel power) =>
        _editing = new Editing(power, Session.Sheet.GetPower(power.Id));

    private void Edit(SelectedPower sp)
    {
        if (Session.Rules.GetPower(sp.PowerId) is { } power)
            _editing = new Editing(power, sp);
    }

    /// <summary>
    /// One entry per Power, as the CLI does: configuring a Power already on the sheet
    /// replaces it rather than adding a second copy.
    /// </summary>
    private void Commit(SelectedPower selection)
    {
        Session.Sheet.SelectedPowers.RemoveAll(sp => sp.PowerId == selection.PowerId);
        Session.Sheet.SelectedPowers.Add(selection);
        _editing = null;
        Session.NotifyChanged();
    }

    private void Remove(SelectedPower sp)
    {
        Session.Sheet.SelectedPowers.Remove(sp);
        Session.NotifyChanged();
    }

    private string PowersCost() =>
        CharacterSession.TryCost(() => Session.Costs.TotalPowersCost(Session.Sheet)) is { } c
            ? $"{c} HP"
            : "not costable yet";

    /// <summary>
    /// A Power's own Pro or Con takes precedence over a generic one of the same id — it is
    /// the one its rulebook entry is talking about, and CostCalculator resolves it the
    /// same way round.
    /// </summary>
    private string Label(SelectedProCon choice, PowerModel? power)
    {
        var name = power?.PowerPros.Concat(power.PowerCons).FirstOrDefault(e => e.Id == choice.Id)?.Name
                   ?? Session.Rules.GetPro(choice.Id)?.Name
                   ?? Session.Rules.GetCon(choice.Id)?.Name
                   ?? choice.Id;
        return choice.VariantKey is null ? name : $"{name} ({Labels.Humanise(choice.VariantKey)})";
    }
}
