@page "/signin"
@inject Accounts Accounts
@inject AccountCharacterStore Store
@inject CharacterSession Session
@inject NavigationManager Nav
@implements IDisposable

@* Signing in, and the one place a link's token is spent.

   **There is no password on this page and there is not going to be one.** What proves who
   somebody is, is that they can read the address — so the form asks for one thing, the server
   mails a link, and the link is spent here. Nothing on this page holds a credential: the session
   is an HttpOnly cookie the browser keeps and no script can read.

   The page has two jobs and knows which by its own address. Arriving with `?t=` is somebody
   coming back from their mail, so the token is spent immediately; arriving without one is
   somebody starting, so the form is shown. *@

<PageTitle>Sign in — Prowlers &amp; Paragons</PageTitle>

<h1>Your account</h1>

@if (_who?.IsSignedIn == true)
{
    <Panel Title="Signed in">
        <p>
            You are signed in as <strong>@_who.DisplayName</strong>. Your characters are kept with
            your account, so they are there in any browser you sign in to.
        </p>

        @if (_offerToKeep)
        {
            @* Offered, never done by itself. This browser's anonymous character may not be
               theirs at all — a shared machine is exactly where a silent copy would be worst —
               and it is only offered when the account has none, so nothing is ever written over. *@
            <p>
                This browser was holding a character before you signed in
                (<strong>@_anonymousName</strong>), and your account has none yet.
            </p>
            <p>
                <button type="button" class="btn" @onclick="KeepAnonymous">
                    Keep that character on this account
                </button>
            </p>
        }

        @if (_kept)
        {
            <p>Kept. It belongs to your account now, and the one in this browser is untouched.</p>
        }

        @* **Offered to everybody signed in, not only to whoever it is for.** Which account
           may manage the list is the server's answer and it is checked on every request there;
           showing this link conditionally would mean the browser holding a claim about who
           somebody is, which is the one thing identity here deliberately does not carry. So an
           account it is not for follows it once and is told so plainly. *@
        <p class="small muted">
            If you look after who can sign in to this site, <a href="admin">that list is here</a>.
        </p>

        <p>
            <button type="button" class="btn danger" @onclick="SignOut">Sign out</button>
        </p>
        <p class="small muted">
            Signing out leaves the character this browser was building exactly where it was.
        </p>
    </Panel>
}
else
{
    <Panel Title="Sign in">
        <p>
            An account keeps your characters with you rather than with this browser, and opens the
            rulebook's own text where you are choosing a Power.
        </p>

        @if (_sent)
        {
            @* "Can have" rather than "has", because under an invitation list there are two
               things this must stay vague about and one of them is new: whether the address is
               on the list at all, and whether it has got as far as an account. An invited
               address that has never signed in has no account row yet and still gets a link;
               an uninvited one gets this same sentence and no mail. That is what
               stops this page being a way of finding out, one address at a time. **The reason
               belongs here and not on the screen**: it is a decision about how the page is
               built, and a reader came to sign in. It said so out loud until somebody read it
               back. *@
            @* Kept on one line: SignInPageTests matches the phrase in the markup, so a wrap
               between "its" and "way" fails it. *@
            <p>
                Check your inbox — if that address can have an account here, a sign-in link is on its way.
                The link works once and expires in fifteen minutes.
            </p>
        }
        else
        {
            <form @onsubmit="Ask" @onsubmit:preventDefault>
                <Field For="signin-email">
                    <LabelContent>Your email address</LabelContent>
                    <ChildContent>
                        <input id="signin-email" type="email" autocomplete="email"
                               @bind="_email" @bind:event="oninput" />
                    </ChildContent>
                </Field>

                <p>
                    <button type="submit" class="btn" disabled="@_asking">
                        @(_asking ? "Sending…" : "Email me a link")
                    </button>
                </p>
            </form>

            @if (_problem is { } problem)
            {
                <p role="alert">@problem</p>
            }
        }
    </Panel>
}

@if (_spending)
{
    <Panel Title="Signing you in">
        <p>Checking your link…</p>
    </Panel>
}

@code {
    [SupplyParameterFromQuery(Name = "t")] public string? Token { get; set; }

    private Identity? _who;
    private string _email = "";
    private bool _asking;
    private bool _sent;
    private bool _spending;
    private string? _problem;
    private bool _offerToKeep;
    private bool _kept;
    private string? _anonymousName;

    protected override async Task OnInitializedAsync()
    {
        Accounts.Changed += OnChanged;

        if (!string.IsNullOrWhiteSpace(Token))
        {
            _spending = true;
            StateHasChanged();

            if (await Accounts.CompleteSignInAsync(Token))
            {
                // The character now belongs somewhere else, so it is read from there rather than
                // left as whatever this browser was holding. A sign-in that left the anonymous
                // character on screen under an account's name is the shape that gets somebody
                // else's work saved to your account.
                if (await Store.LoadAsync() is { } theirs) Session.Restore(theirs.Sheet, theirs.Mode);
                else Session.StartAgain();

                await OfferToKeepAnythingLeftBehind();
            }
            else
            {
                _problem = "That sign-in link is not usable. Ask for another.";
            }

            _spending = false;

            // The token is taken out of the address bar either way. It is spent, so it is of no
            // further use to anybody — but a URL in a history, a bookmark or a shared screenshot
            // is exactly where a secret should not still be.
            Nav.NavigateTo("signin", replace: true);
        }

        _who = await Accounts.CurrentAsync();
    }

    private async Task Ask()
    {
        _asking = true;
        _problem = null;

        var outcome = await Accounts.AskForLinkAsync(_email);

        _asking = false;

        // Accepted says nothing about whether an account exists, deliberately — see the note on
        // the server's own endpoint. Only the honest refusals get a message.
        _sent = outcome.Result == LinkRequest.Accepted;
        _problem = outcome.Result switch
        {
            LinkRequest.NotAnAddress => "That does not look like an email address.",

            // **Only this one may advise trying again**, because it is the only one where
            // nothing was reached and waiting might genuinely help.
            LinkRequest.Unavailable => "Could not reach the site just now. Try again in a moment.",

            // Reached, and broken at our end. Telling somebody to try again would be advice to
            // keep doing the one thing that cannot work — which is what the old shared message
            // did, because a 500 and a dead network were a single outcome. Saying the address is
            // fine matters too: the natural reading of a failure here is that you typed it wrong.
            LinkRequest.Failed => outcome.Reference is { Length: > 0 } reference
                ? "Something went wrong at our end, so no link was sent. Nothing is wrong with "
                  + $"your address. If you report this, quote reference {reference}."
                : "Something went wrong at our end, so no link was sent. Nothing is wrong with "
                  + "your address.",

            _ => null,
        };
    }

    private async Task SignOut()
    {
        await Accounts.SignOutAsync();

        // Back to whatever this browser was holding before, which signing in never touched.
        if (await Store.LoadAsync() is { } local) Session.Restore(local.Sheet, local.Mode);
        else Session.StartAgain();

        _who = Identity.Anonymous;
        _offerToKeep = false;
        _kept = false;
    }

    private async Task OfferToKeepAnythingLeftBehind()
    {
        if (await Store.AccountHasCharacterAsync()) return;
        if (await Store.LoadAnonymousAsync() is not { } left) return;

        _anonymousName = string.IsNullOrWhiteSpace(left.Sheet.Name) ? "unnamed" : left.Sheet.Name;
        _offerToKeep = true;
    }

    private async Task KeepAnonymous()
    {
        _kept = await Store.KeepAnonymousCharacterAsync();
        _offerToKeep = false;

        if (_kept && await Store.LoadAsync() is { } now) Session.Restore(now.Sheet, now.Mode);
    }

    // Not `async void`: an exception out of one of those is unobservable and takes the renderer
    // down rather than the handler. InvokeAsync also puts the work on the renderer's own thread,
    // which is where StateHasChanged has to be called from.
    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        _who = await Accounts.CurrentAsync();
        StateHasChanged();
    });

    public void Dispose() => Accounts.Changed -= OnChanged;
}
