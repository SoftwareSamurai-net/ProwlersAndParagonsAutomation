@page "/campaign"
@implements IDisposable
@inject CharacterSession Session
@inject AccountCampaignStore Store
@inject ApiMembershipStore Memberships
@inject AccountCharacterStore Characters
@inject Accounts Accounts
@inject NavigationManager Nav

@* Running a game: the campaigns you run, the ones your characters are in, and the way between
   them.

   **A campaign holds a clone of a character, and a player's edits arrive as an approval
   request.** A player builds freely and needs nobody's permission to do it; when they want a
   change to count at the table they send a snapshot, and the GM accepts or rejects the whole
   thing. Accepting replaces the campaign's clone. Both sides keep a copy, so neither is ever
   editing the other's.

   **Account only, and the refusal is the first thing on the page rather than a control that does
   nothing.** A campaign exists so that two accounts can hand a snapshot between them: one kept in
   a single browser could never receive a submission, and its join code would be a code nobody
   could redeem. See `AccountCampaignStore`, which used to fall back and no longer does.

   **The whole snapshot is accepted or rejected, never one field of it.** Partial application is a
   merge algorithm for characters — a second engine, capable of producing a sheet neither person
   authored. The diff on the approval screen is a report, and there is deliberately no way to
   apply one row of it.

   **A tier disagreement is ordinary traffic and reads as information.** The owner's campaigns
   climb tiers in play, so a character built to one tier in a game played at another is a thing to
   notice rather than a fault: nothing is repaired either way, because raising a tier turns an
   illegal character legal in silence and lowering one moves Resolve. *@

<PageTitle>Campaigns — Prowlers &amp; Paragons</PageTitle>

<h1>Campaigns</h1>

@if (_available is false)
{
    @* Said before anything else, because every control below it would do nothing. *@
    <Panel Title="An account keeps a campaign">
        <p>A campaign is shared with the people at your table. <a href="signin">Sign in</a> to make one.</p>
        <p class="small muted">Your characters stay where they are either way.</p>
    </Panel>
}
else if (_available is null)
{
    <Panel Title="One moment">
        <p>Looking…</p>
    </Panel>
}
else
{
    <Panel Title="Games you run" Aside="@RunAside">
        @if (_running.Count == 0)
        {
            <EmptyState>No campaigns yet. Name one below and share its code with your players.</EmptyState>
        }
        else
        {
            <ul class="campaign-list">
                @foreach (var one in _running)
                {
                    <li>
                        <div class="campaign-row">
                            <span class="who">
                                <b class="nm">@one.Label</b>
                                <span class="meta">@RunningDetail(one)</span>
                            </span>

                            @* The waiting count is the notification. There is deliberately
                               nothing else — no badge elsewhere, no mail — because a count on the
                               page somebody opens to run their game is where it is looked for. *@
                            <a class="btn small" href="campaign/@one.Id">@ApprovalsLabel(one.Id)</a>

                            <button type="button" class="btn small quiet"
                                    aria-expanded="@(_open == one.Id ? "true" : "false")"
                                    @onclick="() => Toggle(one.Id)">
                                Settings
                            </button>
                        </div>

                        @if (_open == one.Id)
                        {
                            <div class="campaign-settings">
                                <p class="others-head">Join code</p>
                                <p class="joincode">@(one.Spoken ?? "None yet")</p>
                                <p class="small muted">Read this out to a player. A new code stops the old one working.</p>

                                @if (one.JoinCode is not null)
                                {
                                    @* One click selects the whole thing — `user-select: all` in
                                       app.css — because a link that pastes as two thirds of a URL
                                       is worse than a code somebody types. Built as one string so
                                       no line break in this markup lands inside it. *@
                                    <p class="others-head">Or send the link</p>
                                    <p class="joinlink"><span class="url">@JoinLink(one)</span></p>
                                    <p class="small muted">
                                        It fills the code in for whoever opens it. A player who has
                                        never used this can read
                                        <a href="join.html" target="_blank" rel="noopener">how to join</a>.
                                    </p>
                                }

                                <div class="inline">
                                    <button type="button" class="btn small"
                                            @onclick="() => NewCode(one.Id)">New code</button>
                                    <button type="button" class="btn small quiet"
                                            @onclick="() => Edit(one)">Rename or retier</button>
                                    <button type="button" class="btn small quiet"
                                            @onclick="() => Delete(one.Id)">Delete</button>
                                </div>

                                <p class="small muted">
                                    Deleting leaves every character naming it, and says so on their sheet.
                                </p>
                            </div>
                        }
                    </li>
                }
            </ul>
        }

        @if (_editing is not null)
        {
            <div class="campaign-editor">
                <p class="others-head">@(_editingIsNew ? "A new campaign" : "This campaign")</p>

                <Field Label="Name" For="campaign-name">
                    <input id="campaign-name" type="text" maxlength="80"
                           @bind="_name" @bind:event="oninput" />
                </Field>

                <Field Label="Tier" For="campaign-tier">
                    <select id="campaign-tier" value="@(_tierId ?? "")"
                            @onchange="e => _tierId = Blank(e.Value?.ToString())">
                        <option value="">The GM has not said</option>
                        @foreach (var tier in Session.Rules.Tiers)
                        {
                            <option value="@tier.Id">@tier.Name</option>
                        }
                    </select>
                </Field>

                @* Copied into a character that has no cap of its own when it joins, and never
                   over one that has — see `CampaignJoin`. It is a real setting rather than a
                   label: the cap a character carries is what its ranks are checked against and
                   what its Resolve is measured from, which is (Trait Cap − highest rank) × 2. *@
                <Field Label="Trait Cap" For="campaign-cap">
                    <input id="campaign-cap" type="number" min="1" max="30"
                           value="@_traitCap"
                           @onchange="e => _traitCap = Number(e.Value?.ToString())" />
                    <p class="small muted">
                        Tighter than the tier's. A character joining with no cap of its own takes
                        this; one that has a cap keeps it, and says so.
                    </p>

                    @* **Said, and not refused.** The box takes 1 to 30 whatever tier is chosen, so
                       a cap above the tier's ceiling was accepted in silence beside a hint saying
                       "Tighter than the tier's" — and every character that then inherited it
                       carried a `TRAIT_CAP_ABOVE_TIER` error the GM never saw coming. Refusing was
                       the alternative and is the wrong one here: a GM may type the cap before
                       choosing the tier, and a Save that does nothing is a control that looks
                       broken. Reporting is also what the engine does with the same mistake one
                       level down, so the two answers agree. *@
                    @if (LooseCap is { } loose)
                    {
                        <p class="small muted" role="status">@loose</p>
                    }
                </Field>

                @* **The one price the book hands to the table.** Ch.2 p.31 prices Immortality at
                   3 HP and then says a GM in a game where Heroes can die should charge between 6
                   and 12. It is copied onto a character that carries no price of its own when it
                   joins, exactly as the cap is — and unlike the cap it is Hero Points, so it moves
                   what every character in the game with the Power costs.

                   The bounds are read off the Power's own entry rather than typed here, for the
                   same reason no cost anywhere in this app is written into a component. *@
                <Field Label="@($"{ImmortalityName} costs")" For="campaign-immortality">
                    <input id="campaign-immortality" type="number" min="1" max="99"
                           value="@_immortality"
                           @onchange="e => _immortality = Number(e.Value?.ToString())" />
                    <p class="small muted">@ImmortalityHint</p>

                    @* Said, and not refused — the same choice the Trait Cap box makes one field
                       up, and for the same two reasons: a GM may type a figure before reading the
                       range, and the engine reports the same mistake one level down rather than
                       repairing it, so the two answers cannot disagree. *@
                    @if (LoosePrice is { } loosePrice)
                    {
                        <p class="small muted" role="status">@loosePrice</p>
                    }
                </Field>

                @* **The optional rules, adopted from a list.** p.79 introduces the ten Gritty
                   Combat Rules as optional and tells a table to review them before taking any, so
                   every one of these is off until a GM says otherwise — which is the book as
                   printed, and what a campaign that never opens this form is playing.

                   **Checkboxes rather than the two-card idiom**, which is for a boolean whose
                   single control has to label itself with either the state or the action and did
                   both by turns. A checkbox's label is the rule and its box is the answer, so
                   neither reading is ambiguous — and thirteen pairs of cards is twenty-six
                   controls for a menu somebody is picking from. Same idiom as the Gear editor's
                   paired-weapon box. *@
                <fieldset class="house-rules">
                    <legend class="others-head">Optional rules</legend>

                    <p class="small muted">
                        Off is the book as printed. Every player in the game sees what is on here,
                        and a character joining takes them.
                    </p>

                    @foreach (var rule in OptionalRules)
                    {
                        <label class="house-rule">
                            <input type="checkbox" checked="@IsAdopted(rule.Key)"
                                   @onchange="e => SetRule(rule.Key, e.Value is true)" />
                            <span>@rule.Name</span>
                            <span class="small muted">@rule.Page</span>
                        </label>
                    }

                    @* Only where the switch that reads it is on. p.80 offers 9 and 12 and says the
                       ladder is open-ended, so this is a number rather than a second choice — and
                       a rank left behind under a switch nobody turned on is not a rule this table
                       adopted, which is why it is drawn inside the switch rather than beside it. *@
                    @if (_table.RaisedGearLimit)
                    {
                        <Field Label="Gear Limit" For="campaign-gear-limit">
                            <input id="campaign-gear-limit" type="number" min="1" max="30"
                                   value="@_table.GearLimitRank"
                                   @onchange="e => SetGearLimit(Number(e.Value?.ToString()))" />
                            <p class="small muted">
                                The highest rank mundane equipment carries. p.80 offers 9 and 12.
                            </p>
                        </Field>
                    }
                </fieldset>

                <div class="inline">
                    <button type="button" class="btn primary" @onclick="Save">Save</button>
                    <button type="button" class="btn quiet" @onclick="() => _editing = null">Cancel</button>
                </div>

                @if (_problem is { } problem)
                {
                    <p class="small muted spaced" role="status">
                        @problem
                        @if (_offerReload)
                        {
                            <text> <a href=".">Reload</a></text>
                        }
                    </p>
                }
            </div>
        }
        else
        {
            <div class="make-another">
                <button type="button" class="btn primary" @onclick="StartNew">Name a campaign</button>
            </div>
        }
    </Panel>

    <Panel Title="Games you are in" Aside="@InAside">
        @* **What the character on screen and its campaign disagree about, said where its games
           are.** `CampaignJoin.Inspect` answers for as long as a disagreement is true rather than
           only at the moment of a join — so one that arrived by the GM retiering the campaign, or
           by the campaign being deleted, is as visible as one that arrived by a refused join. This
           is the only place it is drawn; before it existed the findings were computed by nobody.

           **Information, not an error.** These campaigns climb tiers in play, and nothing is
           repaired either way: raising a tier turns an illegal character legal in silence and
           lowering it moves Resolve. Same voice as the tier line on the tier page. *@
        @if (Finding is { } finding)
        {
            <p class="small muted" role="status">@finding.Message @Ranks(finding)</p>
        }

        @* **The house rules in force for the character on screen, where a player will look for
           them.** The read-only half of the GM's form above: every member sees what the table has
           decided and only the GM can change it.

           **Read off the character rather than off the campaign, and that is not a shortcut.** A
           player cannot read a campaign's payload at all — the server scopes it to the account
           that owns it, which is why `Inspect` answers `UNKNOWN_CAMPAIGN` to a member — so the
           campaign's own copy is not a thing this panel could draw. What the character carries
           *is* the answer for that character: it was copied in on joining, it is what the engine
           prices from, and it is what travels to a fight. So the heading says whose it is.

           **Nothing at all for a character playing the book**, which is a heading over thirteen
           "no"s and true of every game — the same question `CampaignTable.IsTheBook` answers for
           the printed sheet.

           **And the sentence under it says the list is a copy, because it is one and nothing
           refreshes it.** A join writes into empty fields only, so a GM who changes the game
           afterwards changes nothing here; `Inspect` reports that disagreement, and a member is
           the one reader who can never see the report — the campaign it is computed from does not
           resolve for them. "Only the GM can change them" was true of the game and false of the
           list underneath it, and a reader has no way to tell those apart from a screen that
           states the first. So this says when the copy was taken and what would take a new one. *@
        @if (HouseRules is { Count: > 0 } house)
        {
            <p class="others-head">House rules on this character</p>
            <ul class="house-rules-read">
                @foreach (var line in house)
                {
                    <li class="small">@line</li>
                }
            </ul>
            <p class="small muted">
                Set by whoever runs the game and copied onto the character when it joined. A later
                change by the GM arrives when this character joins again.
            </p>
        }

        @* **The table as it stands, beside the copy above — the half a member could not see.**
           A campaign's payload is scoped to the account that owns it, so this is not
           `AccountCampaignStore` answering: it is `GET /api/memberships/{id}/table`, authorised by
           the reader's own membership row, which is the one thing on this server that says a
           player belongs at that table. See `docs/guide/accounts-server.md`.

           **Two lists rather than one, because they are two different facts.** What the character
           carries is what it is costed by and what travels to a fight; what the table has decided
           is what the next character to join will take. They were the same list at the moment of
           the join and nothing keeps them in step afterwards, which is exactly why both headings
           say whose they are.

           **Drawn only where the live read answered**, which is a member of a game that is still
           there. A GM reads their own campaign and never comes down this branch; a read that
           failed leaves the panel exactly as it was before any of this existed, which is the copy
           alone.

           **And the differences are the point of the pair.** `CampaignDiff.BetweenTables` is the
           same comparison and the same thirteen names the GM's approval screen reads, in the same
           `Fatal Damage off → on` idiom — a second one here would be a second chance to name a
           switch differently from the book. Nothing is repaired: joining again is what takes a new
           copy, and it is the only thing that ever writes one. *@
        @if (_live is not null)
        {
            <p class="others-head">House rules at the table now</p>

            @if (LiveHouseRules is { Count: > 0 } table)
            {
                <ul class="house-rules-read">
                    @foreach (var line in table)
                    {
                        <li class="small">@line</li>
                    }
                </ul>
            }
            else
            {
                <p class="small muted">The book as printed.</p>
            }

            @if (TableChanges is { Count: > 0 } moved)
            {
                <DiffRows Rows="moved" />
                <p class="small muted" role="status">
                    The character keeps its own until it joins again.
                </p>
            }

            @* **When this was read, and a way to read it again.** The heading above says "now",
               which is a claim about currency this page cannot keep on its own: the live table is
               fetched when the panel opens and after anything that reloads the lists, and never
               again. So a player sitting on the screen while the GM changes a setting is reading a
               list that says "now" and means "when you arrived" — the exact dishonesty the copy's
               own sentence was rewritten to fix, one heading further down.

               The age is the honest half and the button is the cheap half: one request, the same
               one, rather than the whole Refresh a reload costs. See `RecheckTable`. *@
            <p class="small muted">
                Read @LiveAge.
                <button type="button" class="btn quiet" @onclick="RecheckTable">Check again</button>
            </p>
        }
        else if (_liveWentAway)
        {
            @* **A recheck that answered nothing says so rather than taking the list away.** The
               section vanishing is right on a first render — the panel then draws what it always
               drew — but a reader who has just pressed a button and watched a list disappear has
               been told nothing at all about why. *@
            <p class="small muted" role="status">
                The table could not be read just now, so the list above is the character's own
                copy. The game may have been deleted.
            </p>
        }

        @if (_playing is null)
        {
            <EmptyState>Your games could not be read. Try again in a moment.</EmptyState>
        }
        else if (_playing.Count == 0)
        {
            <EmptyState>None yet. Type a code below to put a character into somebody's game.</EmptyState>
        }
        else
        {
            @* **A Villain the GM approved is theirs now, and comes back to its maker as a nemesis**
               — the name and the effect, never the sheet (the owner's rulings of 2026-10-01).
               Drawn above the ordinary rows because it is not one: there is nothing to send and
               no sheet to open. Leave stays, the owner's third answer: ending the membership takes
               the block away and hands nothing back. *@
            @foreach (var one in _playing.Where(m => m.HandedOver))
            {
                <Nemesis Name="@one.Label" Campaign="@one.GivenTo" />
                <div class="campaign-row">
                    <span class="who"><span class="meta">@Standings.Say(one.Standing, one.GivenTo)</span></span>
                    @if (_leaving == one.Id)
                    {
                        <button type="button" class="btn small"
                                @onclick="() => Leave(one.Id)">Leave for good</button>
                        <button type="button" class="btn small quiet"
                                @onclick="() => _leaving = null">Cancel</button>
                    }
                    else
                    {
                        <button type="button" class="btn small quiet"
                                @onclick="() => _leaving = one.Id">Leave</button>
                    }
                </div>
            }

            <ul class="campaign-list">
                @foreach (var one in _playing.Where(m => !m.HandedOver))
                {
                    <li>
                        <div class="campaign-row">
                            <span class="who">
                                <b class="nm">@one.Label</b>
                                <span class="meta">@Standings.Say(one.Standing)</span>

                                @* **The list level said "Approved" over a game holding nothing.**
                                   Opening the row says so and always has; a reader arrives at the
                                   list first, and there the standing named a decision about a
                                   character the campaign is not holding. See `EmptySubmissions`. *@
                                @if (_empty.Contains(one.Id))
                                {
                                    <span class="meta">@EmptySubmissions.Marker</span>
                                }
                            </span>

                            @* Sending is the player's act and it is theirs alone: a snapshot the
                               app sent on every edit would put a character in front of the GM
                               before anybody meant it to be seen. *@
                            @if (one.CharacterId == _openId)
                            {
                                @* While the warning below is up it carries the second press, so
                                   this button steps aside rather than offering to send twice. *@
                                @if (_confirmingHandover != one.Id)
                                {
                                    <button type="button" class="btn small" @onclick="() => Submit(one)">
                                        Send for approval
                                    </button>
                                }
                            }
                            else
                            {
                                <a class="btn small quiet" href="sheet/@one.CharacterId">Sheet</a>
                            }

                            @* **Two presses, because there is no undo and the campaign's copy goes
                               with it.** A campaign's own Delete is one press, but it sits inside a
                               disclosure somebody opened on purpose; this control is in a row
                               beside Send for approval, where a misclick is an ordinary thing. *@
                            @if (_leaving == one.Id)
                            {
                                <button type="button" class="btn small"
                                        @onclick="() => Leave(one.Id)">Leave for good</button>
                                <button type="button" class="btn small quiet"
                                        @onclick="() => _leaving = null">Cancel</button>
                            }
                            else
                            {
                                <button type="button" class="btn small quiet"
                                        @onclick="() => _leaving = one.Id">Leave</button>
                            }
                        </div>

                        @* **What became of a send, under the button that sent it.** It used to be
                           printed in the Join box at the bottom of the panel — a different
                           control, about a different act, with a list between them — so "this
                           character has nothing on it yet" appeared under a box the reader had
                           not touched, and `Submit`'s own doc comment claimed it was under the
                           button. A refusal has to be findable from the control it refuses.

                           **Unlike the sentence about leaving, this one can live in the row**,
                           and the difference is whether the row survives the act: leaving removes
                           the row, so a message inside it would be written and thrown away
                           unrendered — the fault recorded below and on the approval screen —
                           while sending leaves the row exactly where it was.

                           `role="status"` per row rather than one region for the panel, because
                           the message is about this membership and a reader who lands on it by
                           keyboard should meet it where the button is. *@
                        @* **Approval is the one act on this screen nobody can undo, so a Villain asks
                           first** — the owner's ruling: warn, then a second press, the way Leave
                           does. Under the row it is about, for the reason the sentence below is. *@
                        @if (_confirmingHandover == one.Id)
                        {
                            <div class="handover-warning" role="status">
                                <p>
                                    <b>If the GM approves this Villain, it becomes theirs for good.</b>
                                    It leaves your characters, and you will see only its name.
                                    Turned down, it stays yours.
                                </p>
                                <span class="choices">
                                    <button type="button" class="btn small danger"
                                            @onclick="() => Submit(one, handOverConfirmed: true)">Send it anyway</button>
                                    <button type="button" class="btn small quiet"
                                            @onclick="() => _confirmingHandover = null">Keep it</button>
                                </span>
                            </div>
                        }

                        @if (_sentAbout == one.Id && _sent is { } sent)
                        {
                            <p class="small muted spaced" role="status">@sent</p>
                        }
                    </li>
                }
            </ul>
        }

        @* **Outside the list, and outside the join box below it.** A row that has just been left
           is a row that no longer renders, so a sentence about leaving cannot live inside one —
           the fault the approval screen records as finding 7, where every message but one was
           written and thrown away unrendered. *@
        @if (_said is { } said)
        {
            <p class="small muted spaced" role="status">@said</p>
        }

        <div class="campaign-join">
            <p class="others-head">Join a game</p>

            <Field Label="Code" For="join-code">
                <input id="join-code" type="text" maxlength="20"
                       @bind="_code" @bind:event="oninput" />
            </Field>

            @* **Who joins, as a checkbox list rather than a single sentence about the character
               on screen.** Adding several characters to one game used to cost a re-typed code and
               a trip through the character manager for each one after the first; the fix is
               picking who joins here, in one press. The list is
               <c>AccountCharacterStore.ListAsync()</c> — the same index the roster reads — so
               drawing it costs no payload read per row. *@
            @if (JoinCandidates.Count > 0)
            {
                <fieldset class="house-rules">
                    <legend class="others-head">Who joins</legend>

                    @foreach (var row in JoinCandidates)
                    {
                        <label class="house-rule">
                            <input type="checkbox"
                                   checked="@(_toJoin.Contains(row.Id))"
                                   disabled="@AlreadyInAGame(row)"
                                   @onchange="e => ToggleJoin(row.Id, e.Value is true)" />
                            <span>@row.Label</span>

                            @* **"Already in a game", not "already in this game".** A code only
                               says which campaign it names once it has been redeemed —
                               <c>JoinAsync</c> posts and joins in the same call, and there is no
                               address that looks a code up without joining it. So this cannot say
                               whether the game named here is the one the code is for; it says the
                               weaker, honest thing the index already knows. The character on
                               screen is exempt: its own row keeps today's join exactly, which
                               already allows rejoining a game it is in. See
                               <see cref="AlreadyInAGame"/>. *@
                            @if (AlreadyInAGame(row))
                            {
                                <span class="small muted">Already in a game</span>
                            }
                        </label>
                    }
                </fieldset>
            }

            <div class="inline">
                @* **`_joining` as well as the empty-selection check.** A second click landing
                   while the first press is still awaiting its round trips would run `Join` again
                   over the same ticked characters — see `_joining`'s own remarks for the lost
                   update that opens. *@
                <button type="button" class="btn primary"
                        disabled="@(EligibleToJoin.Count == 0 || _joining)"
                        @onclick="Join">@JoinButtonLabel</button>
            </div>

            @* **One line per character, in a single status region.** Joining several at once
               means several outcomes can be true at the same time — one tier disagreement does
               not hide a success beside it — so each gets its own sentence rather than one
               summary trying to cover all of them. *@
            @if (_joinResults.Count > 0)
            {
                <div role="status">
                    @foreach (var (label, message) in _joinResults)
                    {
                        <p class="small muted spaced">@label: @message</p>
                    }
                </div>
            }
        </div>
    </Panel>
}

@code {
    /// <summary>
    /// Whether a campaign can be reached at all — null until the answer arrives.
    ///
    /// <para><b>Three states, not two.</b> "Not signed in" and "not asked yet" are different, and
    /// drawing the refusal while the answer is still coming would tell a signed-in reader to sign
    /// in, on every visit, for as long as the round trip takes.</para>
    /// </summary>
    private bool? _available;

    private IReadOnlyList<SavedCampaignSummary> _running = [];

    /// <summary>
    /// The caller's own memberships, or null when they could not be read.
    ///
    /// <para><b>Null is not an empty list</b>, and collapsing the two would tell somebody their
    /// character is out of a game it is still in.</para>
    /// </summary>
    private IReadOnlyList<MembershipSummary>? _playing = [];

    /// <summary>Every membership of every campaign this account runs, for the waiting counts.</summary>
    private IReadOnlyList<MembershipSummary>? _inbox = [];

    /// <summary>
    /// Which of <see cref="_playing"/> are holding a sheet with nothing on it — see
    /// <see cref="EmptySubmissions"/>, which is also where the cost of knowing is argued.
    ///
    /// <para>Worked out once per refresh rather than per render, for the reason the campaign
    /// resolution is: this page redraws on every change to the character, and a read per row per
    /// keystroke is the read-per-letter the character manager's own split exists to avoid.</para>
    /// </summary>
    private IReadOnlySet<string> _empty = new HashSet<string>(StringComparer.Ordinal);

    /// <summary>Which campaign's settings are open, or null.</summary>
    private string? _open;

    /// <summary>Which membership is one press away from being left, or null.</summary>
    private string? _leaving;

    /// <summary>
    /// Which membership's Villain is one press away from being sent, or null — the warning that an
    /// approved Villain becomes the GM's is on screen under that row.
    /// </summary>
    private string? _confirmingHandover;

    /// <summary>What became of the last leave, or null. Rendered outside the row it was about.</summary>
    private string? _said;

    /// <summary>The campaign being named or renamed, or null when none is.</summary>
    private Campaign? _editing;

    private bool _editingIsNew;
    private string _name = "";
    private string? _tierId;
    private int? _traitCap;

    /// <summary>
    /// The optional rules the campaign being edited has turned on. <b>Never null while a form is
    /// open</b> — a campaign that has adopted nothing is <see cref="CampaignTable.Book"/>, which
    /// is the same game, so there is no third state for the form to represent.
    /// </summary>
    private CampaignTable _table = CampaignTable.Book;

    /// <summary>What this table charges for Immortality, or null for the book's price.</summary>
    private int? _immortality;

    /// <summary>What went wrong with the last save, or null. Cleared at the start of each one.</summary>
    private string? _problem;

    /// <summary>
    /// Whether <see cref="_problem"/> is a stale-format refusal, which is the one save failure a
    /// reload actually fixes — this tab has to fetch the newer bytes it could not see, not merely
    /// try the same write again.
    /// </summary>
    private bool _offerReload;

    /// <summary>
    /// The account's characters, for the checkbox list — the same index the roster reads, with no
    /// payload read behind any row. Refreshed alongside everything else, never per keystroke.
    /// </summary>
    private IReadOnlyList<SavedCharacterSummary> _characters = [];

    /// <summary>
    /// Which characters are ticked to join, by id. Reset to the character on screen alone on every
    /// refresh — see <see cref="Refresh"/> — because a join moves which games those characters are
    /// in, and a stale tick would offer to rejoin a game one of them just joined.
    /// </summary>
    private HashSet<string> _toJoin = new(StringComparer.Ordinal);

    /// <summary>
    /// What became of the last join, one line per character it was about, in the order they were
    /// joined. Cleared at the start of the next press.
    ///
    /// <para><b>A list of pairs rather than one sentence, and the label travels with its own
    /// message rather than being looked up afterwards.</b> Joining several characters at once
    /// means several outcomes can be true together — a tier disagreement for one character must
    /// not swallow a success for another — and a row can vanish from <see cref="JoinCandidates"/>
    /// in the course of the very press that reports on it: the account-cap race
    /// <see cref="JoinOther"/> exists to report is exactly a character ceasing to be listed. A
    /// message keyed on an id that is no longer in the list it is drawn from would be a message
    /// nothing prints.</para>
    /// </summary>
    private List<(string Label, string Message)> _joinResults = [];

    /// <summary>
    /// Whether a press of Join is still running its round trips.
    ///
    /// <para><b>The guard against a second press landing while the first is still in flight.</b>
    /// A double-click, or a second tab pressing the same button, would otherwise run
    /// <see cref="Join"/> again over the same ticked characters while the first call is still
    /// awaiting its network round trips. The on-screen character is covered already —
    /// <see cref="Autosave"/>'s own remarks record the lost update two overlapping writes caused
    /// before it serialised them — but <see cref="JoinOther"/>'s read, apply, write-back has
    /// nothing on the wire saying which read a write follows, so two overlapping presses would
    /// read-modify-write the same character and the later write would silently lose whatever the
    /// earlier one did. Set before the first <c>await</c> in <see cref="Join"/> and cleared in a
    /// <c>finally</c>, so a call that somehow throws still clears it rather than wedging the
    /// button shut.</para>
    /// </summary>
    private bool _joining;

    /// <summary>
    /// What became of the last send, and which row it was about — drawn inside that row, under
    /// the button that did it.
    ///
    /// <para><b>Two fields rather than one, because a message with no row is a message under the
    /// wrong row.</b> Both are set together and cleared together at the start of every send.</para>
    /// </summary>
    private string? _sent;

    private string? _sentAbout;

    private string _code = "";

    /// <summary>Which character is on screen — the one a join or a send is about.</summary>
    private string? _openId;

    /// <summary>
    /// The campaign the character on screen names, resolved. Null both for a character in no
    /// campaign and for one naming a campaign this account cannot see — the second of those is a
    /// finding rather than a blank, which is <see cref="CampaignJoin.Inspect"/>'s to tell apart.
    /// </summary>
    private Campaign? _campaign;

    /// <summary>
    /// The campaign the character on screen is in, <b>as the table has it now</b>, or null.
    ///
    /// <para><b>Read for a member and never for a GM.</b> <see cref="_campaign"/> is what
    /// <c>AccountCampaignStore</c> resolved, which is a campaign this account owns; this is the
    /// same game read through the reader's own membership row, and it is asked for only where the
    /// first answered nothing. A GM therefore costs no extra request and sees no second list —
    /// their screen is the one that has always been able to read the campaign.</para>
    ///
    /// <para><b>Null covers four things and they are one thing to this screen</b>: no membership
    /// of that campaign, a game the GM has deleted, a payload this build cannot read, and a server
    /// that could not be reached. Each means there is no live table to put beside the copy, and
    /// the panel then draws exactly what it drew before this existed.</para>
    /// </summary>
    private Campaign? _live;

    /// <summary>
    /// When <see cref="_live"/> was read, as Unix milliseconds, or 0 for never.
    ///
    /// <para><b>The heading over that list says "now" and this is what makes the word honest.</b>
    /// The read happens when the panel opens and after anything that reloads the lists; a GM
    /// changing a setting while somebody has the page open moves nothing until the next one. So
    /// the panel prints how old the answer is, in the same words a character's row prints its own
    /// age in, and offers the one request that refreshes it.</para>
    /// </summary>
    private long _liveReadAt;

    /// <summary>
    /// Whether a live table this reader had already been shown has since answered nothing.
    ///
    /// <para><b>Only ever set by <see cref="RecheckTable"/>, and that is the whole of it.</b> A
    /// first render that reads nothing draws the copy alone, which is what the panel drew before
    /// any of this existed and needs no sentence. A list that was on screen and is now gone
    /// because the reader pressed a button does.</para>
    /// </summary>
    private bool _liveWentAway;

    /// <summary>
    /// The campaign id <see cref="_campaign"/> was resolved from, and whether anything has been
    /// resolved at all.
    ///
    /// <para><b>The store is asked once per campaign id, and the finding is read every render.</b>
    /// Resolving is a round trip and this page redraws on every change to the character, so
    /// re-reading it per keystroke is the read-per-letter the character manager's own split exists
    /// to avoid — the same bargain <c>ChooseTier</c> makes. But a tier and a Trait Cap move
    /// without the id moving, and the finding is about those, so it is computed from the live
    /// sheet on each pass rather than cached beside the campaign.</para>
    /// </summary>
    private string? _resolvedFrom;

    private bool _resolved;

    /// <summary>
    /// What is worth saying about the character on screen and the campaign it names, or null.
    ///
    /// <para>Nothing while a resolution is in flight or stale: a finding computed against the
    /// previous character's campaign would say something true about a character nobody is looking
    /// at.</para>
    /// </summary>
    private CampaignFinding? Finding =>
        _resolved && string.Equals(_resolvedFrom, Session.Sheet.CampaignId, StringComparison.Ordinal)
            ? WorthSaying(CampaignJoin.Inspect(Session.Sheet, _campaign ?? _live))
            : null;

    // **The live table stands in where the account's own read answered nothing, and that is what
    // makes five of the six findings reachable by a member at all.** Every mismatch is computed
    // from a campaign that resolved, and a player's browser resolves none — so a character built
    // to the wrong tier for the game it is in, or costed at the book's price by a table that
    // charges 12, was told on no screen. `Inspect` is unchanged in what it compares; what changed
    // is that it is now handed something to compare against.

    /// <summary>
    /// The finding, unless it is one this reader is the wrong person to be told.
    ///
    /// <para><b><c>UNKNOWN_CAMPAIGN</c> is true of the store and false of the world for every
    /// player in every game.</b> <see cref="CampaignJoin.Inspect"/> is handed the campaign a store
    /// resolved, and a campaign's payload is scoped to the account that owns it — so a player's
    /// browser resolves null for a game that is perfectly alive, and the sentence a GM needs
    /// ("the campaign may have been deleted") was being printed to every member who had just
    /// successfully joined one, directly above the panel listing that campaign's own house rules.
    /// The finding is right about what it was told; the page is the half that knows better.</para>
    ///
    /// <para><b>A membership row is the evidence, and it is evidence the finding cannot have.</b>
    /// <c>Memberships.MineAsync</c> answers the games this reader is in, by campaign id, from the
    /// one read on the server that is scoped to the player rather than the owner. A row for the
    /// campaign the character names says the game is there and this account simply may not read
    /// its payload — and the game is listed by name in this very panel, a few lines down, which is
    /// the reassurance the suppressed sentence was contradicting.</para>
    ///
    /// <para><b>Nothing else is suppressed, and no other finding could be.</b> The other five are
    /// computed from a campaign that <em>did</em> resolve, so a reader seeing one is a reader whose
    /// account owns the game. Suppressing on a <em>missing</em> membership list is deliberately not
    /// done either: <c>MineAsync</c> answering null is a read that failed, and a failed read is not
    /// grounds for hiding a report — the same rule the standing follows one screen over.</para>
    /// </summary>
    private CampaignFinding? WorthSaying(CampaignFinding? finding) =>
        finding is { Code: CampaignJoin.UnknownCampaign }
        && _playing is { } playing
        && playing.Any(m => string.Equals(m.CampaignId, Session.Sheet.CampaignId, StringComparison.Ordinal))
            ? null
            : finding;

    /// <summary>
    /// The two figures a finding carries as fields, in the app's own words, or nothing.
    ///
    /// <para><b>A finding carries them rather than writing them into its sentence</b>, because an
    /// id is not what a tier is called and the message has to stay true without them. Looking them
    /// up and saying them is the screen's half of that bargain — and a disagreement stated without
    /// the two numbers leaves a reader with nothing to act on.</para>
    ///
    /// <para><b>Every pair a finding can carry has an arm here, and that is the whole obligation of
    /// this method.</b> <c>CampaignFinding</c>'s own remarks promise a screen renders the figures,
    /// so a pair with no arm is not a shorter message — it is a promise this file silently broke.
    /// <c>CAMPAIGN_IMMORTALITY_COST_MISMATCH</c> and <c>IMMORTALITY_COST_WITHOUT_CAMPAIGN</c> both
    /// shipped carrying a price that fell through to <c>_ => ""</c>, so a reader was told their
    /// character is charged "a different price for Immortality" with neither number anywhere on
    /// screen. <c>CampaignFindingFiguresTests</c> is the guard, and it reads the record's own
    /// properties rather than a list typed out beside them.</para>
    /// </summary>
    private string Ranks(CampaignFinding finding) => finding switch
    {
        { CharacterTierId: { } mine, CampaignTierId: { } theirs } =>
            $"Built to {TierName(mine)}; the game is played at {TierName(theirs)}.",

        { CharacterTraitCapRank: { } ours, CampaignTraitCapRank: { } theirs } =>
            $"Built to a Trait Cap of {ours}d; the game caps at {theirs}d.",

        { CharacterImmortalityCost: { } ours, CampaignImmortalityCost: { } theirs } =>
            $"Charged {ours} HP for {ImmortalityName}; the game charges {theirs} HP.",

        // The orphaned price is one figure rather than a pair, because there is no game to name a
        // second one — and it is still said, for the reason the pairs are: "a house price" is not
        // something a reader can go and put back without being told what it is.
        { CharacterImmortalityCost: { } orphaned } =>
            $"Charged {orphaned} HP for {ImmortalityName}.",

        // **The table's own figures, with no character figure beside them**, which is the shape
        // `CAMPAIGN_HOUSE_RULES_NOT_COPIED` carries: the game has decided something and the
        // character carries nothing, so there is one number per setting and both are the table's.
        // Said for the reason the pairs are — "measured by the book" is not something a reader can
        // act on without knowing what the table would use instead.
        //
        // **The pair arm comes first**, because a `switch` takes the arm that matches and a game
        // that set both a cap and a price would otherwise print only the price. That is the same
        // silent half-answer this whole method exists to stop.
        { CampaignTraitCapRank: { } capped, CampaignImmortalityCost: { } charged } =>
            $"The game caps at {capped}d and charges {charged} HP for {ImmortalityName}.",

        { CampaignTraitCapRank: { } capped } => $"The game caps at {capped}d.",

        { CampaignImmortalityCost: { } charged } =>
            $"The game charges {charged} HP for {ImmortalityName}.",

        _ => "",
    };

    private string TierName(string id) => Session.Rules.GetTier(id)?.Name ?? id;

    /// <summary>
    /// What is wrong with the cap in the form, or null when nothing is.
    ///
    /// <para><b>A house cap tightens a tier's ceiling and never loosens it</b>, and the box takes
    /// any whole number from 1 to 30 whatever tier is chosen beside it. So a GM could set 20d over
    /// the Standard tier's 12d and be told nothing, under a hint that said "Tighter than the
    /// tier's" — and every character joining with no cap of its own would inherit an error the
    /// engine reports as <c>TRAIT_CAP_ABOVE_TIER</c> on a screen the GM never opens.</para>
    ///
    /// <para><b>Reported rather than refused, and that is a decision.</b> This is a form checking
    /// its own input against a tier the same form chose, which is one of the few places refusing
    /// would be defensible — but a GM may type the cap before picking the tier, and a Save that
    /// silently does nothing is a control that looks broken. Reporting is also the answer the
    /// engine gives the same mistake one level down, so the two cannot disagree about what a bad
    /// cap means.</para>
    ///
    /// <para>Nothing is said for a campaign that names no tier: a GM who has not set a power level
    /// has nothing to be above.</para>
    /// </summary>
    private string? LooseCap
    {
        get
        {
            if (_traitCap is not { } cap || _tierId is null) return null;
            if (Session.Rules.GetTier(_tierId) is not { } tier) return null;

            return cap <= tier.TraitCapRank
                ? null
                : $"That is above the {tier.Name} tier's {tier.TraitCapRank}d. A house cap "
                  + "tightens a tier's ceiling and never loosens it.";
        }
    }

    /// <summary>
    /// The optional rules a GM can adopt, in the book's order, with the name and page each is
    /// printed under.
    ///
    /// <para><b>Named here rather than in the markup</b>, because <c>WebPresentationTests</c> bars
    /// a page from printing a type this project declares — a reader is owed the rulebook's words
    /// and never a C# identifier, and a page that names one has almost always leaked something
    /// else beside it.</para>
    /// </summary>
    private static IReadOnlyList<(string Key, string Name, string Page)> OptionalRules =>
        HouseRuleFormatter.All;

    /// <summary>Whether the form's draft has this rule turned on.</summary>
    private bool IsAdopted(string key) => HouseRuleFormatter.IsOn(_table, key);

    /// <summary>The Power's printed name, so the field is labelled the way the book names it.</summary>
    private string ImmortalityName => Session.Rules.GetPower("immortality")?.Name ?? "Immortality";

    /// <summary>
    /// What the entry says a table may charge, read off the entry.
    ///
    /// <para><b>The figures are the data's and not this component's.</b> A range typed into a hint
    /// would be a fourth copy of a sentence the rulebook prints once, and the one nothing checks
    /// — the other three are the prose, the structured pair beside it, and the validator's own
    /// message, all held together by <c>PowerDataTests</c>.</para>
    /// </summary>
    private string ImmortalityHint =>
        Session.Rules.GetPower("immortality") is { CampaignCostMin: { } min, CampaignCostMax: { } max, CostFlat: { } book }
            ? $"The book charges {book} HP. In a game where Heroes can die, it says to charge "
              + $"between {min} and {max}. Leave it empty for the book's price."
            : "Leave it empty for the book's price.";

    /// <summary>
    /// What is wrong with the price typed in, or null. <b>Said, and not refused</b> — the same
    /// choice <see cref="LooseCap"/> makes, so a GM who types a figure before reading the range
    /// is told rather than silently ignored, and the engine reports the same mistake one level
    /// down under <c>IMMORTALITY_COST_OUTSIDE_RANGE</c>.
    /// </summary>
    private string? LoosePrice
    {
        get
        {
            if (_immortality is not { } price) return null;
            if (Session.Rules.GetPower("immortality")
                is not { CampaignCostMin: { } min, CampaignCostMax: { } max }) return null;

            return price >= min && price <= max
                ? null
                : $"The rulebook puts a table's price between {min} and {max}. Every character "
                  + "here with the Power will be charged what you type, and told it is outside "
                  + "the range.";
        }
    }

    /// <summary>
    /// The house rules in force for the character on screen, as lines to print, or empty when
    /// there is nothing to say.
    ///
    /// <para><b>Read off the character, not off the campaign, and the reason is the server.</b> A
    /// campaign's payload is scoped to the account that owns it — a player cannot fetch the game
    /// they are in, which is why <c>CampaignJoin.Inspect</c> answers <c>UNKNOWN_CAMPAIGN</c> to a
    /// member — so the campaign's own copy is not something this panel could draw for the person
    /// who most needs it. The character's copy is the answer anyway: it was written on joining, it
    /// is what the engine prices from, and it is what travels to a fight.</para>
    ///
    /// <para><b>Only for a character that is in a game.</b> A sheet still carrying a table's rules
    /// while naming no campaign is a finding rather than a list to print, and <c>Finding</c> above
    /// says so.</para>
    ///
    /// <para><b>Empty for a character playing the book</b>, because a list of thirteen "no"s is
    /// true of every game and tells a reader less than its absence does.</para>
    /// </summary>
    private IReadOnlyList<string> HouseRules
    {
        get
        {
            var sheet = Session.Sheet;
            var lines = new List<string>();

            if (sheet.CampaignId is null) return lines;

            if (sheet.TraitCapRank is { } cap) lines.Add($"Trait Cap {cap}d");

            if (sheet.ImmortalityCost is { } price)
                lines.Add($"{ImmortalityName} costs {price} HP");

            if (sheet.CampaignTable is { IsTheBook: false } table)
            {
                lines.AddRange(HouseRuleFormatter.On(table));

                if (table is { RaisedGearLimit: true, GearLimitRank: { } rank })
                    lines.Add($"Gear Limit {rank}d");
            }

            return lines;
        }
    }

    /// <summary>
    /// The house rules the table has <em>now</em>, as lines to print, or empty for a table playing
    /// the book.
    ///
    /// <para><b>The same lines in the same order as the character's own list above</b>, so the two
    /// can be read down the page against each other. That is why this is spelled here beside
    /// <see cref="HouseRules"/> rather than being a second shape: a live list ordering its
    /// switches differently from the copy is a list somebody has to re-scan to compare, which is
    /// the whole thing the pair exists for.</para>
    /// </summary>
    private IReadOnlyList<string> LiveHouseRules
    {
        get
        {
            var lines = new List<string>();

            // **Named `campaign`, and that is load-bearing rather than taste.**
            // `TraitCapReadTests` treats every receiver but `sheet` and `campaign` as a tier, so a
            // house cap read off a local called anything else is a tier read this file would have
            // to be sanctioned for — and the sanction is what would then permit a real one.
            if (_live is not { } campaign) return lines;

            if (campaign.TraitCapRank is { } cap) lines.Add($"Trait Cap {cap}d");

            if (campaign.ImmortalityCost is { } price)
                lines.Add($"{ImmortalityName} costs {price} HP");

            if (campaign.Table is { IsTheBook: false } table)
            {
                lines.AddRange(HouseRuleFormatter.On(table));

                if (table is { RaisedGearLimit: true, GearLimitRank: { } rank })
                    lines.Add($"Gear Limit {rank}d");
            }

            return lines;
        }
    }

    /// <summary>
    /// What the table has decided since this character took its copy, one row per setting.
    ///
    /// <para><b>Computed by <see cref="CampaignDiff.BetweenTables"/> and not here</b>, so a member
    /// and the GM deciding about their submission read the same thirteen names in the same
    /// <c>off → on</c> idiom. Empty where the two agree, which is the ordinary case and draws
    /// nothing.</para>
    /// </summary>
    private IReadOnlyList<DiffRow> TableChanges =>
        _live is { } live ? CampaignDiff.BetweenTables(Session.Rules, Session.Sheet, live) : [];

    /// <summary>
    /// How old the live table on screen is, in the words a character's row uses.
    ///
    /// <para><b><see cref="Ages"/> rather than a second scale</b>, so "3 minutes ago" means the
    /// same thing on this panel as it does in the character manager. It answers null only for a
    /// timestamp of zero or one in the future, neither of which can reach here — the list is drawn
    /// only where <c>_live</c> is set and the stamp is written in the same statement — so the
    /// fallback is the phrase that would be true anyway rather than an empty sentence.</para>
    /// </summary>
    private string LiveAge =>
        Ages.Since(_liveReadAt, DateTimeOffset.UtcNow) ?? "just now";

    /// <summary>
    /// Read the live table again, and nothing else.
    ///
    /// <para><b>One request rather than <c>Refresh</c>.</b> What the reader asked for is whether
    /// the table has moved; re-reading their campaigns, their standings, the inbox and the current
    /// character to answer it would be four round trips for one question, and it would redraw
    /// panels they were not looking at.</para>
    ///
    /// <para><b>A null answer is kept as a null and said out loud.</b> `TableAsync` returns one for
    /// a game the GM has deleted, a membership that is not the reader's, a payload this build
    /// cannot read and a server that is not there — and the panel then falls back to the copy
    /// alone, which without a sentence reads as a list that quietly disappeared under a button
    /// press.</para>
    /// </summary>
    private async Task RecheckTable()
    {
        var read = await CampaignReaches.LiveAsync(Memberships, Session.Sheet, _playing);

        _liveWentAway = read is null;
        _live = read;

        if (read is not null) _liveReadAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    }

    /// <summary>
    /// One row's movement, in the words the approval screen uses.
    ///
    /// <para><b>Copied in shape from <c>CampaignApproval</c>'s own <c>Was</c> and deliberately not
    /// shared with it.</b> That one is a method on a page and this is four lines; what has to
    /// agree between the two screens is the row — its name and its two values — and that is
    /// <see cref="CampaignDiff"/>'s, computed once.</para>
    /// </summary>
    private string RunAside => $"{_running.Count} to run";

    private string InAside => _playing is { } playing ? $"{playing.Count} joined" : "Not read";

    /// <summary>
    /// What a campaign row says about itself: its tier, and how many characters are waiting.
    ///
    /// <para>The tier's <em>name</em>, never its id — an id is not what a tier is called, which is
    /// the rule every finding in this application already follows.</para>
    /// </summary>
    private string RunningDetail(SavedCampaignSummary row)
    {
        var members = _inbox?.Where(m => m.CampaignId == row.Id).ToList() ?? [];

        return members.Count == 0 ? "Nobody has joined yet" : $"{members.Count} in the game";
    }

    /// <summary>
    /// The label on the way into the approval screen, carrying the waiting count.
    ///
    /// <para><b>The count is the whole of the notification.</b> There is no badge elsewhere and no
    /// mail: a number on the page somebody opens to run their game is where it is looked for, and
    /// anything more is a second thing to keep in step with this one.</para>
    /// </summary>
    private string ApprovalsLabel(string campaignId)
    {
        var waiting = _inbox?.Count(m => m.CampaignId == campaignId && m.HasPending) ?? 0;

        return waiting == 0 ? "Approvals" : $"Approvals ({waiting})";
    }

    protected override async Task OnInitializedAsync()
    {
        Accounts.Changed += Reload;
        Session.Changed += Redraw;

        await Refresh();

        ReadCodeFromAddress();
    }

    /// <summary>
    /// The link a GM sends instead of reading ten characters down a phone.
    ///
    /// <para><b>Absolute, from <see cref="NavigationManager.BaseUri"/> rather than a constant</b> —
    /// the same string has to work pasted into a chat window from a laptop that is on
    /// localhost:5000 and from the deployed site, and a hard-coded host is wrong in one of those
    /// two places forever.</para>
    ///
    /// <para><b>The normalised code, without its hyphen.</b> The hyphen exists so ten symbols can
    /// be read aloud without being misheard; nobody reads a URL aloud, and the server takes the
    /// punctuation out on the way in either way.</para>
    /// </summary>
    private string JoinLink(SavedCampaignSummary row) =>
        $"{Nav.BaseUri.TrimEnd('/')}/campaign?join={row.JoinCode}";

    /// <summary>
    /// The rows the checkbox list draws: the account's characters, plus the one on screen when it
    /// is not among them yet.
    ///
    /// <para><b>The synthetic row is why this is a property and not <see cref="_characters"/>
    /// itself.</b> A character built from a fresh, unsaved slot — or one whose autosave has not
    /// landed — has no row in the account's own index yet, and the character a join or a send is
    /// about is always the one on screen whether or not it has been written down. Naming it here
    /// rather than leaving it off the list is the same choice <c>WhoJoins</c> made before this
    /// list existed: saying which character it is, rather than a reader hunting for a checkbox
    /// that is not there.</para>
    ///
    /// <para>Put first rather than wherever the account's own ordering would put it, because it is
    /// the row a reader is already looking at.</para>
    /// </summary>
    private IReadOnlyList<SavedCharacterSummary> JoinCandidates =>
        _openId is { Length: > 0 } open && _characters.All(c => c.Id != open)
            ? [new SavedCharacterSummary(open, SavedCharacters.LabelFor(Session.Sheet), 0, Session.Sheet.CampaignId), .. _characters]
            : _characters;

    /// <summary>
    /// Which ticked characters a press of Join would actually put into the game, in the order they
    /// would be joined: the character on screen first, then every other ticked row.
    ///
    /// <para><b>The on-screen character is never excluded here</b>, whatever its own
    /// <see cref="SavedCharacterSummary.CampaignId"/> says — its row keeps today's join exactly,
    /// which has always allowed rejoining a game it is already in.</para>
    ///
    /// <para><b>Every other row's eligibility is <see cref="AlreadyInAGame"/>'s alone, read off
    /// <see cref="_characters"/> once here rather than re-asked.</b> There is no path by which a
    /// row ticked while eligible can turn ineligible before this is read: <see cref="_characters"/>
    /// only ever changes inside <see cref="Refresh"/>, and that same method resets
    /// <see cref="_toJoin"/> to the character on screen alone in the same pass — so the two are
    /// never out of step with each other. A second, independent check here would be exactly the
    /// kind of defence a mutation cannot tell from its own absence, which this file's own rule
    /// about such checks does not allow keeping.</para>
    /// </summary>
    private IReadOnlyList<string> EligibleToJoin
    {
        get
        {
            var ids = new List<string>();

            if (_openId is { Length: > 0 } open && _toJoin.Contains(open)) ids.Add(open);

            foreach (var row in _characters)
            {
                if (row.Id != _openId && _toJoin.Contains(row.Id)) ids.Add(row.Id);
            }

            return ids;
        }
    }

    /// <summary>
    /// What the Join button says: how many characters a press would actually join, singular and
    /// plural said correctly. Plain "Join" only while nothing is ticked, which is also when the
    /// button is disabled — there being nobody to name is the one case with nothing to count.
    /// </summary>
    private string JoinButtonLabel => EligibleToJoin.Count switch
    {
        0 => "Join",
        1 => "Join with 1 character",
        var n => $"Join with {n} characters",
    };

    /// <summary>Tick or untick a character to join. Ignored for a row the list has disabled.</summary>
    private void ToggleJoin(string id, bool on)
    {
        if (on) _toJoin.Add(id); else _toJoin.Remove(id);
    }

    /// <summary>
    /// Whether a row's checkbox should be disabled: it names a game already and it is not the
    /// character on screen. <see cref="EligibleToJoin"/> trusts this rather than re-asking it —
    /// see that property's own remarks for why that is safe rather than merely convenient.
    /// </summary>
    private bool AlreadyInAGame(SavedCharacterSummary row) =>
        row.Id != _openId && row.CampaignId is not null;

    /// <summary>
    /// Take a code out of <c>?join=</c>, fill the box with it, and then take it out of the address
    /// bar.
    ///
    /// <para><b>The removal is the point, not tidiness.</b> A join code is a shared secret the GM
    /// minted, and one left in the address bar goes into browser history, into a screenshot of the
    /// window, and into whatever the reader pastes next. Filling the box keeps the one thing the
    /// link was for; a <c>replace</c> navigation drops the query without adding a history entry to
    /// go back to.</para>
    ///
    /// <para><b>It does not join anything by itself.</b> Joining writes to a character, and a link
    /// that changed somebody's character the instant it opened would be a link that could be sent
    /// to them by anybody.</para>
    /// </summary>
    private void ReadCodeFromAddress()
    {
        var code = CodeIn(Nav.ToAbsoluteUri(Nav.Uri).Query);

        if (code is null) return;

        _code = code;
        Nav.NavigateTo("campaign", replace: true);
    }

    /// <summary>The <c>join</c> parameter of a query string, or null. Nothing here throws.</summary>
    private static string? CodeIn(string query) =>
        query.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(pair => pair.Split('=', 2))
            .Where(parts => parts.Length == 2
                && string.Equals(parts[0], "join", StringComparison.Ordinal)
                && parts[1].Length > 0)
            .Select(parts => Uri.UnescapeDataString(parts[1]))
            .FirstOrDefault();

    /// <summary>
    /// The join and send controls read which character is on screen, so a change to the character
    /// has to redraw. The lists are not re-read here — that would be a round trip per keystroke on
    /// the finishing step, which is the split the character manager already makes.
    /// </summary>
    private void Redraw()
    {
        // The campaign is re-read only when the character on screen names a different one —
        // switching character, joining, leaving. Everything else is a redraw, and the finding
        // above recomputes from the sheet as it stands.
        if (_available is true && !string.Equals(_resolvedFrom, Session.Sheet.CampaignId, StringComparison.Ordinal))
        {
            _ = InvokeAsync(async () =>
            {
                await ResolveCampaign();
                StateHasChanged();
            });

            return;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Turn the character's campaign id into a campaign, both ways round, and remember which id it
    /// was. See <see cref="_resolvedFrom"/> for why that is kept.
    ///
    /// <para><b>The two reads and their ordering are <c>CampaignReaches</c>'</b>, since the
    /// Vehicles and bases step needs the identical answer to offer this game's shared objects — the
    /// live read is asked only where the account's own answered nothing, which is a member rather
    /// than a GM, and a second copy of that ordering would be a second chance to ask the wrong
    /// address first. What stays here is what is local to this screen: when the answer was read,
    /// and whether a recheck has since taken a list away.</para>
    /// </summary>
    private async Task ResolveCampaign()
    {
        var reach = await CampaignReaches.ForAsync(Store, Memberships, Session.Sheet, _playing);

        _campaign = reach.Owned;
        _live = reach.Live;

        // Stamped in the same statement the read is assigned in, so the age on screen can never be
        // a stamp from a different answer. Cleared with it: a resolve is a fresh start, and the
        // "could not be read" sentence is only ever about a button somebody pressed.
        _liveReadAt = _live is null ? 0 : DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        _liveWentAway = false;

        _resolvedFrom = Session.Sheet.CampaignId;
        _resolved = true;
    }

    private void Reload() => _ = InvokeAsync(async () =>
    {
        await Refresh();
        StateHasChanged();
    });

    private async Task Refresh()
    {
        _available = await Store.IsAvailableAsync();

        if (_available is not true)
        {
            _running = [];
            _playing = [];
            _inbox = [];
            _characters = [];
            _toJoin = new HashSet<string>(StringComparer.Ordinal);

            // Nothing resolves for somebody not signed in, and saying "that campaign is not here"
            // to them would be true of the moment rather than of their character. The panels are
            // not drawn in that state anyway; this keeps the field from outliving the account.
            _campaign = null;
            _live = null;
            _liveReadAt = 0;
            _liveWentAway = false;
            _resolvedFrom = null;
            _resolved = false;
            _empty = new HashSet<string>(StringComparer.Ordinal);
            return;
        }

        // **Four independent reads, asked at once rather than one after another.** None of the
        // four needs another's answer — the games this account runs, its own memberships, the
        // inbox behind them, and the account's own characters for the checkbox list below — so
        // awaiting them in series cost four round trips end to end where one wait does. The
        // current-character pointer joins them for the same reason: nothing else here needs it
        // first.
        var runningTask = Store.ListAsync();
        var playingTask = Memberships.MineAsync();
        var inboxTask = Memberships.InboxAsync();
        var charactersTask = Characters.ListAsync();
        var openIdTask = Characters.CurrentIdAsync();

        await Task.WhenAll(runningTask, playingTask, inboxTask, charactersTask, openIdTask);

        _running = await runningTask;
        _playing = await playingTask;
        _inbox = await inboxTask;
        _characters = (await charactersTask).Characters;
        _openId = await openIdTask;

        // **Reset to the character on screen alone, on every refresh.** A join is what moves which
        // games a character is in, and this page reloads right after one — so carrying a tick
        // forward would offer, on the very next render, to rejoin a game a character was just put
        // into (now shown disabled, but still a stale intention nobody stated this time).
        _toJoin = _openId is { Length: > 0 } open
            ? new HashSet<string>(StringComparer.Ordinal) { open }
            : new HashSet<string>(StringComparer.Ordinal);

        _empty = await EmptySubmissions.AmongAsync(Memberships, Session, _playing);

        await ResolveCampaign();
    }

    private void Toggle(string id) => _open = _open == id ? null : id;

    private void StartNew()
    {
        _editing = new Campaign(StoredCampaign.NewId(), "", null, null, false);
        _editingIsNew = true;
        _name = "";
        _tierId = null;
        _traitCap = null;
        _table = CampaignTable.Book;
        _immortality = null;
        _problem = null;
    }

    private void Edit(SavedCampaignSummary row) => _ = InvokeAsync(async () =>
    {
        var campaign = await Store.LoadAsync(row.Id);

        if (campaign is null)
        {
            _problem = "That campaign could not be read just now. Try again in a moment.";
            StateHasChanged();
            return;
        }

        _editing = campaign;
        _editingIsNew = false;
        _name = campaign.Name;
        _tierId = campaign.TierId;
        _traitCap = campaign.TraitCapRank;

        // A campaign written before any of this existed carries no block, and the book is what it
        // was playing — so the form opens on the same answer rather than on an empty third state.
        _table = campaign.Table ?? CampaignTable.Book;
        _immortality = campaign.ImmortalityCost;
        _problem = null;

        StateHasChanged();
    });

    /// <summary>
    /// Turn one optional rule on or off in the form's draft.
    ///
    /// <para><b>Turning the Gear Limit off drops the rank with it.</b> A figure kept behind an
    /// unadopted switch is a setting the next reader has to guess about — it does not print on the
    /// sheet and it does not apply in a fight, so keeping it would only mean a GM turning the
    /// switch back on and silently getting a number they had forgotten typing.</para>
    /// </summary>
    private void SetRule(string key, bool on)
    {
        _table = HouseRuleFormatter.With(_table, key, on);

        if (key == nameof(CampaignTable.RaisedGearLimit) && !on)
            _table = _table with { GearLimitRank = null };
    }

    private void SetGearLimit(int? rank) => _table = _table with { GearLimitRank = rank };

    /// <summary>
    /// Write the campaign down, and say so when it went nowhere.
    ///
    /// <para><b>A refused save has to be said out loud</b>, because a form that clears itself and
    /// does nothing is indistinguishable from a control that is not wired up — the rule the
    /// character manager's own refusals follow.</para>
    ///
    /// <para><b>A stale-format refusal shows the server's own sentence, verbatim.</b> This build
    /// cannot know what a later one added to the payload, so it cannot write the explanation
    /// itself — only the server, on the far side of the wire, knows both formats being compared.
    /// See <c>ApiCampaignStore.SaveAsync</c>.</para>
    /// </summary>
    private async Task Save()
    {
        if (_editing is not { } editing) return;

        _problem = null;
        _offerReload = false;

        // **The book is stored as null**, so a campaign whose GM opened this form and turned
        // nothing on is byte-identical to one written before the form existed. They are the same
        // game, and a stored block of thirteen falses would be a difference `CampaignDiff` and
        // `Inspect` would then have to be careful not to report.
        var outcome = await Store.SaveAsync(editing with
        {
            Name = _name,
            TierId = _tierId,
            TraitCapRank = _traitCap,
            Table = _table.IsTheBook ? null : _table,
            ImmortalityCost = _immortality
        });

        if (!outcome.Saved)
        {
            _problem = outcome.Message ?? "That could not be saved just now. Try again in a moment.";
            _offerReload = outcome.Message is not null;
            return;
        }

        _editing = null;
        await Refresh();
    }

    /// <summary>
    /// Replace the join code. Nobody already in the campaign is evicted — a code is redeemed once,
    /// into a membership that does not refer back to it.
    /// </summary>
    private async Task NewCode(string id)
    {
        _problem = await Memberships.NewCodeAsync(id) is null
            ? "A new code could not be made just now. Try again in a moment."
            : null;

        await Refresh();
    }

    /// <summary>
    /// Throws a campaign away. Its members keep naming it and are reported as naming a campaign
    /// that is not here — no cascade, no nulled field, so restoring it is a complete undo.
    /// </summary>
    private async Task Delete(string id)
    {
        await Store.DeleteAsync(id);
        _open = null;

        await Refresh();
    }

    /// <summary>
    /// Walk out of a game. This row goes, and the campaign's copy of the character goes with it.
    ///
    /// <para><b>The player's own character is untouched</b>, and it is not this app's to touch: a
    /// membership ending is a fact about a campaign's roster, not about somebody's own work.</para>
    /// </summary>
    private async Task Leave(string membershipId)
    {
        _leaving = null;

        // **`GameIsGone` is deliberately not a case here, and that is a fact about the server
        // rather than a gap.** `leaveCampaign` is a bare `player_user_id = ?` with no `EXISTS` on
        // the campaign, precisely so a player can walk out of a game the GM has thrown away — so
        // the 409 that value models is one only a GM's removal can be answered.
        _said = await Memberships.LeaveAsync(membershipId) == LeftOutcome.Done
            ? "You have left that game. It no longer holds a copy of that character."
            : "That could not be done just now. Try again in a moment.";

        await Refresh();
    }

    /// <summary>
    /// Put every ticked, eligible character into the campaign the code names, one at a time.
    ///
    /// <para><b>The code stays in the box.</b> Several characters share the one code that was
    /// typed in, and clearing it between them — the single-character join's own habit — would
    /// undo the whole point of ticking more than one.</para>
    ///
    /// <para><b>Each character's own outcome decides what is written for it, and a disagreement
    /// writes nothing for that character alone.</b> <see cref="CampaignJoin.Apply"/> inherits into
    /// an empty tier and reports a mismatch otherwise — reported as information rather than as an
    /// error, because a campaign that climbs tiers in play makes this ordinary traffic, and one
    /// character's mismatch must not stop the others in the same press.</para>
    /// </summary>
    private async Task Join()
    {
        // **Re-entrancy, not merely emptiness.** A double-click, or a second tab pressing the
        // same button, reaches this method again while the first press is still awaiting its
        // round trips — the button's own `disabled` binding only runs between presses, never
        // during one. Set before anything else, including before `EligibleToJoin` is read, so the
        // second call is a cheap no-op rather than a second pass over the same characters. See
        // `_joining`'s own remarks for the lost update this stops.
        if (_joining) return;
        _joining = true;

        try
        {
            var ids = EligibleToJoin;
            if (ids.Count == 0) return;

            // The label each row is showing right now, read off before anything runs. `JoinOther`
            // reads the stored sheet's own name for the label it actually sends the server — this
            // is only for the line printed back to the reader, and it has to be the name they
            // ticked rather than one <see cref="Refresh"/> might answer differently by the time
            // this method returns.
            var labels = JoinCandidates.ToDictionary(row => row.Id, row => row.Label, StringComparer.Ordinal);

            var results = new List<(string Label, string Message)>();

            // One at a time and awaited in turn, never `Task.WhenAll`: two joins with the same
            // code race the account's join-attempt counter and the on-screen path mutates
            // `Session.Sheet`, which nothing here may do from two calls at once.
            foreach (var id in ids)
            {
                var message = id == _openId ? await JoinOnScreen(id) : await JoinOther(id);
                results.Add((labels.GetValueOrDefault(id, "That character"), message));
            }

            _joinResults = results;

            await Refresh();
        }
        finally
        {
            _joining = false;
        }
    }

    /// <summary>
    /// The one character this act may write through the session rather than by id — unchanged
    /// from the single-character join this replaced, down to the sentence it prints.
    ///
    /// <para><b>Before anything is written, and before the label is read off the sheet.</b>
    /// Joining writes a tier onto the character on screen and fires the autosave that puts it
    /// under the pointer's id — so a sheet that is not the pointer's character would be written
    /// over one that is, under a label taken from the wrong sheet. See
    /// <see cref="TheCharacterOnScreenIsThePointers"/>.</para>
    /// </summary>
    private async Task<string> JoinOnScreen(string id)
    {
        if (await TheCharacterOnScreenIsThePointers(id) is { } refusal) return refusal;

        var joined = await Memberships.JoinAsync(_code, id, Session.Sheet.Name);
        if (joined is not { } got) return JoinRefusalMessage();

        var result = CampaignJoin.Apply(Session.Sheet, got.Campaign);

        // The session is told once, after the sheet has been changed — so the autosave that
        // follows writes the character with its campaign rather than without it.
        if (result.Outcome is CampaignJoinOutcome.Inherited or CampaignJoinOutcome.Joined)
        {
            Session.NotifyChanged();
        }

        return result.Outcome switch
        {
            CampaignJoinOutcome.Inherited or CampaignJoinOutcome.Joined =>
                $"Joined {got.Campaign.Name}.{Took(result, got.Campaign)}{PutBack()}",
            CampaignJoinOutcome.TierDisagrees =>
                $"{got.Campaign.Name} is played at a different tier. Nothing was changed.{PutBack()}",
            _ => "That game is not here.",
        };
    }

    /// <summary>
    /// A character other than the one on screen: read by id, joined, and written back by id —
    /// never through the session, so joining several characters at once never so much as flickers
    /// the pointer at any of them.
    /// </summary>
    /// <remarks>
    /// <b>Only ever called for a row <see cref="EligibleToJoin"/> already excluded from an
    /// existing game</b>, so the campaign this is about to name is never one the character
    /// already carries. What it cannot know in advance is whether that game is the very one the
    /// code redeems into — see the checkbox list's own remark on <c>JoinCandidates</c> in the
    /// markup for why "already in a game" is the honest thing to say rather than "already in this
    /// one".
    /// </remarks>
    private async Task<string> JoinOther(string id)
    {
        // `ReadAsync`, never `OpenAsync`: this is not switching to a character, and opening one
        // would move the pointer on the way past for every character after the first ticked.
        if (await Characters.ReadAsync(id) is not { } stored)
        {
            // The same two sentences `Submit` tells its own read failure apart with, for the same
            // reason: a dropped connection is worth retrying and a character this build cannot
            // open is not, and telling the second reader to try again teaches them to distrust
            // the message.
            return Characters.LastReadRefusal == ReadRefusal.NotThere
                ? "That character could not be read: it is not on this account any more, or "
                  + "this version of the app cannot open it."
                : "That character could not be read just now — the connection may have "
                  + "dropped, or your sign-in may have ended.";
        }

        var (sheet, mode) = stored;

        // The same refusal `Submit` gives an empty stored sheet, for the same reason: a slot
        // nothing has been built into yet is not a character to put in front of a GM.
        if (Session.HasNothingOnIt(sheet))
        {
            return "This character has nothing on it yet, so it was not put into the game.";
        }

        var label = SavedCharacters.LabelFor(sheet);
        var joined = await Memberships.JoinAsync(_code, id, label);
        if (joined is not { } got) return JoinRefusalMessage();

        var result = CampaignJoin.Apply(sheet, got.Campaign);

        // **Only write when the join actually changed something.** A tier disagreement leaves the
        // sheet exactly as `CampaignJoin.Apply` found it, and writing it back regardless would be
        // a save with nothing to save — the same rule the on-screen path follows by only ringing
        // `NotifyChanged` for the same two outcomes.
        if (result.Outcome is CampaignJoinOutcome.Inherited or CampaignJoinOutcome.Joined)
        {
            var landed = await Characters.RestoreAsync(id, label, sheet, mode);

            if (!landed)
            {
                return $"Joined {got.Campaign.Name}, but the change could not be saved just "
                     + "now — the account may be full. Try again in a moment.";
            }
        }

        return result.Outcome switch
        {
            CampaignJoinOutcome.Inherited or CampaignJoinOutcome.Joined =>
                $"Joined {got.Campaign.Name}.{Took(result, got.Campaign)}",
            CampaignJoinOutcome.TierDisagrees =>
                $"{got.Campaign.Name} is played at a different tier. Nothing was changed.",
            _ => "That game is not here.",
        };
    }

    /// <summary>Why the code itself was refused, in the four sentences the box has always used.</summary>
    private string JoinRefusalMessage() => Memberships.LastJoinRefusal switch
    {
        JoinRefusal.NotACode => "That is not a code. Check the letters and try again.",
        JoinRefusal.NoSuchCampaign => "No game is using that code. Ask for a fresh one.",
        JoinRefusal.TooManyTries => "That is a lot of codes. Try again a little later.",
        _ => "Nothing could be reached just now. Try again in a moment.",
    };

    /// <summary>
    /// What the join actually took, said exactly — or nothing, for a join that took nothing.
    ///
    /// <para><b>Read off the result rather than guessed from the outcome.</b> This sentence used
    /// to claim "Its tier and its Trait Cap are now yours" whenever the campaign had a cap at all,
    /// including over a character that already had one of its own and kept it — which is the one
    /// thing joining most carefully does not do. A message claiming a change nobody made is worse
    /// than no message: it teaches a reader to distrust the ones that are true.</para>
    ///
    /// <para><b>The cap half names the figure and says what it moves.</b> A cap arriving on a
    /// character changes its Resolve, which is <c>(Trait Cap − highest rank) × 2</c> — a figure
    /// somebody may have spent Hero Points on. That is not a thing to leave a player to discover
    /// on the sheet.</para>
    /// </summary>
    private static string Took(CampaignJoinResult result, Campaign campaign) =>
        (result switch
        {
            { TookTier: true, TookTraitCap: true } =>
                $" Its tier and its {campaign.TraitCapRank}d Trait Cap are now yours,"
                + " and Resolve is measured from the cap.",

            { TookTier: true } => " Its tier is now yours.",

            { TookTraitCap: true } =>
                $" Its {campaign.TraitCapRank}d Trait Cap is now yours,"
                + " and Resolve is measured from it.",

            _ => "",
        }) + TookHouseRules(result);

    /// <summary>
    /// What a join took of the table's own rules, or nothing.
    ///
    /// <para><b>A sentence rather than a list, and that is the whole reason it is one flag and not
    /// thirteen.</b> The tier and the cap each move a figure a player can point at, so each is
    /// named with its number. The optional rules are a list somebody goes and reads, and a join
    /// message enumerating thirteen switches is not a message anybody finishes — so it says the
    /// game's rules came with the character and points at where they are printed.</para>
    ///
    /// <para><b>It is appended rather than folded into the four cases above</b>, because the two
    /// are independent: a character can take a cap and no rules, rules and no cap, or both, and
    /// folding them would be eight cases saying what two sentences say.</para>
    /// </summary>
    private static string TookHouseRules(CampaignJoinResult result) =>
        result.TookHouseRules
            ? " Its house rules came with it — they are listed under this game below."
            : "";

    /// <summary>
    /// The character this page just put back on screen, or null when it did not have to.
    /// Cleared at the start of every act, so it can only ever describe the one being reported.
    /// </summary>
    private string? _readopted;

    /// <summary>What the re-adoption above is owed in the sentence, or nothing.</summary>
    private string PutBack() =>
        _readopted is { Length: > 0 } name ? $" {name} was put back on screen first." : "";

    /// <summary>
    /// Make sure the sheet a campaign act is about really is the character the pointer names —
    /// putting it back on screen where it can be, and refusing where it cannot.
    ///
    /// <para><b>This is the guard the reported row needed and did not have, and the loss it stops
    /// is a character.</b> Joining writes a tier onto <see cref="CharacterSession.Sheet"/> and
    /// rings <see cref="CharacterSession.NotifyChanged"/>, which fires the write-through — and
    /// that write lands under <c>AccountCharacterStore.CurrentIdAsync()</c>, the pointer. Nothing
    /// holds the sheet and the pointer to the same character: <c>SignIn.razor</c> calls
    /// <c>Session.StartAgain()</c> on both its paths when the account's character cannot be read,
    /// and <c>Program.cs</c>'s boot restore does the same for a read that throws, and neither
    /// moves the pointer, because the account's character is still there. From that state a join
    /// put an empty sheet — now carrying a tier, so <see cref="CharacterSession.IsWorthKeeping"/>
    /// no longer stops it — straight over a fully statted character, and labelled the membership
    /// from the same empty sheet.</para>
    ///
    /// <para><b>Only ever asked of a sheet with nothing on it, and that is what keeps it from
    /// refusing ordinary work.</b> A sheet somebody has built is the character on screen whatever
    /// the pointer says, and there is nothing here to correct.</para>
    ///
    /// <para><b>Re-adopting is preferred to refusing, and reading is what tells the two states
    /// apart.</b> Joining a game with a brand-new empty character is the ordinary first move —
    /// the box below says so out loud — and in that state the pointer names a slot nothing has
    /// ever been written to, which answers <see cref="ReadRefusal.NotThere"/>. A read that
    /// answers a character puts it back on screen and the act goes ahead on it. Only
    /// <see cref="ReadRefusal.Unreachable"/> is refused: there the pointer may well name a
    /// character and this browser cannot tell, so writing would be a guess with somebody's work
    /// on the other side of it.</para>
    ///
    /// <para><b>Not "the session's id must equal the pointer's", which was the other shape
    /// available and is wrong.</b> An account with no characters yet mints an id for its first
    /// save and never loads anything into the session, so a strict comparison would refuse the
    /// first join every new account makes — a real flow, broken to close a failure it is not in.
    /// The question this asks is the one that actually distinguishes them: is there a character
    /// behind the pointer that this act would write over.</para>
    /// </summary>
    /// <returns>The sentence to print instead of acting, or null when the act may go ahead.</returns>
    private async Task<string?> TheCharacterOnScreenIsThePointers(string id)
    {
        _readopted = null;

        if (!Session.HasNothingOnIt(Session.Sheet)) return null;

        // `OpenAsync` rather than `ReadAsync`, because this really is switching to a character:
        // the app is about to act on it and the reader is about to be shown it. The pointer is
        // already on this id, so the move it makes on the way past is a move to where it is.
        if (await Characters.OpenAsync(id) is { } behind)
        {
            Session.Open(behind.Sheet, behind.Mode, id);
            _readopted = SavedCharacters.LabelFor(behind.Sheet);
            return null;
        }

        if (Characters.LastReadRefusal == ReadRefusal.NotThere) return null;

        // Named from the account's own list, which is a second read and is worth it: this is the
        // rare path, and "your character" is not the sentence somebody needs when the whole point
        // is which character was not written over.
        var named = (await Characters.ListAsync()).Characters
            .FirstOrDefault(c => c.Id == id)?.Label;

        return (named is { Length: > 0 } ? $"{named} is the character" : "The character")
            + " this browser has open, and it could not be read just now — so nothing was written"
            + " and nothing was sent. Open it in the character manager and try again.";
    }

    /// <summary>
    /// Send the character this row names for approval.
    ///
    /// <para><b>One slot per character per campaign, and resubmitting overwrites it.</b> There is
    /// no history and no rollback: a decision queue is what this is, and a row per submission would
    /// be a version-control system for characters.</para>
    ///
    /// <para><b>The label and the payload come from one place, and that is the whole of this
    /// method's correctness.</b> It used to send <c>Session.Sheet</c> — the character on screen —
    /// into a membership keyed on the browser's current-character pointer, and nothing held those
    /// two to the same character. <c>SignIn.razor</c> empties the session on both its paths when
    /// the account's character cannot be read, and <c>Program.cs</c>'s boot restore does the same
    /// for a read that throws; neither moves the pointer, because the account's character is still
    /// there. From that state this row still offered Send for approval and sent an empty sheet
    /// under a real character's name — a GM opened an approved clone and was shown an unnamed
    /// character with every Trait at 0d, 379 bytes carrying nothing but the tier, campaign id and
    /// house Trait Cap that <c>CampaignJoin.Apply</c> copies in.</para>
    ///
    /// <para><b>What holds them to one character is now said rather than hoped, so the sheet on
    /// screen is sent again — and this is a correction to the first fix rather than a return to
    /// the fault.</b> Reading the stored copy back by id made the two halves agree, and bought
    /// that with a lag: the ordinary autosave is fire-and-forget over HTTP, so a read taken
    /// straight after an edit can answer from before that edit landed. A player who raised a
    /// Trait and pressed Send in the same breath sent the rank they had a moment ago — silently,
    /// with a sentence saying it had been sent, and the GM deciding about a character nobody was
    /// looking at. <see cref="CharacterSession.HoldsTheCharacterAt"/> is the question that was
    /// missing: where the session is holding <em>this</em> row's character, the sheet on screen is
    /// the newest copy there is and it is what goes. Where it is not — or where this session was
    /// never told which character it holds — the stored copy is still the answer, which is the
    /// safe half of the original fix kept exactly as it was.</para>
    ///
    /// <para><b>The label follows the payload either way</b>, because
    /// <c>ApiMembershipStore.SubmitAsync</c> takes it off the sheet it is given. There is no
    /// second source left to disagree.</para>
    ///
    /// <para><b>An empty sheet is refused rather than sent, and never repaired.</b> The refusal is
    /// a sentence under the row's own Send button for the reason every other refusal here is one:
    /// a control that silently does nothing is indistinguishable from one that is not wired up.
    /// Nothing is written to put a bad row right — the player resubmits, which is the remedy this
    /// screen already has.</para>
    /// </summary>
    private async Task Submit(MembershipSummary one, bool handOverConfirmed = false)
    {
        ArgumentNullException.ThrowIfNull(one);

        // Whatever this says, it says it in this row. Set together with the message so a sentence
        // can never end up under a membership it is not about.
        _sent = null;
        _sentAbout = one.Id;

        // A row with no character id is the GM's view of a membership, and this control is not
        // drawn on that screen. Belt and braces, and it costs one comparison.
        if (one.CharacterId is not { Length: > 0 } id)
        {
            _sent = "That row does not name a character, so there is nothing to send.";
            return;
        }

        // The same guard the join takes, and for the same reason: this row is only drawn against
        // the pointer's own character, so an empty sheet on screen beside a real stored one is a
        // state to put right or refuse — never one to act on. See `TheCharacterOnScreenIsThePointers`.
        if (await TheCharacterOnScreenIsThePointers(id) is { } refusal)
        {
            _sent = refusal;
            return;
        }

        // The sheet on screen where the session is holding this very character — the newest copy
        // there is, and the one the player is looking at. See the remarks.
        var sending = Session.HoldsTheCharacterAt(id)
            ? (Sheet: Session.Sheet, Mode: Session.Mode)
            : null as (CharacterSheet Sheet, SheetMode Mode)?;

        if (sending is null)
        {
            // `ReadAsync` rather than `OpenAsync`: sending is not switching to a character, and
            // opening one would move the pointer on the way past.
            if (await Characters.ReadAsync(id) is not { } stored)
            {
                // **Two failures, two sentences, and the wrong one of them sends somebody
                // hunting for a fault that is not theirs.** A dropped connection or a session
                // that ended while the tab was open is a moment and is worth retrying; a
                // character that is not on the account, or a payload this build cannot open, is
                // not, and telling that reader to "try again in a moment" will be believed and
                // will keep being believed. `CampaignApproval` already tells its own two arms
                // apart for the same reason.
                _sent = Characters.LastReadRefusal == ReadRefusal.NotThere
                    ? "That character could not be read: it is not on this account any more, or "
                      + "this version of the app cannot open it. Open it in the character manager."
                    : "That character could not be read just now — the connection may have "
                      + "dropped, or your sign-in may have ended. Try again, or sign in again.";

                return;
            }

            sending = stored;
        }

        if (Session.HasNothingOnIt(sending.Value.Sheet))
        {
            _sent = "This character has nothing on it yet, so there is nothing to send. "
                + "Open it, build it up, and send it when it is ready.";
            return;
        }

        // **Asked of the sheet that is about to go, not of the row or the screen's palette**,
        // because that sheet's mode is the word the server will act on — the stored copy can be a
        // Villain while the session is empty, and the other way round. The first press stops here
        // and draws the warning; the warning's own button comes back with the confirmation.
        if (sending.Value.Mode == SheetMode.Villain && !handOverConfirmed)
        {
            _sentAbout = null;
            _confirmingHandover = one.Id;
            return;
        }

        _confirmingHandover = null;

        _sent = await Memberships.SubmitAsync(one.Id, sending.Value.Sheet, sending.Value.Mode) is null
            ? "That could not be sent just now. Try again in a moment."
            // **The name on the sheet that was actually sent, not the label the row was carrying.**
            // A membership's label is whatever the character was called when it last joined or
            // was submitted, so a player who renamed their character and pressed Send was told it
            // had gone under the old name — a message about a character nobody has, which is the
            // shape that teaches somebody to distrust the ones that are true. It is also the same
            // string the server was handed: `SubmitAsync` takes the label off this sheet.
            : $"Sent to {SavedCharacters.LabelFor(sending.Value.Sheet)}."
              + (sending.Value.Mode == SheetMode.Villain
                  ? $" It is still yours until the GM approves it.{PutBack()}"
                  : $" Your own copy is unchanged.{PutBack()}");

        await Refresh();
    }

    private static string? Blank(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value;

    private static int? Number(string? value) =>
        int.TryParse(value, out var parsed) && parsed > 0 ? parsed : null;

    public void Dispose()
    {
        Accounts.Changed -= Reload;
        Session.Changed -= Redraw;
    }
}
