@page "/build/characteristics"
@implements IDisposable
@inject CharacterSession Session
@inject Commands Commands

<PageTitle>Characteristics — Prowlers &amp; Paragons</PageTitle>

<h1>Buy characteristics</h1>

@if (Session.Sheet.SelectedTierId is null)
{
    <Panel>
        <p>Choose a tier first — it sets the budget and the Trait Cap everything here is measured against.</p>
        <a class="btn primary" href="build">Back to tiers</a>
    </Panel>
}
else
{
    @* Not role="tablist"/role="tab". That pattern promises a role="tabpanel" for each tab,
       aria-controls pointing at it, and arrow-key roving focus, and this had none of the
       three — a half-built ARIA pattern tells assistive technology to expect behaviour that
       is not there, which is worse than plain buttons that behave as they look.

       aria-current is written as a string for the same reason MainLayout's aria-pressed is:
       Blazor renders a true bool as an empty attribute value, which is invalid and reads as
       the opposite of what is meant. *@
    <div class="tabs" role="group" aria-label="Sections of this step">
        @foreach (var tab in Tabs)
        {
            <button type="button"
                    aria-current="@(_tab == tab.Key ? "true" : "false")"
                    @onclick="() => _tab = tab.Key">
                @* The ring is a shape rather than a colour, so it survives a reader who cannot
                   see the colour — but a shape is not available to a screen reader either, and
                   the count alone ("Powers 0") leaves the reader to infer it. So the word is
                   there too, off-screen, for the sections that carry the marking. *@
                @tab.Label
                <span class="tab-count@(tab.Untouched() ? " untouched" : "")">
                    @tab.Count()@if (tab.Untouched())
                    {
                        <span class="sr-only"> — nothing here yet</span>
                    }
                </span>
            </button>
        }
    </div>

    @switch (_tab)
    {
        @* No semicolon after the component: Razor renders it as a statement already, and
           adding one emits an empty statement into the generated code. *@
        case "abilities": <AbilitiesTab /> break;
        case "talents":   <TalentsTab />   break;
        case "powers":    <PowersTab />    break;
        case "perks":     <PerksTab />     break;
        default:          <FlawsTab />     break;
    }

    <StepButtons Back="build" BackLabel="Tier" Next="build/gear" NextLabel="Gear" />
}

@code {
    private string _tab = "abilities";

    // The tab strip counts what the tabs contain, so it has to redraw when one of them
    // changes something — a Power added inside the Powers section moves the count here.
    protected override void OnInitialized()
    {
        Session.Changed += StateHasChanged;
        Commands.Changed += Asked;

        // Arriving here *because* somebody chose a Power in the palette. This runs on the
        // navigation; the event above covers the other case, where they were already on this
        // step and the address therefore did not change.
        Asked();
    }

    /// <summary>
    /// Somebody asked for a Power from the palette, so show the section that holds it.
    ///
    /// <para><b>This peeks rather than takes.</b> The section below is what opens the editor
    /// and what clears the request; if this consumed it, the request would be gone before the
    /// component that acts on it had rendered, and the palette would land the reader on the
    /// right tab with nothing open — the failure that looks most like the feature working.</para>
    /// </summary>
    private void Asked()
    {
        if (Commands.RequestedPowerId is not null) _tab = "powers";
        StateHasChanged();
    }

    public void Dispose()
    {
        Session.Changed -= StateHasChanged;
        Commands.Changed -= Asked;
    }

    /// <param name="Untouched">
    /// Whether this section has nothing in it yet, so the strip can say which sections are
    /// still to do rather than leaving a reader to notice a zero among four other numbers.
    ///
    /// <para><b>Every section can answer it, and the first version of this wrongly said two of
    /// them could not.</b> The argument was that Ch.2 floors every Ability and Talent at 1d, so a
    /// character has all eighteen and cannot be without them — true of a <em>finished</em>
    /// character, and exactly why a fresh one needs telling. It went on to claim that 0 HP there
    /// "means a package covered it, not that nobody has been here", and that is false on the
    /// default path: <c>AbilityCost</c> walks <c>AbilityRanks</c>, which is empty on a new sheet,
    /// so <b>no package also costs 0 HP</b>. The two sections that most needed marking were the
    /// two forbidden from ever saying so, on a character the validator reports eighteen
    /// <c>TRAIT_BELOW_MINIMUM</c> errors deep.</para>
    ///
    /// <para><b>So the question is whether a rank is recorded, not what the section costs</b> —
    /// which tells the two cases apart properly, because choosing a package writes its granted
    /// ranks straight into <c>AbilityRanks</c> and <c>TalentRanks</c> (see
    /// <c>ChooseTier.SelectPackage</c>). A packaged character reads as touched at 0 HP; a fresh
    /// one reads as untouched.</para>
    /// </param>
    private sealed record Tab(string Key, string Label, Func<string> Count, Func<bool> Untouched);

    private Tab[] Tabs => [
        new("abilities", "Abilities", () => $"{Session.Costs.AbilityCost(Session.Sheet)} HP",
                                      () => Session.Sheet.AbilityRanks.Count == 0),
        new("talents",   "Talents",   () => $"{Session.Costs.TalentCost(Session.Sheet)} HP",
                                      () => Session.Sheet.TalentRanks.Count == 0),
        new("powers",    "Powers",    () => $"{Session.Sheet.SelectedPowers.Count}",
                                      () => Session.Sheet.SelectedPowers.Count == 0),
        new("perks",     "Perks",     () => $"{Session.Sheet.Perks.Count}",
                                      () => Session.Sheet.Perks.Count == 0),
        new("flaws",     "Flaws",     () => $"{Session.Sheet.Flaws.Count}",
                                      () => Session.Sheet.Flaws.Count == 0),
    ];
}
