    private void SetBaseFeature(OwnedHeadquarters house, SelectedAssetFeature old, SelectedAssetFeature? updated) =>
        SetBase(house, house with { Features = Replace(house.Features, old, updated) });

    // ── Gadgets ───────────────────────────────────────────────────────────

    private void AddGadget()
    {
        if (string.IsNullOrWhiteSpace(_newGadget)) return;

        // Opened at the floor rather than at zero: a Gadget at Complexity 0 is reported by the
        // validator the instant it exists, and greeting somebody with a finding for pressing Add
        // is the app telling them off for using it.
        var gadget = new BuiltGadget(_newGadget.Trim())
        {
            Complexity = Session.Assets.MinimumGadgetComplexity
        };

        Session.Sheet.Gadgets.Add(gadget);
        _newGadget = "";
        _gadget = gadget;
        Session.NotifyChanged();
    }

    private void RemoveGadget(BuiltGadget gadget)
    {
        Session.Sheet.Gadgets.Remove(gadget);
        if (ReferenceEquals(_gadget, gadget)) _gadget = null;
        Session.NotifyChanged();
    }

    private void SetGadget(BuiltGadget old, BuiltGadget updated)
    {
        var index = Session.Sheet.Gadgets.IndexOf(old);
        if (index < 0) return;

        Session.Sheet.Gadgets[index] = updated;
        _gadget = updated;
        Session.NotifyChanged();
    }

    private void AddGadgetPower(BuiltGadget gadget, string powerId)
    {
        if (gadget.Powers.Any(p => p.PowerId == powerId)) return;

        SetGadget(gadget, gadget with
        {
            Powers = [.. gadget.Powers, new SelectedPower(powerId, 1)]
        });
    }

    private void SetGadgetPower(BuiltGadget gadget, SelectedPower old, SelectedPower? updated) =>
        SetGadget(gadget, gadget with { Powers = Replace(gadget.Powers, old, updated) });

    private string PowerLine(SelectedPower power) =>
        $"{Session.Rules.GetPower(power.PowerId)?.Name ?? power.PowerId} {power.PurchasedRanks}d";

    // ── The campaign's own ────────────────────────────────────────────────

    private void SetContribution(CampaignAssetContribution old, CampaignAssetContribution updated)
    {
        var index = Session.Sheet.CampaignAssets.IndexOf(old);
        if (index < 0) return;

        Session.Sheet.CampaignAssets[index] = updated;
        Session.NotifyChanged();
    }

    private void RemoveContribution(CampaignAssetContribution contribution)
    {
        Session.Sheet.CampaignAssets.Remove(contribution);
        Session.NotifyChanged();
    }

    /// <summary>
    /// Start putting into one of the game's own objects.
    ///
    /// <para><b>At nothing rather than at a figure</b>, which is the opposite of the Gadget's
    /// minimum Complexity one panel up and is right for the opposite reason: a Gadget at zero is a
    /// finding the moment it exists, and a contribution of nothing is an ordinary state — somebody
    /// has said which object they are backing and not yet how much.</para>
    ///
    /// <para><b>The id, the name and the kind are all copied from the object</b>, so a sheet read
    /// with no campaign in front of it still prints something a reader recognises, and a
    /// contribution's kind can never disagree with the object's. Pressing the same row twice adds
    /// nothing: two contributions to one object from one character are one contribution written
    /// down twice, and the ledger would sum them into a figure neither box shows.</para>
    /// </summary>
    private void Contribute(CampaignAsset asset)
    {
        if (Session.Sheet.CampaignAssets.Any(
                c => string.Equals(c.AssetId, asset.Id, StringComparison.Ordinal)))
        {
            return;
        }

        Session.Sheet.CampaignAssets.Add(new CampaignAssetContribution(asset.Id)
        {
            Name = asset.Name,
            Kind = asset.Kind,
        });

        Session.NotifyChanged();
    }

    // ── Propose one of your own — PROGRESS item 33, rulings 5+6 ──────────────

    /// <summary>
    /// The two kinds, off the constants a contribution names them with. <b>One spelling in
    /// markup</b>, not the type name itself — the same reason <c>CampaignApproval.razor</c> aliases
    /// them, since a page may not print a type this project declares.
    /// </summary>
    private const string ProposalVehicle = CampaignAssetContribution.Vehicle;

    /// <inheritdoc cref="ProposalVehicle"/>
    private const string ProposalHeadquarters = CampaignAssetContribution.Headquarters;

    /// <summary>What is being named before a proposal starts, and which of the two it will be.</summary>
    private string _proposing = "";

    private string _proposingKind = ProposalVehicle;

    /// <summary>The proposal being built, or null when none is open.</summary>
    private CampaignAsset? _proposal;

    private string _proposalName = "";

    /// <summary>
    /// Hero Points on this proposal. Held beside the draft rather than on it, exactly as
    /// <c>_draftName</c> is on the campaign page — the object and the spend are two different
    /// questions the player is answering, and only one of them is Chapter 6's.
    /// </summary>
    private int _proposalHeroPoints;

    private string ProposalTitle =>
        string.IsNullOrWhiteSpace(_proposalName) ? "A shared object" : _proposalName.Trim();

    /// <summary>
    /// The proposal's own books as it is typed: what it costs against what the Hero Points above
    /// buy — never against another member's budget, because nobody has funded this yet and
    /// nobody's Hero Points but this character's own are being spent.
    /// </summary>
    private string ProposalBooks(CampaignAsset proposal) =>
        AssetFormatter.Describe(
            proposal, CampaignAssets.Spend(Session.Costs, proposal),
            checked(_proposalHeroPoints * Session.Costs.CampaignAssetPointsPerHeroPoint(proposal)));

    private static string ProposalCurrency(CampaignAsset proposal) =>
        proposal.IsHeadquarters ? "Base Points" : "Vehicle Points";

    /// <summary>
    /// The same printed rules a GM-typed object is held to, plus the surplus a proposal's own Hero
    /// Points may leave unspent — read straight off the engine, exactly as it will be read again
    /// once this rides the submission. Live, as the draft is typed, so the same finding a GM would
    /// eventually see is not a surprise the player only meets after sending it.
    /// </summary>
    private IReadOnlyList<ValidationIssue> ProposalFindings(CampaignAsset proposal)
    {
        var issues = Session.Check(proposal).ToList();

        if (CampaignAssets.Spend(Session.Costs, proposal) is { } spent)
        {
            var bought = checked(_proposalHeroPoints * Session.Costs.CampaignAssetPointsPerHeroPoint(proposal));
            var unspent = bought - spent;

            if (unspent > 0)
                issues.Add(new ValidationIssue(ValidationSeverity.Warning, "CAMPAIGN_ASSET_SURPLUS",
                    $"This costs {_proposalHeroPoints} Hero Points, buying {bought} "
                    + $"{ProposalCurrency(proposal)}, but the build only spends {spent}. "
                    + $"{unspent} {ProposalCurrency(proposal)} are unspent."));
        }

        return issues;
    }

    /// <summary>
    /// Start a proposal. <b>The id is minted here, the same way a GM's own editor mints one</b> —
    /// off <c>StoredCampaign.NewAssetId()</c> — because it is what the campaign will keep on
    /// adoption, so the contribution this character writes is never re-pointed.
    /// </summary>
    private void StartProposal()
    {
        if (string.IsNullOrWhiteSpace(_proposing)) return;

        _proposalName = _proposing.Trim();
        _proposal = new CampaignAsset(StoredCampaign.NewAssetId(), _proposingKind, _proposalName);
        _proposalHeroPoints = 0;
        _proposing = "";
    }

    private void CancelProposal()
    {
        _proposal = null;
        _proposalHeroPoints = 0;
    }

    /// <summary>
    /// Write the proposal onto this character as a contribution — the whole of what "presenting"
    /// it means today, since it rides the ordinary character submission rather than a channel of
    /// its own. <b>The Hero Points are charged the moment this is written</b>, the owner's answer to
    /// when a proposal is spent: they are this player's own, from character creation, and must
    /// never be stranded waiting on a GM's decision.
    /// </summary>
    private void SaveProposal()
    {
        if (_proposal is not { } proposal) return;
        if (string.IsNullOrWhiteSpace(_proposalName)) return;

        var saved = proposal with { Name = _proposalName.Trim() };

        Session.Sheet.CampaignAssets.Add(new CampaignAssetContribution(saved.Id)
        {
            Name = saved.Name,
            Kind = saved.Kind,
            HeroPoints = _proposalHeroPoints,
            Proposal = saved
        });

        _proposal = null;
        _proposalHeroPoints = 0;
        Session.NotifyChanged();
    }

    // ── Shared ────────────────────────────────────────────────────────────

    /// <summary>
    /// The right-hand column: what the row costs, <b>with its currency</b>. A bare number in a
    /// list beside a Hero Point budget is the category error this whole page is careful about.
    ///
    /// <para><b>Both of these moved to <see cref="AssetRows"/> when the campaign's own page grew
    /// the same two lists</b>, since a currency spelled in two screens is a currency two screens
    /// can disagree about.</para>
    /// </summary>
    private static string Price(AssetCatalogueRow row) => AssetRows.Price(row);

    /// <inheritdoc cref="Price(AssetCatalogueRow)"/>
    private static string? CheapestGrade(AssetCatalogueRow row) => AssetRows.CheapestGrade(row);

    private static IReadOnlyList<T> Replace<T>(IReadOnlyList<T> list, T old, T? updated) where T : class =>
        [.. list.SelectMany(item => ReferenceEquals(item, old)
            ? (updated is null ? Array.Empty<T>() : [updated])
            : new[] { item })];

    private static int Number(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var value) ? value : 0;

    private static int? OptionalNumber(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var value) ? value : null;
}
