@page "/build/assets"
@inject CharacterSession Session
@inject Commands Commands
@inject AccountCampaignStore Campaigns
@inject ApiMembershipStore Memberships

<PageTitle>Vehicles &amp; bases — Prowlers &amp; Paragons</PageTitle>

<h1>Vehicles &amp; bases</h1>
@* **Three currencies on one page, which is why every figure here says which it is in.** The
   Unique Vehicle Perk converts a Hero Point into twenty-five Vehicle Points and the Headquarters
   Perk into three Base Points; a Gadget runs the other way and pays Hero Points out. A bare
   number in any of the lists below would be the category error the whole area is careful about. *@
<p class="muted">
    Chapter 6, pp.94–103. Vehicles and bases are bought in <b>second currencies</b>; a Gadget
    <em>pays</em> Hero Points into a pool of its own.
</p>

@* ── Vehicles ─────────────────────────────────────────────────────────────── *@

<Panel Title="Vehicles" Cost="@($"{Session.Costs.TotalAssetPerkCost(Session.Sheet)} HP on all of it")">
    @if (Session.Sheet.Vehicles.Count == 0)
    {
        <EmptyState>No vehicle of your own. A machine the whole team paid for belongs to the campaign.</EmptyState>
    }
    else
    {
        <ChosenList>
            @foreach (var vehicle in Session.Sheet.Vehicles.ToList())
            {
                <ChosenRow Findings="SheetFindings.ForVehicle(Validation, vehicle.Name)">
                    <Body>
                        <b>@Headline(vehicle)</b>
                        <span class="muted small"> — @Ranks(vehicle)</span>
                        @if (vehicle.Features.Count > 0)
                        {
                            <span class="muted small"><br />@FeatureLine(vehicle)</span>
                        }
                    </Body>
                    <Actions>
                        <button type="button" class="btn small" @onclick="() => _vehicle = vehicle">Edit</button>
                        <button type="button" class="btn small danger" @onclick="() => RemoveVehicle(vehicle)">Remove</button>
                    </Actions>
                </ChosenRow>
            }
        </ChosenList>
    }

    <div class="inline spaced">
        <input type="text" placeholder="Name a vehicle" @bind="_newVehicle" @bind:event="oninput"
               @onkeydown="@(e => { if (e.Key == "Enter") AddVehicle(); })" aria-label="New vehicle" />
        <button type="button" class="btn" aria-label="Add vehicle"
                disabled="@string.IsNullOrWhiteSpace(_newVehicle)"
                @onclick="AddVehicle">Add</button>
    </div>
</Panel>

@if (_vehicle is { } machine)
{
    <Panel Class="machine" Title="@machine.Name"
           Cost="@($"{Session.Costs.VehiclePointsSpent(machine)}/{Session.Costs.VehiclePointBudget(machine)} VP")">
        @* p.96 opens Body, Speed and Control at nothing and gives Weapons no starting value at
           all, so a machine costs what it is — SelectedGear's free baseline is the wrong
           precedent. Control is the one at two points a rank, capped at half the Speed, and a
           negative Control pays two back a rank down to −3. The validator says both. *@
        <VehicleRanksNote />

        <Field Label="Hero Points on the Unique Vehicle Perk" For="vehicle-perk">
            <input id="vehicle-perk" type="number" min="0" value="@machine.PerkHeroPoints"
                   @onchange="e => SetVehicle(machine, machine with { PerkHeroPoints = Number(e) })" />
            <span class="muted small">
                @(Session.Costs.VehiclePointBudget(machine)) Vehicle Points at
                @(Session.Assets.VehiclePointsPerHeroPoint) each.
            </span>
        </Field>

        <Field Label="Body" For="vehicle-body">
            <input id="vehicle-body" type="number" min="0" value="@machine.Body"
                   @onchange="e => SetVehicle(machine, machine with { Body = Number(e) })" />
        </Field>
        <Field Label="Speed" For="vehicle-speed">
            <input id="vehicle-speed" type="number" min="0" value="@machine.Speed"
                   @onchange="e => SetVehicle(machine, machine with { Speed = Number(e) })" />
        </Field>
        <Field Label="Control" For="vehicle-control">
            <input id="vehicle-control" type="number" value="@machine.Control"
                   @onchange="e => SetVehicle(machine, machine with { Control = Number(e) })" />
        </Field>
        <Field Label="Weapons" For="vehicle-weapons">
            <input id="vehicle-weapons" type="number" min="0" value="@machine.Weapons"
                   placeholder="unarmed"
                   @onchange="e => SetVehicle(machine, machine with { Weapons = OptionalNumber(e) })" />
            <span class="muted small">Leave it empty for a machine with no weapon systems at all.</span>
        </Field>

        <Field Label="Features (pp.96–100)">
            @if (machine.Features.Count > 0)
            {
                <ChosenList>
                    @foreach (var f in machine.Features.ToList())
                    {
                        <ChosenRow Findings="SheetFindings.ForAssetFeature(Validation, machine.Name, f.FeatureId)">
                            <Body>@FeatureName(f, onAVehicle: true)</Body>
                            <Actions>
                                @if (Session.Assets.FindVehicleFeature(f.FeatureId) is { CostType: "per_unit" })
                                {
                                    <input type="number" min="1" value="@f.Units" class="units"
                                           aria-label="Units"
                                           @onchange="e => SetVehicleFeature(machine, f, f with { Units = Number(e) })" />
                                }
                                <button type="button" class="btn small danger"
                                        @onclick="() => SetVehicleFeature(machine, f, null)">Remove</button>
                            </Actions>
                        </ChosenRow>
                    }
                </ChosenList>
            }

            <OptionList Placeholder="Filter the vehicle features" Query="@_rowQuery">
                @foreach (var row in VehicleFeatureRows)
                {
                    <OptionRow Name="@row.Name" Caveat="@row.Description" Cost="@Price(row)"
                               Keywords="@row.Keywords"
                               OnSelect="() => AddVehicleFeature(machine, row)" />
                }
            </OptionList>
        </Field>

        @* p.96's six stock machines. **They seed the numbers and are not a thing to own** — a
           stock vehicle is a worked example the page prints with its total, so copying one is how
           somebody starts rather than a purchase with a shape of its own on the sheet. *@
        <Field Label="Start from a stock vehicle (p.96)">
            <OptionList Placeholder="Filter the stock vehicles" Query="@_rowQuery">
                @foreach (var row in StockVehicleRows)
                {
                    <OptionRow Name="@row.Name" Caveat="@row.Description"
                               Cost="@($"{row.Cost} VP")" Keywords="@row.Keywords"
                               OnSelect="() => CopyStock(machine, row)" />
                }
            </OptionList>
        </Field>

        <div class="inline">
            <button type="button" class="btn" @onclick="() => _vehicle = null">Done</button>
        </div>
    </Panel>
}

@* ── Headquarters ─────────────────────────────────────────────────────────── *@

<Panel Title="Headquarters">
    @* p.100 grants "a basic headquarters no larger than an average mansion or warehouse, with
       whatever ordinary rooms, equipment and facilities the owner wants" for the Perk alone, so a
       base with no features is not an error and is not free either. The same page gives Villains
       headquarters, which is why nothing here is conditioned on what kind of character owns it. *@
    <p class="small muted">
        The Perk buys the building, already furnished; every Hero Point after that is three Base
        Points for the features (p.100).
    </p>

    @if (Session.Sheet.Headquarters.Count == 0)
    {
        <EmptyState>No base of your own.</EmptyState>
    }
    else
    {
        <ChosenList>
            @foreach (var hq in Session.Sheet.Headquarters.ToList())
            {
                <ChosenRow Findings="SheetFindings.ForHeadquarters(Validation, hq.Name)">
                    <Body>
                        <b>@Headline(hq)</b>
                        @if (hq.Features.Count > 0)
                        {
                            <span class="muted small"><br />@FeatureLine(hq)</span>
                        }
                    </Body>
                    <Actions>
                        <button type="button" class="btn small" @onclick="() => _base = hq">Edit</button>
                        <button type="button" class="btn small danger" @onclick="() => RemoveBase(hq)">Remove</button>
                    </Actions>
                </ChosenRow>
            }
        </ChosenList>
    }

    <div class="inline spaced">
        <input type="text" placeholder="Name a headquarters" @bind="_newBase" @bind:event="oninput"
               @onkeydown="@(e => { if (e.Key == "Enter") AddBase(); })" aria-label="New headquarters" />
        <button type="button" class="btn" aria-label="Add headquarters"
                disabled="@string.IsNullOrWhiteSpace(_newBase)"
                @onclick="AddBase">Add</button>
    </div>
</Panel>

@if (_base is { } house)
{
    <Panel Class="base" Title="@house.Name"
           Cost="@($"{Session.Costs.BasePointsSpent(house)}/{Session.Costs.BasePointBudget(house)} BP")">
        <Field Label="Hero Points on the Headquarters Perk" For="base-perk">
            <input id="base-perk" type="number" min="0" value="@house.PerkHeroPoints"
                   @onchange="e => SetBase(house, house with { PerkHeroPoints = Number(e) })" />
            <span class="muted small">
                @(Session.Costs.BasePointBudget(house)) Base Points at
                @(Session.Assets.BasePointsPerHeroPoint) each.
            </span>
        </Field>

        <Field Label="Features (pp.100–103)">
            @if (house.Features.Count > 0)
            {
                <ChosenList>
                    @foreach (var f in house.Features.ToList())
                    {
                        <ChosenRow Findings="SheetFindings.ForAssetFeature(Validation, house.Name, f.FeatureId)">
                            <Body>@FeatureName(f, onAVehicle: false)</Body>
                            <Actions>
                                @if (Session.Assets.FindBaseFeature(f.FeatureId) is { CostRange: { } grades })
                                {
                                    <select aria-label="Grade" value="@f.GradeKey"
                                            @onchange="e => SetBaseFeature(house, f, f with { GradeKey = e.Value?.ToString() })">
                                        @foreach (var grade in grades.OrderBy(g => g.Value))
                                        {
                                            <option value="@grade.Key">@Labels.Humanise(grade.Key) — @grade.Value BP</option>
                                        }
                                    </select>
                                }
                                @if (Session.Assets.FindBaseFeature(f.FeatureId) is { CostType: "per_unit" })
                                {
                                    <input type="number" min="1" value="@f.Units" class="units"
                                           aria-label="Units"
                                           @onchange="e => SetBaseFeature(house, f, f with { Units = Number(e) })" />
                                }
                                <button type="button" class="btn small danger"
                                        @onclick="() => SetBaseFeature(house, f, null)">Remove</button>
                            </Actions>
                        </ChosenRow>
                    }
                </ChosenList>
            }

            <OptionList Placeholder="Filter the base features" Query="@_rowQuery">
                @foreach (var row in BaseFeatureRows)
                {
                    <OptionRow Name="@row.Name" Caveat="@row.Description" Cost="@Price(row)"
                               OnSelect="() => AddBaseFeature(house, row)" />
                }
            </OptionList>
        </Field>

        <div class="inline">
            <button type="button" class="btn" @onclick="() => _base = null">Done</button>
        </div>
    </Panel>
}

@* ── Gadgets ──────────────────────────────────────────────────────────────── *@

<Panel Title="Gadgets">
    @* p.94's prerequisites, both of which the validator reports: six dice of Technology before
       the rules open at all, and a Complexity between three and that Technology. The third — no
       more than half the builder's Intellect in one issue — is about an issue rather than about a
       sheet, and nothing here knows which issue it is looking at. *@
    <p class="small muted">
        p.94. Needs @(Prerequisites.MinimumTechnologyRank)d of Technology — you have
        @(Session.Sheet.GetTalentRank("technology"))d. A build <b>pays out</b> twice the
        Complexity, and costs your own budget nothing.
    </p>

    @if (Session.Sheet.Gadgets.Count == 0)
    {
        <EmptyState>Nothing built.</EmptyState>
    }
    else
    {
        <ChosenList>
            @foreach (var gadget in Session.Sheet.Gadgets.ToList())
            {
                <ChosenRow Findings="SheetFindings.ForGadget(Validation, gadget.Name)">
                    <Body>
                        <b>@Headline(gadget)</b>
                        @if (gadget.Powers.Count > 0)
                        {
                            <span class="muted small">
                                <br />@string.Join(", ", gadget.Powers.Select(PowerLine))
                            </span>
                        }
                    </Body>
                    <Actions>
                        <input type="number" min="0" value="@gadget.Complexity" class="units"
                               aria-label="Complexity"
                               @onchange="e => SetGadget(gadget, gadget with { Complexity = Number(e) })" />
                        <button type="button" class="btn small" @onclick="() => _gadget = gadget">Edit</button>
                        <button type="button" class="btn small danger" @onclick="() => RemoveGadget(gadget)">Remove</button>
                    </Actions>
                </ChosenRow>
            }
        </ChosenList>
    }

    <div class="inline spaced">
        <input type="text" placeholder="Name a Gadget" @bind="_newGadget" @bind:event="oninput"
               @onkeydown="@(e => { if (e.Key == "Enter") AddGadget(); })" aria-label="New Gadget" />
        <button type="button" class="btn" aria-label="Add Gadget"
                disabled="@string.IsNullOrWhiteSpace(_newGadget)"
                @onclick="AddGadget">Add</button>
    </div>
</Panel>

@if (_gadget is { } built)
{
    <Panel Class="gadget" Title="@built.Name"
           Cost="@($"{Session.Costs.GadgetPool(built)} HP paid out")">
        <Field Label="Powers bought out of the pool">
            @if (built.Powers.Count > 0)
            {
                <ChosenList>
                    @foreach (var power in built.Powers.ToList())
                    {
                        <ChosenRow>
                            <Body>@PowerLine(power)</Body>
                            <Actions>
                                <input type="number" min="0" value="@power.PurchasedRanks" class="units"
                                       aria-label="Ranks"
                                       @onchange="e => SetGadgetPower(built, power, power with { PurchasedRanks = Number(e) })" />
                                <button type="button" class="btn small danger"
                                        @onclick="() => SetGadgetPower(built, power, null)">Remove</button>
                            </Actions>
                        </ChosenRow>
                    }
                </ChosenList>
            }

            @* **Pros and Cons on a Gadget's Power are deliberately not here.** p.94 allows them
               and the engine prices them; what this screen has no room for is the whole
               ProConPicker under every Power of every Gadget, and a half-picker that offered some
               of them would be a rule this page had decided. A payload from `build --from` or the
               MCP server carries them and is priced correctly — see docs/guide/browser.md. *@
            <OptionList Placeholder="Filter the Powers">
                @foreach (var power in Session.Rules.Powers)
                {
                    <OptionRow Name="@power.Name" Caveat="@PowerFormatter.StatLine(power)"
                               Keywords="@power.Tags"
                               OnSelect="() => AddGadgetPower(built, power.Id)" />
                }
            </OptionList>
        </Field>

        <div class="inline">
            <button type="button" class="btn" @onclick="() => _gadget = null">Done</button>
        </div>
    </Panel>
}

@* ── The campaign's own ───────────────────────────────────────────────────── *@

<Panel Title="Shared with the campaign">
    @* Both p.96 and p.100 let Heroes pool their allowances on one object, and a CharacterSheet is
       one character — so a pooled machine is either unrepresentable on one or double-counted
       across five. What a character can honestly say is how much they put in; what the object came
       out as is the campaign's answer, summed from every member. *@
    <p class="small muted">
        A team can pool their allowances on one object. Recorded here is <b>what you put in</b>;
        the object is the campaign's.
    </p>

    @if (Session.Sheet.CampaignAssets.Count == 0)
    {
        <EmptyState>Nothing put into a shared vehicle or base.</EmptyState>
    }
    else
    {
        <ChosenList>
            @foreach (var contribution in Session.Sheet.CampaignAssets.ToList())
            {
                <ChosenRow Findings="SheetFindings.ForCampaignAssetContribution(Validation, contribution.AssetId)">
                    <Body>@Headline(contribution)</Body>
                    <Actions>
                        @* **The cap is a hint, not a clamp.** min/max on the input keeps the
                           spinner and the browser's own out-of-range styling honest about where
                           the rule sits, but typing or pasting past it is still accepted — the
                           finding above says why it is wrong rather than the box silently
                           rewriting what somebody typed. *@
                        <input type="number" min="0" max="@CampaignAssetContribution.MaxHeroPoints"
                               value="@contribution.HeroPoints" class="units"
                               aria-label="Hero Points"
                               @onchange="e => SetContribution(contribution, contribution with { HeroPoints = Number(e) })" />
                        <button type="button" class="btn small danger"
                                @onclick="() => RemoveContribution(contribution)">Remove</button>
                    </Actions>
                </ChosenRow>
            }
        </ChosenList>
    }

    @* **A contribution to an object the game no longer has, said here and computed nowhere the
       engine can reach.** Answering it needs the campaign, and resolving a campaign id is storage
       — which is why `CampaignAssets.Orphaned` sits beside `CampaignJoin` rather than in the
       validator, and why it says nothing at all when no campaign resolved: a member's browser
       reads no campaign for a game that is perfectly alive, and an orphan reported against that
       null would accuse everybody. Reported and never repaired: the Hero Points are still spent
       and dropping the row would be editing somebody's character to quieten a sentence. *@
    @foreach (var finding in Orphans)
    {
        <p class="small muted spaced" role="status">@finding.Message</p>
    }

    @* **The offer, listing the game's own objects by id.** A contribution keys on the object's
       id, so typing one in by hand is a way of writing down a machine that does not exist —
       which is exactly the state above. The list is the campaign's, read the way a member reads
       anything about their table: their own membership row. *@
    @if (SharedAssets is { Count: > 0 } offered)
    {
        <Field Label="Put Hero Points into one of the game's own">
            <OptionList Placeholder="Filter the shared vehicles and bases">
                @foreach (var asset in offered)
                {
                    <OptionRow Name="@asset.Name" Caveat="@AssetKind(asset)"
                               OnSelect="() => Contribute(asset)" />
                }
            </OptionList>
        </Field>
    }
    else if (Session.Sheet.CampaignId is null)
    {
        <p class="small muted">This character is in no game, so there is nothing shared to put into.</p>
    }
    else if (_reach.Either is not null)
    {
        <p class="small muted">This game has no shared vehicle or base yet.</p>
    }
    else if (_looked)
    {
        <p class="small muted" role="status">The game could not be read just now.</p>
    }

    @* ── Propose one of your own — PROGRESS item 33, rulings 5+6 ─────────────

       The owner's ruling of 2026-09-10: the player holds the object and the GM approves it. The
       Hero Points are charged the moment this is written — the same instant an ordinary
       contribution is — and submitting the character (the existing flow) carries the proposal to
       the GM's own page, where it is a row with Adopt, Adopt with changes, and Refuse. *@
    @if (Session.Sheet.CampaignId is not null)
    {
        <p class="small muted">
            Or build one yourself and present it: the GM can adopt, adopt with changes, or refuse it.
        </p>
        <p class="small muted">It costs your own Hero Points as soon as it is written down.</p>

        @if (_proposal is null)
        {
            <div class="inline spaced">
                <input type="text" placeholder="Name a shared vehicle or base to propose"
                       aria-label="Name a proposal" @bind="_proposing" @bind:event="oninput" />
                <select aria-label="A vehicle or a headquarters" value="@_proposingKind"
                        @onchange="e => _proposingKind = e.Value?.ToString() ?? ProposalVehicle">
                    <option value="@ProposalVehicle">A vehicle</option>
                    <option value="@ProposalHeadquarters">A headquarters</option>
                </select>
                <button type="button" class="btn" aria-label="Propose a shared vehicle or base"
                        disabled="@string.IsNullOrWhiteSpace(_proposing)"
                        @onclick="StartProposal">Propose</button>
            </div>
        }
    }

    @if (_proposal is { } proposal)
    {
        <Field Label="Hero Points on this proposal" For="proposal-hp">
            <input id="proposal-hp" type="number" min="0" max="@CampaignAssetContribution.MaxHeroPoints"
                   value="@_proposalHeroPoints"
                   @onchange="e => _proposalHeroPoints = Number(e)" />
            <span class="muted small">
                @(Session.Costs.CampaignAssetPointsPerHeroPoint(proposal))
                @ProposalCurrency(proposal) per Hero Point spent here.
            </span>
        </Field>

        <SharedAssetEditor IdPrefix="propose" Draft="proposal" DraftChanged="d => _proposal = d"
                           DraftName="_proposalName" DraftNameChanged="@(n => _proposalName = n)"
                           Title="@ProposalTitle" Aside="@ProposalBooks(proposal)"
                           Findings="ProposalFindings(proposal)"
                           OnSave="SaveProposal" OnCancel="CancelProposal"
                           SaveLabel="Propose to the GM" />
    }
</Panel>

<StepButtons Back="build/gear" BackLabel="Gear" Next="build/derived" NextLabel="Derived stats" />

@code {
    /// <summary>Read fresh on every render — see <c>Review.razor</c>'s own <c>Validation</c>.</summary>
    private ValidationResult Validation => Session.Validate();

    /// <summary>
    /// Every line on this page, asked of <c>sheets/</c> rather than built here.
    ///
    /// <para><b>They are methods rather than expressions in the markup for two reasons</b>, and
    /// only one of them is style. The first is that a formatter's name is a type this project
    /// declares, and a guard scans the visible markup for one — a type name that reaches a player
    /// is the app talking about itself. The second is the rule the whole page is written under:
    /// nothing here composes a figure, it only prints one somebody else worked out.</para>
    /// </summary>
    private string Headline(OwnedVehicle vehicle) => AssetFormatter.Describe(vehicle, Session.Costs);

    /// <inheritdoc cref="Headline(OwnedVehicle)"/>
    private static string Ranks(OwnedVehicle vehicle) => AssetFormatter.Characteristics(vehicle);

    /// <inheritdoc cref="Headline(OwnedVehicle)"/>
    private string Headline(OwnedHeadquarters headquarters) =>
        AssetFormatter.Describe(headquarters, Session.Costs);

    /// <inheritdoc cref="Headline(OwnedVehicle)"/>
    private string Headline(BuiltGadget gadget) =>
        AssetFormatter.Describe(gadget, Session.Costs, Session.Sheet.ImmortalityCost);

    /// <inheritdoc cref="Headline(OwnedVehicle)"/>
    private static string Headline(CampaignAssetContribution contribution) =>
        AssetFormatter.Describe(contribution);

    /// <inheritdoc cref="Headline(OwnedVehicle)"/>
    private string FeatureName(SelectedAssetFeature feature, bool onAVehicle) =>
        AssetFormatter.Feature(feature, Session.Rules, onAVehicle);

    /// <inheritdoc cref="Headline(OwnedVehicle)"/>
    private string FeatureLine(OwnedVehicle vehicle) =>
        string.Join(", ", vehicle.Features.Select(f => FeatureName(f, onAVehicle: true)));

    /// <inheritdoc cref="Headline(OwnedVehicle)"/>
    private string FeatureLine(OwnedHeadquarters headquarters) =>
        string.Join(", ", headquarters.Features.Select(f => FeatureName(f, onAVehicle: false)));

    /// <summary>
    /// The three lists this page offers, split out of the markup rather than filtered inline.
    ///
    /// <para><b>A page may not print the name of a type this project declares</b>, and
    /// <c>AssetRowKind</c> in a <c>@@foreach</c> was doing exactly that — a guard scans the markup
    /// for it, because a type name that reaches a player is the app talking about itself.</para>
    /// </summary>
    private IEnumerable<AssetCatalogueRow> VehicleFeatureRows =>
        Session.Assets.Rows.Where(r => r.Kind == AssetRowKind.VehicleFeature);

    /// <inheritdoc cref="VehicleFeatureRows"/>
    private IEnumerable<AssetCatalogueRow> StockVehicleRows =>
        Session.Assets.Rows.Where(r => r.Kind == AssetRowKind.StockVehicle);

    /// <inheritdoc cref="VehicleFeatureRows"/>
    private IEnumerable<AssetCatalogueRow> BaseFeatureRows =>
        Session.Assets.Rows.Where(r => r.Kind == AssetRowKind.BaseFeature);

    private GadgetPrerequisites Prerequisites =>
        Session.Rules.Gadgets.Entries.Single(e => e.Id == "gadget_prerequisites").Prerequisites!;

    private string _newVehicle = "";
    private string _newBase = "";
    private string _newGadget = "";

    private OwnedVehicle? _vehicle;
    private OwnedHeadquarters? _base;
    private BuiltGadget? _gadget;

    /// <summary>
    /// What the row lists hold when the reader arrives from the command palette — the row's
    /// <em>name</em>, so the box shows why the list is short.
    ///
    /// <para>Taken rather than peeked, exactly as the Gear step takes its own: one consumer, and a
    /// request left set would drag the list back to that row every time anything else on this page
    /// re-rendered, over whatever the reader had gone on to type.</para>
    /// </summary>
    private string? _rowQuery;

    /// <summary>
    /// The game this character is in, read whichever way this account can read it — the account's
    /// own campaign for a GM, the live table through a membership row for a player.
    ///
    /// <para><b>Read once, when the step opens.</b> A shared object is the GM's to change and a
    /// member is here to record what they put in; re-reading it per render would be a request per
    /// keystroke on a page full of number boxes, which is the read-per-letter the character
    /// manager's own split exists to avoid.</para>
    /// </summary>
    private CampaignReach _reach;

    /// <summary>
    /// Whether the read above has happened, so "the game could not be read" is only ever said
    /// about a read that finished. Before it, the offer is simply not drawn — the same rule the
    /// campaigns page's live panel follows on a first render.
    /// </summary>
    private bool _looked;

    /// <summary>The game's own shared objects, or none when there is no game to read.</summary>
    private IReadOnlyList<CampaignAsset> SharedAssets => CampaignAsset.On(_reach.Either);

    /// <summary>
    /// What this character has put into an object its game does not have. Empty for a character
    /// in no game and for one whose table could not be read — see <c>CampaignAssets.Orphaned</c>,
    /// which is where the reason that is not an oversight is written down.
    /// </summary>
    private IReadOnlyList<CampaignFinding> Orphans =>
        CampaignAssets.Orphaned(Session.Sheet, _reach.Either);

    /// <inheritdoc cref="Headline(OwnedVehicle)"/>
    private static string AssetKind(CampaignAsset asset) => AssetFormatter.Describe(asset);

    protected override async Task OnInitializedAsync()
    {
        if (Commands.TakeRequestedAssetRow() is { } rowId && Session.Assets.Find(rowId) is { } row)
        {
            _rowQuery = row.Name;

            // A row lands on the thing it belongs to, open and ready. Without this the reader
            // arrives at a page of four panels with a filtered list inside one of them that they
            // cannot see, which reads as the palette having done nothing.
            if (row.Kind == AssetRowKind.BaseFeature) _base ??= Session.Sheet.Headquarters.FirstOrDefault();
            else _vehicle ??= Session.Sheet.Vehicles.FirstOrDefault();
        }

        // **Nothing is asked for a character in no game**, which is most of them and every one
        // belonging to somebody not signed in. Both reads below are round trips; a step that made
        // them unconditionally would charge every reader of this page for a panel that would then
        // say there is no game.
        if (Session.Sheet.CampaignId is null) return;

        _reach = await CampaignReaches.ForAsync(
            Campaigns, Memberships, Session.Sheet, await Memberships.MineAsync());

        _looked = true;
    }

    // ── Vehicles ──────────────────────────────────────────────────────────

    private void AddVehicle()
    {
        if (string.IsNullOrWhiteSpace(_newVehicle)) return;

        var machine = new OwnedVehicle(_newVehicle.Trim());
        Session.Sheet.Vehicles.Add(machine);
        _newVehicle = "";
        _vehicle = machine;
        Session.NotifyChanged();
    }

    private void RemoveVehicle(OwnedVehicle machine)
    {
        Session.Sheet.Vehicles.Remove(machine);
        if (ReferenceEquals(_vehicle, machine)) _vehicle = null;
        Session.NotifyChanged();
    }

    private void SetVehicle(OwnedVehicle old, OwnedVehicle updated)
    {
        var index = Session.Sheet.Vehicles.IndexOf(old);
        if (index < 0) return;

        Session.Sheet.Vehicles[index] = updated;
        _vehicle = updated;
        Session.NotifyChanged();
    }

    /// <summary>
    /// A feature goes on at its cheapest grade, because <c>CostCalculator</c> throws rather than
    /// guessing one — the same answer the Gear step gives, and the cheapest is the honest default.
    /// </summary>
    private void AddVehicleFeature(OwnedVehicle machine, AssetCatalogueRow row)
    {
        var id = row.Id[AssetCatalogue.VehicleFeaturePrefix.Length..];
        if (machine.Features.Any(f => f.FeatureId == id)) return;

        SetVehicle(machine, machine with
        {
            Features = [.. machine.Features, new SelectedAssetFeature(id) { GradeKey = CheapestGrade(row) }]
        });
    }

    private void SetVehicleFeature(OwnedVehicle machine, SelectedAssetFeature old, SelectedAssetFeature? updated) =>
        SetVehicle(machine, machine with { Features = Replace(machine.Features, old, updated) });

    /// <summary>
    /// One of p.96's six stock machines, copied onto the vehicle being edited.
    ///
    /// <para><b>Copied, and then it is this character's machine.</b> Nothing records which stock
    /// row it came from: the page prints stock vehicles as worked examples with their totals, and
    /// a field saying "this started as a Speedboat" would be a fact about how somebody worked
    /// rather than about the thing they built. The name is left alone for the same reason.</para>
    ///
    /// <para>Which printed feature lines can be copied, and why "Rader (Sonar)" is not one of
    /// them, is <see cref="AssetCatalogue.CopyableFeatures"/>'s answer — the same one the terminal
    /// wizard gets, because this screen used to carry its own copy of that reading and so did
    /// that step.</para>
    /// </summary>
    private void CopyStock(OwnedVehicle machine, AssetCatalogueRow row)
    {
        if (row.Stock is not { } stock) return;

        SetVehicle(machine, machine with
        {
            Body = stock.Body,
            Speed = stock.Speed,
            Control = stock.Control,
            Weapons = stock.Weapons,
            Features = Session.Assets.CopyableFeatures(stock)
        });
    }

    // ── Headquarters ──────────────────────────────────────────────────────

    private void AddBase()
    {
        if (string.IsNullOrWhiteSpace(_newBase)) return;

        var house = new OwnedHeadquarters(_newBase.Trim());
        Session.Sheet.Headquarters.Add(house);
        _newBase = "";
        _base = house;
        Session.NotifyChanged();
    }

    private void RemoveBase(OwnedHeadquarters house)
    {
        Session.Sheet.Headquarters.Remove(house);
        if (ReferenceEquals(_base, house)) _base = null;
        Session.NotifyChanged();
    }

    private void SetBase(OwnedHeadquarters old, OwnedHeadquarters updated)
    {
        var index = Session.Sheet.Headquarters.IndexOf(old);
        if (index < 0) return;

        Session.Sheet.Headquarters[index] = updated;
        _base = updated;
        Session.NotifyChanged();
    }

    private void AddBaseFeature(OwnedHeadquarters house, AssetCatalogueRow row)
    {
        var id = row.Id[AssetCatalogue.BaseFeaturePrefix.Length..];
        if (house.Features.Any(f => f.FeatureId == id)) return;

