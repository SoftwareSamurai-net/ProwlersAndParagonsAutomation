@page "/admin/portfolio/replay"
@inject ReplayLoader Loader

<PageTitle>Recorded conversations — Prowlers &amp; Paragons</PageTitle>

<h1>Watch one being built</h1>

<AdminOnly Title="One moment">

@* "a costed character back" rather than "a legal one": one of these is a Villain, who is
   over the tier's points and is meant to be, because Ch.9 gives a Villain no budget. The page
   that plays him declines to call him legal, so this one must not promise it. *@
<RecordingsIntro Class="muted" />

@if (_library is null)
{
    <Panel Title="One moment" NoPrint="true">
        <p>Looking…</p>
    </Panel>
}
else
{
    @if (_library.Problem is not null)
    {
        <Panel Title="The recordings did not load" NoPrint="true">
            <p class="small">Nothing else is affected. What went wrong: @_library.Problem</p>
        </Panel>
    }

    <div class="grid replay-list">
        @foreach (var conversation in _library.Conversations)
        {
            <Panel Title="@conversation.Title" NoPrint="true">
                <Head>
                    @if (conversation.Villain)
                    {
                        <span class="tag warn">Villain</span>
                    }
                </Head>
                <ChildContent>
                    <p class="small muted">@conversation.Blurb</p>
                    <NavLink class="btn primary" href="@($"admin/portfolio/replay/{conversation.Id}")">
                        Play it
                    </NavLink>
                </ChildContent>
            </Panel>
        }
    </div>
}

<Panel Title="Why these are recordings and not a conversation you can have" NoPrint="true">
    @* **The reason this site does not answer you back is a hosting bill, and it used to say
       so on the screen** — three clauses about who pays for the model, ending "no accounts,
       no server, nothing that costs anything to run", which had also stopped being true. A
       reader wants to know whether they can type at it. They can't; that is the whole answer,
       and the second paragraph is the useful half. *@
    <p class="small">This page cannot answer you back.</p>
    <p class="small">
        You <em>can</em> have it live: the same rules engine ships as a small program you
        connect to your own Claude.
    </p>
</Panel>
</AdminOnly>

@code {
    private ReplayLibrary? _library;

    protected override async Task OnInitializedAsync() => _library = await Loader.LoadAsync();
}
