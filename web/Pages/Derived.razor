@page "/build/derived"
@inject CharacterSession Session
@inject AccountCampaignStore Campaigns
@inject ApiMembershipStore Memberships

<PageTitle>Derived stats — Prowlers &amp; Paragons</PageTitle>

<h1>Derived stats</h1>
<p class="muted">Nothing here is bought — all three follow from the sheet.</p>

@* **No panel around these.** Each of the four figures is already a ruled box, so a bordered
   panel holding them was a box drawn around four boxes, carrying no heading and separating
   nothing from anything. The panel is what a *section* looks like; these are the section. *@
<DerivedStatBlocks WithFormulas="true" />

@* The rule for each figure is printed under the figure itself. What is left here is the
   *working* — this character's own ranks, and the three details that are easy to get wrong
   — which is the half a one-line rule cannot carry. Before this the two said the same thing
   twice on the same screen, the panel's copy being the longer and better one. *@
<Panel Title="How these came out">
    <h3>Edge</h3>
    

    @* The working, with the numbers actually used. This list showed Perception even when
       Danger Sense had replaced it, so the figures on the page added up to something other
       than the Edge printed above them, and there was no way to see why. *@
    <ul class="small muted">
        @if (DangerSenseRank is { } danger)
        {
            <li>Danger Sense @(danger)d stands in for Perception @Session.Sheet.GetAbilityRank("perception")d.</li>
        }
        else
        {
            <li>Perception @Session.Sheet.GetAbilityRank("perception")d.</li>
        }
        <li>The better of Agility @Session.Sheet.GetAbilityRank("agility")d and Intellect @Session.Sheet.GetAbilityRank("intellect")d.</li>
        @if (Session.Sheet.HasPower("lightning_reflexes"))
        {
            <li>Lightning Reflexes adds a flat +@DerivedStatsCalculator.LightningReflexesEdgeBonus.</li>
        }
        @if (Session.Sheet.HasPower("super_speed"))
        {
            <li>Super Speed sets a floor of its rank × 3.</li>
        }
    </ul>

    <h3>Health</h3>
    <p class="small">Halves round up.</p>
    <p class="small muted">
        Toughness @Session.Sheet.GetAbilityRank("toughness")d,
        Might @Session.Sheet.GetAbilityRank("might")d,
        Willpower @Session.Sheet.GetAbilityRank("willpower")d
    </p>

    <h3>Resolve</h3>
    <p class="small">
        Determination: @DerivedStatsCalculator.DeterminationHpPerResolve Hero Points a point.
    </p>
    <ul class="small muted">
        <li>
            Trait Cap @(Session.TraitCap)d.
            @* **Neutral about which way it moved, deliberately.** This used to read "caps tighter
               than its tier's", which `Session.TraitCapIsNotTheTiers` cannot tell: a cap above the
               tier's is an error the validator reports as `TRAIT_CAP_ABOVE_TIER`, and it is
               reported and still used — so this line really can be drawn over a looser cap, saying
               the opposite of what is on screen. What is true in both directions is that the house
               cap is the one in force. *@
            @if (Session.TraitCapIsNotTheTiers)
            {
                @: Not the tier's @(Session.TierTraitCap)d — this game's cap is the one Resolve is measured from.
            }
        </li>
        <li>@Plural(ResolveFlaws, "Condition or Plot Hook flaw", "Condition or Plot Hook flaws").</li>
        @if (DeterminationResolve > 0)
        {
            <li>Determination, bought for @DeterminationResolve more.</li>
        }
    </ul>

    @* **Only when a base grants it** — the same rule the exports and the terminal wizard follow:
       a "Teamwork: 0" line on every sheet in the game is a figure nobody has. Teamwork is
       Resolve's twin (Ch.6 p.103) and is quoted for a Hero only, which this page has no way to
       enforce and does not try to — see `DerivedStatsCalculator.CalculateTeamwork`'s own doc
       comment for why that silence is kept by whoever is reading, not by a flag in the engine. *@
    @if (Teamwork > 0)
    {
        <h3>Teamwork</h3>
        <p class="small muted">
            @Teamwork at the start of each issue, for a Hero — a headquarters with
            Training Facilities (p.103), owned or shared with this campaign.
        </p>
    }
</Panel>

<StepButtons Back="build/gear" BackLabel="Gear" Next="build/finishing" NextLabel="Finishing touches" />

@code {
    private int ResolveFlaws => Session.Sheet.Flaws.Count(IsResolveFlaw);

    private bool IsResolveFlaw(SelectedFlaw sf) =>
        Session.Rules.GetFlaw(sf.FlawId)?.FlawType is "condition" or "plot_hook" or "plot_hook_and_condition";

    /// <summary>Danger Sense's effective rank when it is on the sheet, else null.</summary>
    private int? DangerSenseRank =>
        Session.Sheet.SelectedPowers.FirstOrDefault(sp => sp.PowerId == "danger_sense") is { } ds
            ? Session.Derived.GetEffectiveRank(ds, Session.Sheet)
            : null;

    private int DeterminationResolve =>
        Session.Sheet.SelectedPowers.FirstOrDefault(sp => sp.PowerId == "determination")?.Units ?? 0;

    /// <summary>"1 flaw", "2 flaws". Never "flaw(s)", which is a form field, not a sentence.</summary>
    private static string Plural(int count, string one, string many) =>
        $"{count} {(count == 1 ? one : many)}";

    // ── Teamwork, from the campaign's shared bases — PROGRESS.md item 33.4 ────────────────

    /// <summary>
    /// The campaign's shared bases this character may count, resolved once when the step opens —
    /// the same read <c>Assets.razor</c> makes for the same reason: a page full of derived figures
    /// re-reading a live campaign on every render would be a request per keystroke on whatever
    /// this step redraws for.
    /// </summary>
    private IReadOnlyList<CampaignAsset> _sharedBases = [];

    private int Teamwork => Session.Derived.CalculateTeamwork(Session.Sheet, _sharedBases);

    protected override async Task OnInitializedAsync()
    {
        // Nothing is asked for a character in no game, which is most of them — see
        // `Assets.razor`'s own copy of this guard.
        if (Session.Sheet.CampaignId is null) return;

        var playing = await Memberships.MineAsync();
        var reach = await CampaignReaches.ForAsync(Campaigns, Memberships, Session.Sheet, playing);

        _sharedBases = CampaignAssets.TeamworkBases(reach, playing, Session.Sheet.CampaignId);
    }
}
