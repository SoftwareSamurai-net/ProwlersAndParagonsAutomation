@page "/review"
@implements IDisposable
@inject CharacterSession Session
@inject IJSRuntime Js

@* The character's name leads the title because the browser prints the document title in
   its own page header, which is the one thing that reliably repeats on every printed page.
   That is what identifies page three of a sheet lying face-up on a table — so an unnamed
   character says so rather than falling back to the name of the step. *@
<PageTitle>@(string.IsNullOrWhiteSpace(Session.Sheet.Name) ? "Unnamed character" : Session.Sheet.Name) — Prowlers &amp; Paragons</PageTitle>

<h1>GM review</h1>

<Panel Title="Checks against the rules" NoPrint="true">
    <Head>
        <span class="verdict @(Validation.IsValid ? "" : "invalid")">
            @(Validation.IsValid ? "Legal" : "Not legal yet")
        </span>
    </Head>
    <ChildContent>
        @if (Issues.Count == 0)
        {
            <p class="small muted">Nothing to report — this character is ready to play.</p>
        }
        else
        {
            <ul class="issues">
                @foreach (var issue in Issues)
                {
                    <li class="@(issue.Severity == ValidationSeverity.Error ? "error" : "warning")">
                        @issue.Message
                    </li>
                }
            </ul>
        }

        @if (!Session.ShowBudget)
        {
            <p class="small muted">
                Villain mode: Ch.9 gives Villains no Hero Point budget, so anything about
                the budget is left out here. Everything else — Trait Caps, flaw counts,
                selections that still need an answer — still applies, because a Villain is
                built by exactly the same rules.
            </p>
        }
    </ChildContent>
</Panel>

<Panel Title="Take it away" NoPrint="true">
    <div class="inline">
        <button type="button" class="btn primary" @onclick="Print">Print this sheet</button>
        <button type="button" class="btn" @onclick="DownloadText">Download as text</button>
        <button type="button" class="btn" @onclick="DownloadJson">Download as data</button>
    </div>
    @* The web address, the date and the page number across the top of a printed page are
       the browser's own furniture, not part of the sheet — and no page can turn them off,
       because the setting belongs to the person printing. Saying where the switch is takes
       one line and is the difference between a sheet you would hand someone and one you
       would not. *@
    <p class="small muted spaced">
        Printing gives you the sheet below on one page, or as a PDF if you pick
        <b>Save as PDF</b> as the destination. In the print dialogue, open
        <b>More settings</b> and turn <b>Headers and footers</b> off — that is what puts the
        web address and the date across the top of the page, and it is a browser setting
        rather than part of the sheet.
    </p>
    <p class="small muted">
        The text file is the same character for pasting into notes; the data file is for
        other tools, and records every check above with its reference code.
    </p>
</Panel>

<SheetView />

<StepButtons Back="finishing" BackLabel="Finishing touches" />

@code {
    /// <summary>
    /// This page reads the sheet on every render but never changes it, so it is easy to
    /// miss that it still has to redraw: switching to Villain mode from here hid the budget
    /// bar in the shell and left an over-budget finding sitting on this list, with the
    /// explanation of why budget findings are hidden not shown.
    /// </summary>
    protected override void OnInitialized() => Session.Changed += StateHasChanged;

    public void Dispose() => Session.Changed -= StateHasChanged;

    private ValidationResult Validation => Session.Validate();

    /// <summary>
    /// Budget findings are hidden in Villain mode because a Villain has no budget to
    /// exceed. This filters the display and nothing else — the validator is not told
    /// about the mode, so the rules stay in one place and the JSON export still records
    /// every issue.
    /// </summary>
    private List<ValidationIssue> Issues =>
        Validation.Issues
            .Where(i => Session.ShowBudget || i.Code != "HP_BUDGET_EXCEEDED")
            .ToList();

    private Task Print() => Js.InvokeVoidAsync("print").AsTask();

    private Task DownloadText() =>
        Download(".txt", "text/plain;charset=utf-8", CharacterSheetRenderer.RenderText);

    private Task DownloadJson() =>
        Download(".json", "application/json;charset=utf-8", CharacterSheetRenderer.RenderJson);

    private delegate string Render(
        CharacterSheet sheet, RulesRepository rules, CostCalculator costs,
        DerivedStatsCalculator derived, ValidationResult validation, DateTime generatedAt);

    /// <summary>
    /// One timestamp for both the file name and the document, so the two agree — the CLI's
    /// exporter stamps them together for the same reason.
    /// </summary>
    private Task Download(string extension, string mimeType, Render render)
    {
        var generatedAt = DateTime.Now;
        var name = CharacterSheetRenderer.BaseFileName(Session.Sheet, generatedAt) + extension;
        var body = render(Session.Sheet, Session.Rules, Session.Costs, Session.Derived, Validation, generatedAt);

        return Js.InvokeVoidAsync("ppDownload", name, mimeType, body).AsTask();
    }
}
