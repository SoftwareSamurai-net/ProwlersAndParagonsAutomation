@page "/campaign/{Id}"
@inject CharacterSession Session
@inject AccountCampaignStore Store
@inject ApiMembershipStore Memberships

@* What is waiting for a decision in one campaign, and the diff each request amounts to.

   **Whole snapshots, never one field.** Approve replaces the campaign's clone with the snapshot;
   Reject leaves the clone exactly as it was. There is deliberately no way to apply one row of the
   diff: partial application is a merge algorithm for characters, which is a second engine capable
   of producing a sheet neither person authored.

   **The decision carries the version it was made about.** Read a snapshot, have the player
   resubmit while it is on screen, press Approve, and without that version the second snapshot —
   which nobody has looked at — becomes the clone. A mismatch is refused, and the refusal brings
   the newer one back so the diff redraws rather than sending somebody to look again.

   **The diff says how much it compared.** A diff showing nothing and a diff that failed to run
   look identical, and "nothing changed" is the commonest honest answer this screen gives — so the
   count of fields examined is printed beside it. See `CampaignDiff`.

   **Nothing here repairs anything.** An illegal snapshot is reported and approved or turned down
   as it stands; a tier that disagrees with the campaign's is information rather than an error,
   because these campaigns climb tiers in play. *@

<PageTitle>@Title — Prowlers &amp; Paragons</PageTitle>

<h1>@Title</h1>

@if (_state == Reading.NotSignedIn)
{
    <Panel Title="An account keeps a campaign">
        <p><a href="signin">Sign in</a> to see what is waiting for you.</p>
    </Panel>
}
else if (_state == Reading.NotYours)
{
    <Panel Title="Not this campaign">
        <p>Nothing is wrong — there is simply no game here for this account.</p>
        <p><a href="campaign">Back to your campaigns</a></p>
    </Panel>
}
else if (_state == Reading.Looking)
{
    <Panel Title="One moment">
        <p>Looking…</p>
    </Panel>
}
else
{
    @* **The roster, and it was a queue until this screen could show a settled sheet.** The list
       has always held every membership of this campaign rather than only the pending ones — but
       the only thing it would open was a diff, so a character approved in March was unreadable
       here until somebody changed it. The pending count is in the aside; the list is who is in
       the game. *@
    <Panel Title="Your players" Aside="@WaitingAside">
        @if (_waiting.Count == 0)
        {
            <EmptyState>Nobody has joined yet. Read this campaign's join code out to a player.</EmptyState>
        }
        else
        {
            <ul class="campaign-list">
                @foreach (var one in _waiting)
                {
                    <li>
                        <div class="campaign-row">
                            <span class="who">
                                <b class="nm">@one.Label</b>
                                <span class="meta">@Standings.Say(one.Standing)</span>

                                @* **The same sentence one level out, where a GM reads first.**
                                   Opening the row has said this since the slice that added it —
                                   but the roster said "Approved" beside the character's name over
                                   a game holding an unnamed sheet with every Trait at 0d, which
                                   is the state the owner was shown and the state nobody scanning
                                   a list would open. See `EmptySubmissions`. *@
                                @if (_empty.Contains(one.Id))
                                {
                                    <span class="meta">@EmptySubmissions.Marker</span>
                                }
                            </span>

                            @* **One control, and its word says which of the two things pressing
                               it will show.** A GM with nothing to decide is not reading changes,
                               and labelling it as though they were describes this screen's
                               internals rather than answering the reader. *@
                            <button type="button" class="btn small"
                                    aria-expanded="@(_reading == one.Id ? "true" : "false")"
                                    @onclick="() => Look(one.Id)">
                                @(_reading == one.Id ? "Close"
                                    : one.HasPending ? "Read the changes" : "View sheet")
                            </button>

                            @* Two presses, for the reason the player's own Leave records: the
                               clone goes with the row and there is no undo behind it. *@
                            @if (_removing == one.Id)
                            {
                                <button type="button" class="btn small"
                                        @onclick="() => Remove(one.Id)">Remove for good</button>
                                <button type="button" class="btn small quiet"
                                        @onclick="() => _removing = null">Cancel</button>
                            }
                            else
                            {
                                <button type="button" class="btn small quiet"
                                        @onclick="() => _removing = one.Id">Remove</button>
                            }
                        </div>

                        @if (_reading == one.Id)
                        {
                            <div class="campaign-diff">
                                @* **Seven answers, and none of them may be drawn as another.** The
                                   two this screen has got wrong before are the two that read as
                                   emptiness: a payload this build cannot open is not "nothing is
                                   here", and a member who has never sent anything is not a member
                                   whose sheet failed to load. Each arm says which it is. *@
                                @if (_showing is Showing.Asking)
                                {
                                    <p>Looking…</p>
                                }
                                else if (_showing is Showing.Unreachable)
                                {
                                    <EmptyState>
                                        This could not be read just now. Try again in a moment.
                                    </EmptyState>
                                }
                                else if (_showing is Showing.NothingSent)
                                {
                                    <EmptyState>
                                        Nothing has been sent for this character yet, so the
                                        campaign holds no sheet for it.
                                    </EmptyState>
                                }
                                else if (_showing is Showing.PendingUnreadable)
                                {
                                    @* **Not "nothing is waiting."** A snapshot is there and this
                                       build cannot open it — the same fault PROGRESS.md finding 8
                                       records on the decision path, which told a GM the queue was
                                       empty about a request a player was waiting on. *@
                                    <EmptyState>
                                        Changes are waiting here and this version of the app cannot
                                        open them. Reload before deciding.
                                    </EmptyState>
                                }
                                else if (_showing is Showing.CloneUnreadable)
                                {
                                    <EmptyState>
                                        The campaign holds a sheet for this character that this
                                        version of the app cannot open. Reload and try again.
                                    </EmptyState>
                                }
                                else if (_showing is Showing.Settled && _approved is { } settled)
                                {
                                    @* **An empty clone is said out loud, above the sheet.** A
                                       campaign can be holding a snapshot with nothing on it —
                                       the tier, the campaign's id and its house Trait Cap, which
                                       is all `CampaignJoin.Apply` copies in — and drawn as a
                                       character that is an unnamed sheet with every Trait at 0d,
                                       Resolve 20 and no Hero Points spent. That is what the owner
                                       was shown over a player who holds a fully statted character
                                       under exactly the id this row names.

                                       **The screen may not render it as the character.** It is
                                       the same rule the two unreadable arms above follow: a state
                                       that reads as emptiness is not the same as nothing being
                                       here, and the reader is owed which one it is. The sheet is
                                       still drawn beneath, because hiding it would leave a GM
                                       unable to see what they are being told about — and nothing
                                       is repaired, because the remedy is the player resubmitting
                                       and the clone is not this screen's to rewrite. *@
                                    @if (Session.HasNothingOnIt(settled))
                                    {
                                        <p class="small muted" role="status">
                                            The submission was empty — ask the player to resubmit.
                                        </p>
                                    }

                                    @* **Drawn rather than put behind a second press.** Nothing is
                                       being decided here, so the sheet is not evidence supporting
                                       a decision — it is the whole of what was asked for. *@
                                    <SheetView Character="settled" ShowBudget="_approvedHasBudget" />
                                }
                                else if (_showing is Showing.Changes && _diff is { } diff)
                                {
                                    @* The same sentence one slot earlier, and the more useful of
                                       the two: a GM told this before pressing Approve does not
                                       make an empty sheet the campaign's clone in the first
                                       place. Refused nowhere — approving it is still the GM's to
                                       do, because a decision about somebody's character is not
                                       this screen's to take. *@
                                    @if (_pending is { } waiting && Session.HasNothingOnIt(waiting))
                                    {
                                        <p class="small muted" role="status">
                                            The submission was empty — ask the player to resubmit.
                                        </p>
                                    }

                                    @* **Led by the spend, because that is what a GM decides on** —
                                       and both figures are the engine's answers for the two sheets
                                       rather than anything read out of a payload or worked out
                                       here. *@
                                    <p class="diff-spend">@Spend(diff)</p>

                                    @if (!diff.Ran)
                                    {
                                        <EmptyState>
                                            These changes could not be compared. Read the full sheet below instead.
                                        </EmptyState>
                                    }
                                    else if (!diff.Explained)
                                    {
                                        @* The spend moved and no row says why, which is a defect in
                                           this screen rather than a state of the character — so it
                                           says so, instead of drawing the empty list that reads as
                                           agreement. See PROGRESS.md item 19. *@
                                        <EmptyState>
                                            The Hero Point total changed, but this comparison cannot say
                                            what moved. Read the full sheet below before deciding.
                                        </EmptyState>
                                    }
                                    else if (diff.Unchanged)
                                    {
                                        @* The count is what tells a reader this ran. Without it an
                                           empty list is indistinguishable from a comparison that
                                           never happened. *@
                                        <EmptyState>
                                            Nothing changed — @diff.Compared fields compared. Approve to record it anyway.
                                        </EmptyState>
                                    }
                                    else
                                    {
                                        <ul class="diff-rows">
                                            @foreach (var row in diff.Rows)
                                            {
                                                <li>
                                                    <span class="what">@row.What</span>
                                                    <span class="was">@Was(row)</span>
                                                </li>
                                            }
                                        </ul>
                                        <p class="small muted">@diff.Compared fields compared.</p>
                                    }

                                    @if (_full)
                                    {
                                        <SheetView Character="_pending" ShowBudget="_pendingHasBudget" />
                                    }

                                    <div class="inline spaced">
                                        <button type="button" class="btn primary"
                                                @onclick="() => Decide(one.Id, approve: true)">Approve</button>
                                        <button type="button" class="btn"
                                                @onclick="() => Decide(one.Id, approve: false)">Reject</button>
                                        <button type="button" class="btn quiet"
                                                aria-pressed="@(_full ? "true" : "false")"
                                                @onclick="() => _full = !_full">
                                            @(_full ? "Hide the full sheet" : "Open the full sheet")
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    @* **A final arm, so that no state opens an empty box.** Every
                                       value above has one; this catches an eighth added without,
                                       which would otherwise open a panel saying nothing at all —
                                       the failure every branch here exists to refuse. *@
                                    <EmptyState>
                                        This cannot be shown here. Reload and try again.
                                    </EmptyState>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        }

        @* **Outside the open request, because half the messages close it.** Approving, turning
           down, and both refusals set `_reading` to null — so while this sat inside
           `@@if (_reading == one.Id …)` every one of those sentences was written and then thrown
           away unrendered, and a GM who pressed Approve watched the panel collapse and was told
           nothing at all. Only the one branch that keeps the request open could ever be read,
           which is why the stale-approval test passed and nothing else noticed.

           It is also the right place for `role="status"`: a live region that is destroyed and
           rebuilt around each message is a live region a screen reader may never announce. *@
        @if (_said is { } said)
        {
            <p class="small muted spaced" role="status">@said</p>
        }
    </Panel>

    @* ── The game's own vehicles and bases ─────────────────────────────────────

       **Ch.6 pp.96 and 100 both let a team pool their allowances on one object, and a character
       is one character** — so a pooled machine recorded on a sheet is either unrepresentable or
       copied across five sheets with five chances to disagree. It is written down once, on the
       game; what each member's sheet carries is the Hero Points they put in. The budget here is
       the sum of those, in the object's own second currency.

       **It is on this screen rather than beside the game's other settings because this is the
       only screen that has read the members' sheets.** A budget summed from five clones cannot be
       drawn where the clones are not, and the clones are what the roster above already opens. *@
    <Panel Title="Shared vehicles and bases" Aside="@SharedAside">
        <p class="small muted">
            A team can pool their allowances on one object (Ch.6, pp.96 and 100). Each player
            records what they put in on their own sheet.
        </p>

        @if (_campaign is null)
        {
            <p class="small muted" role="status">
                This game's own settings could not be read just now, so nothing shared can be shown.
            </p>
        }
        else if (_ledger.Count == 0 && _rosterRead)
        {
            <EmptyState>Nothing shared yet. Name a vehicle or a base for the table to pool into.</EmptyState>
        }
        else if (_ledger.Count == 0)
        {
            <p class="small muted" role="status">@RosterUnread</p>
        }
        else
        {
            @* **A failed read of the players is not a game that owns nothing**, and it is not a
               game whose objects are all over budget either. The objects came out of the
               campaign's own payload, which this screen read separately and has; what is missing
               is the clones the budget is summed from. So they are named and the sums are not. *@
            @if (!_rosterRead)
            {
                <p class="small muted" role="status">@RosterUnread</p>
            }

            <ChosenList>
                @foreach (var line in _ledger)
                {
                    @* **The findings go through the row's own slot**, which is where every other
                       list in this app puts them: it leads with the word Error or Warning and
                       differs in style as well as in colour, because a colour difference alone
                       fails WCAG 1.4.1 — see `RowFinding`. A sentence hand-drawn into the body
                       would be the same information with that half taken off it. *@
                    <ChosenRow Findings="line.Findings">
                        <Body>
                            <b>@(_rosterRead ? Books(line) : Named(line.Asset))</b>
                            <span class="muted small"><br />@Kind(line.Asset)</span>

                            @if (line.Asset.Features.Count > 0)
                            {
                                <span class="muted small"><br />@Features(line.Asset)</span>
                            }

                            @* **Who paid, largest first**, which is the question a GM has about a
                               shared object — and the one thing on this screen that no single
                               player's sheet can answer. *@
                            @if (_rosterRead)
                            {
                                <span class="muted small"><br />@Funders(line)</span>

                                @* **Reported, and never repaired.** The remedy is somebody putting
                                   more in or the object losing a feature, and both are decisions
                                   about this table's game rather than arithmetic to do on their
                                   behalf. *@
                                @if (line.IsOverBudget)
                                {
                                    <span class="muted small"><br />@OverBudget</span>
                                }

                                @* Not the same sentence, and it must never be drawn as the one
                                   above: an object with no price is not an object over its
                                   budget. *@
                                @if (line.Spent is null)
                                {
                                    <span class="muted small"><br />@Unpriceable</span>
                                }
                            }

                        </Body>
                        <Actions>
                            <button type="button" class="btn small"
                                    disabled="@(_draft is not null)"
                                    @onclick="() => EditAsset(line.Asset)">Edit</button>

                            @* **Two presses**, for the reason removing a player takes two: every
                               member who put into this is holding its id as the record of what
                               they paid for, and there is no undo behind the button. *@
                            @if (_dropping == line.Asset.Id)
                            {
                                <button type="button" class="btn small danger"
                                        @onclick="() => DropAsset(line.Asset)">Remove for good</button>
                                <button type="button" class="btn small quiet"
                                        @onclick="() => _dropping = null">Cancel</button>
                            }
                            else
                            {
                                <button type="button" class="btn small quiet"
                                        @onclick="() => _dropping = line.Asset.Id">Remove</button>
                            }
                        </Actions>
                    </ChosenRow>
                }
            </ChosenList>

            <p class="small muted">
                Removing one leaves every member's Hero Points exactly where they are, and their
                own sheet says the object is not here any more.
            </p>
        }

        @* **The kind is chosen as the object is named, and never afterwards.** A vehicle and a
           base are bought in different currencies off different tables, so a kind that changed
           later would strand every feature already on it — and every member's contribution copied
           the kind when they backed it. *@
        @if (_campaign is not null)
        {
            <div class="inline spaced">
                <input type="text" placeholder="Name one the table can pool into"
                       aria-label="Name a shared vehicle or base"
                       @bind="_naming" @bind:event="oninput" />
                <select aria-label="A vehicle or a headquarters" value="@_namingKind"
                        @onchange="e => _namingKind = e.Value?.ToString() ?? Vehicle">
                    <option value="@Vehicle">A vehicle</option>
                    <option value="@Headquarters">A headquarters</option>
                </select>
                <button type="button" class="btn" aria-label="Add a shared vehicle or base"
                        disabled="@(string.IsNullOrWhiteSpace(_naming) || _draft is not null)"
                        @onclick="StartAsset">Add</button>
            </div>

            @* **One slot, so a second press has to be refused rather than swapping the draft out
               from under whoever is mid-edit.** `StartAsset` and `EditAsset` used to replace
               `_draft` silently; disabling both while one is open, and saying why, is the fix. *@
            @if (_draft is not null)
            {
                <p class="small muted">Finish or cancel the open draft first.</p>
            }
        }

        @* Outside the editor, because saving closes it — the fault this screen already records
           about every sentence it wrote inside a panel that the same press destroyed. *@
        @if (_saidAboutAsset is { } aboutAsset)
        {
            <p class="small muted spaced" role="status">@aboutAsset</p>
        }
    </Panel>

    @if (_draft is { } draft)
    {
        <Panel Class="machine" Title="@DraftTitle" Aside="@DraftBooks(draft)">
            @* p.96 opens Body, Speed and Control at nothing and gives Weapons no starting value
               at all, so a shared machine costs what it is — exactly as one character's own does,
               and priced by the same calculation. *@
            <Field Label="Name" For="shared-name">
                <input id="shared-name" type="text" maxlength="80"
                       @bind="_draftName" @bind:event="oninput" />
            </Field>

            @if (!draft.IsHeadquarters)
            {
                <VehicleRanksNote />

                <Field Label="Body" For="shared-body">
                    <input id="shared-body" type="number" min="0" value="@draft.Body"
                           @onchange="e => SetDraft(draft with { Body = Number(e) })" />
                </Field>
                <Field Label="Speed" For="shared-speed">
                    <input id="shared-speed" type="number" min="0" value="@draft.Speed"
                           @onchange="e => SetDraft(draft with { Speed = Number(e) })" />
                </Field>
                <Field Label="Control" For="shared-control">
                    <input id="shared-control" type="number" value="@draft.Control"
                           @onchange="e => SetDraft(draft with { Control = Number(e) })" />
                </Field>
                <Field Label="Weapons" For="shared-weapons">
                    <input id="shared-weapons" type="number" min="0" value="@draft.Weapons"
                           placeholder="unarmed"
                           @onchange="e => SetDraft(draft with { Weapons = OptionalNumber(e) })" />
                    <span class="muted small">Leave it empty for a machine with no weapon systems at all.</span>
                </Field>
            }
            else
            {
                @* pp.100–103 give a headquarters no characteristics at all, and the Perk grants
                   the building already furnished — so a base with no features is not an error. *@
                <p class="small muted">
                    A base has no ranks of its own. The building comes with the Perk; every point
                    after that is a feature (p.100).
                </p>
            }

            <Field Label="@DraftFeatureLabel">
                @if (draft.Features.Count > 0)
                {
                    <ChosenList>
                        @foreach (var f in draft.Features.ToList())
                        {
                            <ChosenRow>
                                <Body>@FeatureName(draft, f)</Body>
                                <Actions>
                                    @if (PerUnit(draft, f))
                                    {
                                        <input type="number" min="1" value="@f.Units" class="units"
                                               aria-label="Units"
                                               @onchange="e => SetDraftFeature(draft, f, f with { Units = Number(e) })" />
                                    }
                                    <button type="button" class="btn small danger"
                                            @onclick="() => SetDraftFeature(draft, f, null)">Remove</button>
                                </Actions>
                            </ChosenRow>
                        }
                    </ChosenList>
                }

                <OptionList Placeholder="@DraftFeaturePlaceholder">
                    @foreach (var row in DraftFeatureRows)
                    {
                        <OptionRow Name="@row.Name" Caveat="@row.Description" Cost="@Price(row)"
                                   Keywords="@row.Keywords"
                                   OnSelect="() => AddDraftFeature(draft, row)" />
                    }
                </OptionList>
            </Field>

            @* **Said as it is typed, and not only once it is written down**, which is the whole
               difference between a report and a repair: nothing here refuses the save, and a GM
               who means to write down an object the book does not allow still can. VehicleRanksNote
               above states the two Control sentences; this is what says whether this object keeps
               them. *@
            @foreach (var fault in Session.Check(draft with { Name = DraftTitle }, _contributions))
            {
                <p class="small muted spaced" role="status">@fault.Message</p>
            }

            <div class="inline">
                <button type="button" class="btn primary"
                        disabled="@string.IsNullOrWhiteSpace(_draftName)"
                        @onclick="SaveAsset">Save</button>
                <button type="button" class="btn quiet" @onclick="() => _draft = null">Cancel</button>
            </div>
        </Panel>
    }

    <p class="small muted spaced"><a href="campaign">Back to your campaigns</a></p>
}

@code {
    /// <summary>How far the read of this campaign has got.</summary>
    private enum Reading
    {
        /// <summary>Still asking.</summary>
        Looking,

        /// <summary>Nobody is signed in, so there is no campaign to read.</summary>
        NotSignedIn,

        /// <summary>
        /// Signed in, and this account runs no campaign at that id. Deliberately the same answer
        /// for an id that never existed and one belonging to somebody else: "that exists and is
        /// not yours" is a fact about another account.
        /// </summary>
        NotYours,

        /// <summary>Read.</summary>
        Read,
    }

    /// <summary>
    /// What the open row is showing.
    ///
    /// <para><b>Seven values rather than a nullable sheet and a nullable diff, because four of
    /// them are ways of having nothing to draw and they are not the same sentence.</b> This screen
    /// has already said "there is nothing waiting" about a request a player was waiting on — see
    /// PROGRESS.md finding 8 — and it said it because a payload that could not be opened and a
    /// slot that was empty arrived here as the same null.</para>
    /// </summary>
    private enum Showing
    {
        /// <summary>The read has not answered yet.</summary>
        Asking,

        /// <summary>Nothing could be reached, so nothing is known about this membership.</summary>
        Unreachable,

        /// <summary>
        /// In the campaign, and nothing has ever been sent. There is genuinely no sheet here, and
        /// that is an ordinary state rather than a failure.
        /// </summary>
        NothingSent,

        /// <summary>
        /// A snapshot is waiting and this build cannot open it. <b>Never drawn as
        /// <see cref="NothingSent"/></b>: a player is waiting on a decision about it.
        /// </summary>
        PendingUnreadable,

        /// <summary>The campaign holds a clone this build cannot open. Same rule.</summary>
        CloneUnreadable,

        /// <summary>
        /// The clone, with nothing waiting — the sheet that counts at the table. Named
        /// <c>Settled</c> rather than <c>Approved</c> so it cannot be misread as the decision.
        /// </summary>
        Settled,

        /// <summary>A snapshot is waiting: the diff, and the decision to make about it.</summary>
        Changes,
    }

    /// <summary>Which campaign. A route parameter, so the address names the game.</summary>
    [Parameter] public string? Id { get; set; }

    private Reading _state = Reading.Looking;
    private string? _label;
    private IReadOnlyList<MembershipSummary> _waiting = [];

    /// <summary>
    /// Which of <see cref="_waiting"/> are holding a sheet with nothing on it — see
    /// <see cref="EmptySubmissions"/>, which is where the cost of knowing is argued. Read once
    /// per refresh, beside the roster it describes.
    /// </summary>
    private IReadOnlySet<string> _empty = new HashSet<string>(StringComparer.Ordinal);

    /// <summary>
    /// The campaign itself, or null when its payload could not be read.
    ///
    /// <para><b>The list row is not enough any more.</b> A row carries the label and the join
    /// code; the shared vehicles and bases are inside the payload, which is the one thing the
    /// server never looks into — so drawing them means loading the campaign, not listing it.</para>
    /// </summary>
    private Campaign? _campaign;

    /// <summary>
    /// The game's shared objects with their books open: what its members bought each, what has
    /// been built, and who paid. Empty for a game that owns nothing shared, and for one whose
    /// payload could not be read.
    /// </summary>
    private IReadOnlyList<CampaignAssetLine> _ledger = [];

    /// <summary>
    /// Every contribution any of this campaign's members has recorded, from the same read
    /// <see cref="_ledger"/> is summed from — kept so the draft editor's own live check can ask
    /// about a contribution naming the object being edited, exactly as <see cref="_ledger"/>'s own
    /// findings already do for a saved one.
    /// </summary>
    private IReadOnlyList<CampaignAssetContribution> _contributions = [];

    /// <summary>
    /// Whether the members' sheets were read, which is what every figure on a shared object is
    /// summed from.
    ///
    /// <para><b>It is a separate answer from the campaign, and drawing them as one was the
    /// fault.</b> The objects are in the campaign's payload, which is its own read; the budget is
    /// summed from the clones behind the memberships, which is another. A failed inbox left the
    /// ledger empty and the panel said "Nothing shared yet" — a GM told their machines were gone
    /// on the strength of a request about something else, with Edit and Remove gone too. The same
    /// shape as the roster telling a GM nobody has joined, and reported here rather than
    /// repeated.</para>
    /// </summary>
    private bool _rosterRead;

    /// <summary>Which membership's changes are open, or null.</summary>
    private string? _reading;

    /// <summary>Which membership is one press away from being removed, or null.</summary>
    private string? _removing;

    /// <summary>Which of the seven the open row is showing. Meaningless while nothing is open.</summary>
    private Showing _showing = Showing.Asking;

    private CharacterDiff? _diff;
    private CharacterSheet? _pending;
    private bool? _pendingHasBudget;

    /// <summary>The campaign's clone, when it is the thing on screen rather than a diff's left side.</summary>
    private CharacterSheet? _approved;
    private bool? _approvedHasBudget;

    private int _version;

    /// <summary>Whether the full sheet is shown under the diff.</summary>
    private bool _full;

    /// <summary>What became of the last decision, or null.</summary>
    private string? _said;

    /// <summary>Which id the current read was for, so a route change re-reads.</summary>
    private string? _read;

    private string Title => _label ?? "A campaign";

    private string WaitingAside
    {
        get
        {
            var pending = _waiting.Count(m => m.HasPending);

            return pending == 0 ? "Nothing pending" : $"{pending} pending";
        }
    }

    /// <summary>
    /// The line the screen is led by: what the clone cost and what the snapshot costs.
    ///
    /// <para><b>Both figures are the engine's, for the two sheets.</b> A half-chosen Power is a
    /// question the engine refuses rather than guesses at, and the honest line for that snapshot
    /// says so instead of printing a number nobody asked for.</para>
    /// </summary>
    private static string Spend(CharacterDiff diff)
    {
        if (diff.SpentAfter is not { } after) return "The spend cannot be worked out yet.";

        var budget = diff.Budget is { } cap ? $" of {cap}" : "";

        return diff.SpentBefore is { } before && before != after
            ? $"{before} → {after}{budget} Hero Points"
            : $"{after}{budget} Hero Points";
    }

    /// <summary>One row's movement, written the way the diff's own remarks describe.</summary>
    private static string Was(DiffRow row) => row.Kind switch
    {
        DiffKind.Added => row.After is { } after ? $"added {after}" : "added",
        DiffKind.Removed => row.Before is { } before ? $"removed {before}" : "removed",
        _ => $"{row.Before} → {row.After}",
    };

    /// <summary>
    /// Read the campaign and what is waiting in it, once per id.
    ///
    /// <para><b>Keyed on the id rather than guarded by a bool</b>, because Blazor reuses this
    /// component when only the route parameter changes — a one-shot flag would leave the first
    /// campaign on screen under the second one's address, which is the trap
    /// <c>SheetPage</c> already records.</para>
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_read == Id) return;

        var asked = Id;
        _read = asked;

        _state = Reading.Looking;
        _said = null;
        Close();

        if (string.IsNullOrWhiteSpace(asked))
        {
            _state = Reading.NotYours;
            return;
        }

        if (!await Store.IsAvailableAsync())
        {
            _state = Reading.NotSignedIn;
            return;
        }

        await Refresh(asked);
    }

    private const string RosterUnread =
        "This game's players could not be read just now, so nothing can be said about what has "
        + "been put into these. Nothing has been changed.";

    /// <summary>
    /// What to call an object where its books cannot be opened: its name, or its id when the
    /// table has not given it one. <b>The same fallback <c>AssetFormatter</c> makes</b> when it
    /// prints the pair, so a reader meets one answer either way.
    /// </summary>
    private static string Named(CampaignAsset asset) =>
        string.IsNullOrWhiteSpace(asset.Name) ? asset.Id : asset.Name;

    private string SharedAside =>
        _ledger.Count == 1 ? "1 shared object" : $"{_ledger.Count} shared objects";

    /// <summary>
    /// Every line about a shared object, asked of <c>sheets/</c> and of the engine rather than
    /// composed here — the rule the Vehicles &amp; bases step is written under, and the reason a
    /// figure on this screen cannot disagree with the same figure on a player's.
    ///
    /// <para><b>A null <see cref="CampaignAssetLine.Budget"/> is not handed to
    /// <c>AssetFormatter</c>, which prints no figure this screen has no figure for.</b> The
    /// contribution the budget could not be trusted to sum from is named in its own sentence — the
    /// row's finding, drawn beside this one — so this line says only what is still known: the
    /// object's name and what has been built with it, if anything.</para>
    /// </summary>
    private static string Books(CampaignAssetLine line) =>
        line.Budget is { } budget
            ? AssetFormatter.Describe(line.Asset, line.Spent, budget)
            : Named(line.Asset);

    /// <inheritdoc cref="Books"/>
    private static string Kind(CampaignAsset asset) => AssetFormatter.Describe(asset);

    /// <inheritdoc cref="Books"/>
    private string Features(CampaignAsset asset) =>
        string.Join(", ", asset.Features.Select(
            f => AssetFormatter.Feature(f, Session.Rules, !asset.IsHeadquarters)));

    /// <summary>
    /// Who put in, and how much. <b>Never an account or an address</b> — a membership deliberately
    /// never tells a GM whose account is on the other side of it, and the label the roster above
    /// draws is the same label here.
    /// </summary>
    private static string Funders(CampaignAssetLine line) =>
        line.Contributors.Count == 0
            ? "Nobody has put anything into this yet."
            : string.Join(" · ", line.Contributors.Select(c => $"{c.Who} {c.HeroPoints} HP"));

    private const string OverBudget =
        "More has been built with this than its members have put in. Somebody can put more in, "
        + "or it can lose a feature — nothing has been changed either way.";

    // ── The GM writes one down ────────────────────────────────────────────────

    /// <summary>
    /// The two kinds, off the constants a contribution names them with. <b>One spelling</b>: a
    /// contribution and the object it names have to agree about which currency the pooled Hero
    /// Points buy, and a second copy of either word is a chance for them not to.
    /// </summary>
    private const string Vehicle = CampaignAssetContribution.Vehicle;

    /// <inheritdoc cref="Vehicle"/>
    private const string Headquarters = CampaignAssetContribution.Headquarters;

    /// <summary>What is being named in the add box, and which of the two it will be.</summary>
    private string _naming = "";

    private string _namingKind = Vehicle;

    /// <summary>
    /// The object being written down, or null when none is.
    ///
    /// <para><b>A draft rather than the stored object, edited and then saved in one write.</b>
    /// Every other editor in this app changes a character held in this browser; this one changes a
    /// campaign that lives on a server, so a field bound straight to it would be a request per
    /// number typed — on a panel that is nothing but number boxes.</para>
    /// </summary>
    private CampaignAsset? _draft;

    /// <summary>Whether the draft is one this campaign has never held.</summary>
    private bool _draftIsNew;

    /// <summary>
    /// The draft's name, held beside it because the box is bound as it is typed and the record is
    /// what gets written. It goes onto the draft at the save.
    /// </summary>
    private string _draftName = "";

    /// <summary>Which shared object is one press away from being removed, or null.</summary>
    private string? _dropping;

    /// <summary>What became of the last write, or null. Drawn outside the editor it was about.</summary>
    private string? _saidAboutAsset;

    private string DraftTitle =>
        string.IsNullOrWhiteSpace(_draftName) ? "A shared object" : _draftName.Trim();

    /// <summary>
    /// The books on the draft as it is typed: what it is costing, against what its members have
    /// already put in.
    ///
    /// <para><b>The budget is the one already summed for this object</b>, and nothing for an
    /// object nobody has funded — which is every new one. A GM writing a machine down before the
    /// table has paid for it is the ordinary way round, and the panel says so by reading over
    /// budget from the first feature.</para>
    /// </summary>
    private string DraftBooks(CampaignAsset draft) =>
        AssetFormatter.Describe(draft, CampaignAssets.Spend(Session.Costs, draft), Funded(draft));

    private int Funded(CampaignAsset asset) =>
        _ledger.FirstOrDefault(
            l => string.Equals(l.Asset.Id, asset.Id, StringComparison.Ordinal))?.Budget ?? 0;

    private string DraftFeatureLabel =>
        _draft is { IsHeadquarters: true } ? "Features (pp.100–103)" : "Features (pp.96–100)";

    private string DraftFeaturePlaceholder =>
        _draft is { IsHeadquarters: true } ? "Filter the base features" : "Filter the vehicle features";

    /// <summary>
    /// Which of the two tables the draft picks from. <b>The kind decides it</b>, the same way a
    /// character says it by which of its two collections a machine is stored in.
    /// </summary>
    private IEnumerable<AssetCatalogueRow> DraftFeatureRows =>
        Session.Assets.Rows.Where(r => r.Kind == (_draft is { IsHeadquarters: true }
            ? AssetRowKind.BaseFeature
            : AssetRowKind.VehicleFeature));

    /// <inheritdoc cref="Books"/>
    private string FeatureName(CampaignAsset asset, SelectedAssetFeature feature) =>
        AssetFormatter.Feature(feature, Session.Rules, !asset.IsHeadquarters);

    private bool PerUnit(CampaignAsset asset, SelectedAssetFeature feature) =>
        asset.IsHeadquarters
            ? Session.Assets.FindBaseFeature(feature.FeatureId) is { CostType: "per_unit" }
            : Session.Assets.FindVehicleFeature(feature.FeatureId) is { CostType: "per_unit" };

    /// <inheritdoc cref="Books"/>
    private static string Price(AssetCatalogueRow row) => AssetRows.Price(row);

    /// <summary>
    /// Start writing one down. <b>The id is minted here and never moves again</b>, because every
    /// member's sheet holds it as the record of what they paid for — a key derived from the name
    /// would orphan five contributions the first time somebody disliked the name.
    /// </summary>
    private void StartAsset()
    {
        if (string.IsNullOrWhiteSpace(_naming)) return;

        _draftName = _naming.Trim();
        _draft = new CampaignAsset(StoredCampaign.NewAssetId(), _namingKind, _draftName);
        _draftIsNew = true;
        _naming = "";
        _saidAboutAsset = null;
    }

    private void EditAsset(CampaignAsset asset)
    {
        _draft = asset;
        _draftIsNew = false;
        _draftName = asset.Name;
        _dropping = null;
        _saidAboutAsset = null;
    }

    private void SetDraft(CampaignAsset updated) => _draft = updated;

    /// <summary>
    /// A feature goes on at its cheapest grade, because <c>CostCalculator</c> throws rather than
    /// guessing one — the same answer the Vehicles &amp; bases step gives, from the same helper.
    /// </summary>
    private void AddDraftFeature(CampaignAsset draft, AssetCatalogueRow row)
    {
        var prefix = draft.IsHeadquarters
            ? AssetCatalogue.BaseFeaturePrefix
            : AssetCatalogue.VehicleFeaturePrefix;

        var id = row.Id[prefix.Length..];
        if (draft.Features.Any(f => f.FeatureId == id)) return;

        SetDraft(draft with
        {
            Features = [.. draft.Features,
                        new SelectedAssetFeature(id) { GradeKey = AssetRows.CheapestGrade(row) }]
        });
    }

    private void SetDraftFeature(
        CampaignAsset draft, SelectedAssetFeature old, SelectedAssetFeature? updated) =>
        SetDraft(draft with { Features = Replace(draft.Features, old, updated) });

    /// <summary>
    /// Write the draft into the campaign, and say so when it went nowhere.
    ///
    /// <para><b>A refused save has to be said out loud</b>, because a form that closes and does
    /// nothing is indistinguishable from a control that is not wired up — the rule every refusal
    /// on the campaigns page follows.</para>
    ///
    /// <para><b>The object is replaced by id, never by position.</b> A list rewritten in order
    /// would put one object's features on another the moment two were written down in the same
    /// sitting.</para>
    /// </summary>
    private async Task SaveAsset()
    {
        if (_campaign is not { } game || _draft is not { } draft) return;
        if (string.IsNullOrWhiteSpace(_draftName)) return;

        _saidAboutAsset = null;

        var saved = draft with { Name = _draftName.Trim() };

        var assets = CampaignAsset.On(game).ToList();
        var at = assets.FindIndex(a => string.Equals(a.Id, saved.Id, StringComparison.Ordinal));

        if (at < 0) assets.Add(saved); else assets[at] = saved;

        var outcome = await Store.SaveAsync(game with { Assets = assets });
        if (!outcome.Saved)
        {
            _saidAboutAsset = outcome.Message ?? "That could not be saved just now. Try again in a moment.";
            return;
        }

        _saidAboutAsset = _draftIsNew
            ? "Written down. Every player can now put Hero Points into it from their own sheet."
            : null;

        _draft = null;

        await Refresh();
    }

    /// <summary>
    /// Take a shared object off the campaign.
    ///
    /// <para><b>Nobody's Hero Points are refunded and nobody's sheet is edited</b>, which is the
    /// same answer deleting a campaign gets: their contribution stays, still costs them, and their
    /// own screen reports that it names an object this game has not. Reaching into five characters
    /// to tidy up after a decision about the game would be this application editing work that is
    /// not its own.</para>
    /// </summary>
    private async Task DropAsset(CampaignAsset asset)
    {
        _dropping = null;

        if (_campaign is not { } game) return;

        var kept = CampaignAsset.On(game)
            .Where(a => !string.Equals(a.Id, asset.Id, StringComparison.Ordinal))
            .ToList();

        var outcome = await Store.SaveAsync(game with { Assets = kept });
        if (!outcome.Saved)
        {
            _saidAboutAsset = outcome.Message ?? "That could not be removed just now. Try again in a moment.";
            return;
        }

        if (_draft is { } draft && string.Equals(draft.Id, asset.Id, StringComparison.Ordinal))
            _draft = null;

        _saidAboutAsset = "Removed. Anybody who put into it still has, and their sheet says so.";

        await Refresh();
    }

    private static IReadOnlyList<T> Replace<T>(IReadOnlyList<T> list, T old, T? updated) where T : class =>
        [.. list.SelectMany(item => ReferenceEquals(item, old)
            ? (updated is null ? Array.Empty<T>() : [updated])
            : new[] { item })];

    private static int Number(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var value) ? value : 0;

    private static int? OptionalNumber(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var value) ? value : null;

    private const string Unpriceable =
        "Something on this was built with a feature these rules do not have, so what it has cost "
        + "cannot be worked out here. What its members put in is still counted.";

    /// <summary>
    /// Re-read the campaign and what is waiting in it.
    ///
    /// <para><b>The id it was asked for is passed in and re-checked before anything is written,
    /// and the first version of this got that wrong in a way only a static analyser saw.</b> The
    /// overtake check was <em>after</em> the write, where it does nothing at all: by then the
    /// losing read had already put its answer on screen, and the `return` after it was a redundant
    /// jump statement. So a second navigation arriving mid-read left the wrong campaign under the
    /// right address, with nothing left to notice — verbatim the fault `SheetPage` records and
    /// solves the same way.</para>
    ///
    /// <para>Null for the ordinary refresh after a decision, which is not a navigation and has no
    /// id to lose a race to.</para>
    /// </summary>
    private async Task Refresh(string? asked = null)
    {
        var listed = await Store.ListAsync();

        // Another navigation overtook this read. Its own pass has already reset the fields and
        // will write its own answer; anything written past here would be the wrong campaign under
        // the right address.
        if (asked is not null && !string.Equals(_read, asked, StringComparison.Ordinal)) return;

        var mine = listed.FirstOrDefault(c => c.Id == Id);

        if (mine is null)
        {
            _state = Reading.NotYours;
            return;
        }

        _label = mine.Label;

        // **The payload, not the row.** A shared vehicle or base lives inside it, and the list
        // above carries only what the server can read — a label and a join code. Null is a payload
        // this build cannot open or a read that failed, which the panel says out loud rather than
        // drawing as a game that owns nothing.
        _campaign = await Store.LoadAsync(mine.Id);

        var inbox = await Memberships.InboxAsync();

        // Null means the inbox could not be read, which is not the same as an empty campaign — so
        // the list stays as it was rather than reporting that everybody has left.
        _rosterRead = inbox is not null;

        IReadOnlyList<(string MembershipId, string Who, CharacterSheet Sheet)> clones = [];

        if (inbox is not null)
        {
            _waiting = [.. inbox.Where(m => m.CampaignId == Id)];

            // **One pass, two answers.** Both need the payload behind each row, and the server
            // hands one back only when it is asked for by membership — so a second pass for the
            // budget would ask for every player's sheet twice on the screen that already costs the
            // most to open.
            var read = await CampaignRoster.ReadAsync(Memberships, Session, _waiting);

            _empty = read.Empty;
            clones = read.Clones;
        }

        // **Outside the branch, because the objects are not in it.** They come out of the
        // campaign's own payload, read above; only what has been put into them needs the clones.
        // Built inside, a failed inbox drew a game that owns nothing over a payload this screen
        // had already opened the objects out of.
        _ledger = Session.AssetLedger(_campaign, clones);
        _contributions = [.. clones.SelectMany(m => m.Sheet.CampaignAssets)];

        _state = Reading.Read;
    }

    /// <summary>
    /// Open one member: the changes waiting on a decision, or the sheet the campaign holds.
    ///
    /// <para><b>A member with nothing waiting used to open nothing at all.</b> Both early returns
    /// below were bare <c>return</c>s, so an unreachable server and a character with no snapshot
    /// both left the panel blank — and a GM had no way to read an approved sheet for as long as
    /// nobody changed it. Every path now sets <see cref="_showing"/>, which is what makes the
    /// blank panel unreachable rather than merely unlikely.</para>
    /// </summary>
    private async Task Look(string membershipId)
    {
        _said = null;
        _full = false;

        if (_reading == membershipId)
        {
            Close();
            return;
        }

        Close();
        _reading = membershipId;

        var detail = await Memberships.ReadAsync(membershipId);

        // **A second row opened while this one was in flight.** Its own pass has already reset
        // these fields and will write its own answer, so anything written past here would put one
        // member's sheet under another member's name — the race `Refresh` records above, on a
        // control a GM can press twice faster than a network answers.
        if (!string.Equals(_reading, membershipId, StringComparison.Ordinal)) return;

        if (detail is null)
        {
            _showing = Showing.Unreachable;
            return;
        }

        // The list row is the only thing that can tell an empty slot from one this build could
        // not read: the detail answers null for both, and the row says whether the server thinks
        // there is something there.
        var row = _waiting.FirstOrDefault(m => m.Id == membershipId);

        if (detail.Pending is { } pending)
        {
            _pending = pending;
            _pendingHasBudget = !pending.UnlimitedBudget;
            _version = detail.PendingVersion;
            _diff = CampaignDiff.Between(detail.Approved, pending, Session.Rules, Session.Costs);
            _showing = Showing.Changes;
            return;
        }

        if (row?.HasPending == true)
        {
            _showing = Showing.PendingUnreadable;
            return;
        }

        if (detail.Approved is { } settled)
        {
            _approved = settled;
            _approvedHasBudget = !settled.UnlimitedBudget;
            _showing = Showing.Settled;
            return;
        }

        _showing = row?.HasApproved == true ? Showing.CloneUnreadable : Showing.NothingSent;
    }

    /// <summary>
    /// Remove somebody from the game. The row goes, and the campaign's clone with it.
    ///
    /// <para><b>The player's own character is untouched.</b> Their rows are theirs, and a removal
    /// is a decision about this campaign's roster rather than about somebody else's work — the
    /// same line a rejection draws, and for the same reason.</para>
    /// </summary>
    private async Task Remove(string membershipId)
    {
        _removing = null;

        var left = await Memberships.LeaveAsync(membershipId);

        if (_reading == membershipId) Close();

        await Refresh();

        // **Set after the refresh, and only while this campaign is still on screen.** The one
        // refusal a GM can reach here is `GameIsGone`, and the only way to reach it is to have
        // deleted the game — at which point `Refresh` has already moved the page to `NotYours`,
        // where nothing in this panel is drawn. A sentence written for that state would be
        // composed and thrown away unrendered, which is verbatim the fault finding 7 records
        // about this very screen. So the page answers it by being the right page instead.
        if (_state != Reading.Read) return;

        _said = left == LeftOutcome.Done
            ? "Removed. This campaign no longer holds that character."
            : "Nothing could be reached just now. Try again in a moment.";
    }

    /// <summary>
    /// Close the open row, leaving nothing of it behind.
    ///
    /// <para>One door rather than three, because every caller that forgot one of these fields
    /// would leave the previous member's sheet to be drawn under the next member's name.</para>
    /// </summary>
    private void Close()
    {
        _reading = null;
        _showing = Showing.Asking;
        _diff = null;
        _pending = null;
        _approved = null;
    }

    /// <summary>
    /// Accept or turn down the snapshot on screen, naming the version it was read at.
    ///
    /// <para><b>A stale decision is refused and the newer snapshot is drawn</b>, rather than being
    /// applied to whatever is current. That is a real defect if it is skipped: the GM would approve
    /// a character nobody had looked at.</para>
    /// </summary>
    private async Task Decide(string membershipId, bool approve)
    {
        var decision = approve
            ? await Memberships.ApproveAsync(membershipId, _version)
            : await Memberships.RejectAsync(membershipId, _version);

        switch (decision.Outcome)
        {
            case DecisionOutcome.Done:
                _said = approve ? "Approved. The campaign holds this sheet now." : "Turned down.";
                Close();
                break;

            case DecisionOutcome.Stale when decision.Newer is { } newer:
                _said = "This changed while you were reading it. The newer version is below.";
                _pending = newer;
                _pendingHasBudget = !newer.UnlimitedBudget;
                _version = decision.NewerVersion;
                _diff = CampaignDiff.Between(
                    (await Memberships.ReadAsync(membershipId))?.Approved,
                    newer, Session.Rules, Session.Costs);

                // Stated rather than inherited from the read that opened this row. It is already
                // `Changes` on every path that reaches here, and a branch that relies on that is
                // a branch a later edit breaks silently.
                _showing = Showing.Changes;
                break;

            // Stale with nothing to draw is NOT "nothing waiting", and saying so was wrong on
            // screen: a snapshot is there, this build could not read it. `DecideAsync` reaches
            // here whenever `StoredCharacter.Read` returns null for the newer payload — an
            // envelope from a later version of the app, which the store's own notes treat as an
            // ordinary thing to meet rather than an error.
            case DecisionOutcome.Stale:
                _said = "This changed while you were reading it, and the newer version could not "
                    + "be opened here. Reload before deciding.";
                Close();
                break;

            case DecisionOutcome.NothingWaiting:
                _said = "There is nothing waiting here now.";
                Close();
                break;

            default:
                _said = "Nothing could be reached just now. Try again in a moment.";
                break;
        }

        await Refresh();
    }
}
