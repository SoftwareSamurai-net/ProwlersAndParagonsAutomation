root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# ── Language conventions ──────────────────────────────────────────────────
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:silent
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent
dotnet_style_prefer_collection_expression = true:suggestion
dotnet_style_namespace_match_folder = false

# ── Analyzer rule tuning ──────────────────────────────────────────────────
# The rules below are deliberate project decisions, not unreviewed suppressions.

# CA1305/CA1304: culture-sensitive formatting.
# Every ToString()/string interpolation in this codebase produces text a human
# reads in a terminal or in an exported character sheet. Current culture is the
# correct choice for that, so the invariant-culture rule does not apply.
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1304.severity = none

# CA1822: "can be marked static".
# CostCalculator and DerivedStatsCalculator expose a single uniform instance API;
# some methods happen not to touch _rules today, but flipping those to static
# would split the calling convention for no real gain.
dotnet_diagnostic.CA1822.severity = suggestion

# CA1848: LoggerMessage delegates — this is a console wizard, not a service.
dotnet_diagnostic.CA1848.severity = none

# ── ReSharper / Qodana inspections ────────────────────────────────────────
#
# The target is a Qodana report with nothing in it, so that anything it does say
# is worth reading. Before this, a whole-tree scan reported 242 problems of which
# about 200 were three structural facts restated, and a report where 80% is noise
# is one nobody reads.
#
# These live here rather than in qodana.yaml's `exclude:` list, which looks like
# it would do the same job and does not — the .NET linter is ReSharper, and
# ReSharper takes its inspection severities from EditorConfig. A named exclusion
# in qodana.yaml is silently ignored, and the finding still reports. The upside
# is that Rider and the ReSharper command-line tools now agree with CI, which a
# qodana.yaml entry would never have given.
#
# Nothing here is a blanket severity floor and nothing is baselined. Each entry
# is scoped as tightly as the tool allows and says why.

# Explicit constructors, not primary constructors. Most declarations in this
# codebase carry an XML doc comment, and a primary constructor has nowhere to put
# one per parameter; it also hides the assignment that makes a dependency
# readonly. Applied consistently across all five projects.
resharper_convert_to_primary_constructor_highlighting = none

# The `field` keyword. All eleven hits are RulesRepository's lazy accessors, and
# that class is deliberately explicit about what it caches and when — a backing
# field with a name is the documentation.
resharper_replace_with_field_keyword_highlighting = none

[engine/Models/*.cs]
# These records are the shape of data/rules/*.json and nothing else. Every one is
# constructed by System.Text.Json through reflection, and every property is
# settable so that it can be; nothing in this codebase calls a constructor or
# assigns a setter, and it must stay that way.
#
# Acting on any of these four would silently drop a field from the deserialized
# rules. The failure mode is not a build error — it is a rule that quietly stops
# applying, which is the one failure this project cannot afford.
resharper_unused_auto_property_accessor_global_highlighting = none
resharper_auto_property_can_be_made_get_only_global_highlighting = none
resharper_unused_member_global_highlighting = none
resharper_class_never_instantiated_global_highlighting = none

[web/Components/SheetView.razor]
# `item.Name ?? ""` on a piece of gear the engine could not price. SelectedGear.Name is
# declared non-null and a deserializer puts a null there regardless — the same objection
# already recorded for engine/CharacterValidator.cs and engine/CharacterSheetJson.cs, now
# reaching a sheet because this component renders a character it did not build.
#
# The two spellings pull opposite inspections and only one can be silenced honestly: written
# as a nullable return instead, ReturnTypeCanBeNotNullable fires on exactly the same false
# premise. Acting on either puts a NullReferenceException back into a render, which in the
# browser takes the whole app down rather than one box.
resharper_null_coalescing_condition_is_always_not_null_according_to_api_contract_highlighting = none

[engine/TranscriptLibrary.cs]
# The same objection as engine/Models above, one level in: Envelope and
# TurnEnvelope are the shape of data/transcripts/*.json, constructed only by
# System.Text.Json through reflection. The `.Local` variants rather than the
# `.Global` ones because these two are private to the reader — which is where
# they belong, since nothing outside it should know the file format.
#
# Acting on either would silently drop a field from a loaded transcript, and a
# transcript that loses a field does not fail to load: it replays a conversation
# with a line or a character quietly missing from it.
resharper_unused_auto_property_accessor_local_highlighting = none
resharper_class_never_instantiated_local_highlighting = none

[tests/ProwlersAndParagonsAutomation.Tests/RenderContextWiringTests.cs]
# Deliberate is deliberately empty — the class comment says so. It is an exemption
# list ready to be populated, read by TheTestContextRegistersEveryServiceTheAppDoes
# and by the staleness guard TheGuardIsLookingAtSomething, so the shape has to stay.
# Populating it just to satisfy the inspection would put a fake exemption into the
# test that the staleness guard would then rightly refuse.
resharper_collection_never_updated_local_highlighting = none

[web/Services/ApiCharacterStore.cs]
# The same objection as engine/Models and engine/TranscriptLibrary above, over
# the wire this time: Wired, Listed and Sending are the shape of the accounts
# API's JSON payloads, constructed and read only by System.Text.Json through
# reflection. Every positional record parameter is a JsonPropertyName-bound
# property that nothing in this class touches by name — the whole record either
# serializes or deserializes and then is dropped.
#
# Acting on any of these would silently drop a field from the wire: a request
# without its payload, or a listing that lost the label the manager renders.
# Neither would fail to build; both would ship a broken account seam.
resharper_not_accessed_positional_property_local_highlighting = none
resharper_class_never_instantiated_local_highlighting = none

[web/Services/ApiCampaignStore.cs]
# The same objection as web/Services/ApiCharacterStore.cs directly above, for the
# campaign half of the same wire. Wired, Listed and Sending are the shapes of the
# JSON the /api/campaigns addresses exchange, constructed and read only by
# System.Text.Json through reflection: every positional parameter is a
# JsonPropertyName-bound property that nothing in this class touches by name.
#
# Acting on any of these would silently drop a field from the wire — a PUT with
# no label, or a listing that lost the name the GM gave the game. Neither fails
# to build; both ship a broken seam.

resharper_not_accessed_positional_property_local_highlighting = none
resharper_class_never_instantiated_local_highlighting = none

[web/Services/CampaignMembership.cs]
# The same objection as web/Services/ApiCharacterStore.cs above, for the approval
# half of the same wire — and one addition that is not about the wire at all.
#
# The ten private Wired*/Joining/Sending/Deciding records are the shapes of the
# JSON the /api/memberships addresses exchange. Every positional parameter is a
# JsonPropertyName-bound property, so acting on any inspection here would silently
# drop a field from the wire — a decision with no version, which is the
# compare-and-swap gone — and would not fail to build. AccountsContractTests reads
# these records against the server's own object literals precisely because a
# dropped field is otherwise invisible.
#
# **Only some of the ten are wholly unread, and this comment used to claim all of
# them were.** It said "five" — there are ten — and "nothing in this class touches
# them by name", which is false of most: WiredRow is read field by field in
# ListAsync, WiredDetail in ReadAsync, WiredRefusal in DecideAsync, WiredVersion in
# SubmitAsync and WiredCode in RotateCodeAsync. What actually needs the exemption is
# the narrower set — WiredJoin's CampaignId and Label, which nothing reads, and the
# three request-only records (Joining, Sending, Deciding), which System.Text.Json
# constructs by reflection and nothing here ever instantiates. The suppression is
# file-scoped either way; the rationale is what a maintainer reads to decide whether
# it still applies, so it has to be true of the file it sits on.
#
# MembershipSummary and MembershipDetail are public and .Global for the reason
# Invitations' Invitation is: the screens render them. Their unread positional
# properties are the fields the server sends and no screen prints yet — a
# membership's ApprovedAt and PendingAt beside the standing it does print, and the
# ids and labels a page reads off the *summary* rather than off the detail. Each is
# bound because the server sends it, and acting on the inspection would delete the
# property, which quietly takes the field off the client side of the wire. The same
# trap CreatedAt and FirstAt are exempted for above.
#
# A "sent three hours ago" beside a waiting request is the obvious next thing to
# show, and Ages.Since already exists to say it.
resharper_not_accessed_positional_property_local_highlighting = none
resharper_not_accessed_positional_property_global_highlighting = none
resharper_class_never_instantiated_local_highlighting = none

[web/Services/StoredCampaign.cs]
# SavedCampaignSummary is a public record the campaign screen renders, and
# UpdatedAt is the field the server sends that no screen prints yet — the campaign
# list is short and mostly unchanging, so it carries no time today, unlike the
# character list which shows one once there are two rows to tell apart. It is bound
# because worker/campaigns.js puts updated_at on every row and because the list is
# ordered by it; acting on the inspection would delete the property, which does not
# fail to build and quietly takes the field off the client side of the wire.
resharper_not_accessed_positional_property_global_highlighting = none

[web/Services/Invitations.cs]
# The same objection as web/Services/ApiCharacterStore.cs directly above, for the
# other half of the accounts wire. Invitation is the shape of what GET
# /api/admin/invitations answers with: System.Text.Json constructs it through
# reflection, so ClassNeverInstantiated is simply wrong about it.
#
# CreatedAt is the one nothing reads yet. It is bound because the server sends it
# — worker/invitations.js puts created_at on every row — and an admin list that
# says when an address was added is the obvious next thing to show. Acting on the
# inspection would delete the property, which does not fail to build and quietly
# takes the field off the client side of the wire.
#
# .Global rather than .Local because the record is public: the page renders it, so
# it cannot be private to the file that parses it.
resharper_class_never_instantiated_global_highlighting = none
resharper_not_accessed_positional_property_global_highlighting = none

[web/Services/ErrorLog.cs]
# The fourth instance of the objection recorded on ApiCharacterStore, Invitations and
# RulebookReader below: ErrorLogRow and the private Wired/WiredRow pair are the shape of
# what GET /api/admin/error-log answers with, and System.Text.Json constructs every one
# of them by reflection. ClassNeverInstantiated is simply wrong about them.
#
# FirstAt is the unread positional property. It is bound because the server sends it —
# worker/errors.js writes first_at on every row, and it is what tells an outage that
# started last month from one that started this morning, which is the distinction the
# migration's own comment says the count exists to preserve. The panel prints how long
# ago the failure last happened and not yet when it began; acting on the inspection would
# delete the property, which does not fail to build and quietly takes the field off the
# client side of the wire.
resharper_class_never_instantiated_local_highlighting = none
resharper_class_never_instantiated_global_highlighting = none
resharper_not_accessed_positional_property_global_highlighting = none

[web/Services/RulebookReader.cs]
# The third instance of the same objection, for the rulebook wire. RulebookChapter,
# RulebookContents, RulebookResult, RulebookResults and RulebookPassage are the
# shapes of what the four /api/rulebook/ addresses answer with: System.Text.Json
# constructs every one of them through reflection, so ClassNeverInstantiated is
# simply wrong about all five.
#
# The unread positional properties are the fields the server sends and the page
# does not print yet — a result's ChapterTitle and SourceRef beside the citation it
# does print, a passage's own Chapter and Index, the query echoed back. Each is
# bound because worker/rulebook.js puts it on the wire, and acting on the
# inspection would delete the property: that does not fail to build, and it quietly
# takes the field off the client side of the wire. The same trap CreatedAt is
# exempted for above.
#
# MatchedTerms is the one worth naming. It is how a reader would be shown *which*
# of their words a passage used, which is the honest companion to the flags this
# search is built around — not printed yet, and the field it needs is already
# arriving.
#
# .Global rather than .Local because the records are public: the page renders them,
# so they cannot be private to the file that parses them.
resharper_class_never_instantiated_global_highlighting = none
resharper_not_accessed_positional_property_global_highlighting = none

[engine/CharacterValidator.cs]
# Since the headless build command, this file's job includes checking a character
# somebody else wrote — and a deserializer hands back null for a property whose
# declared type says it cannot be null. So `choice.Id is not null` and its like
# are checks against something that has actually happened: `{"Perks":[{"PerkId":
# null}]}` is well-formed JSON, and unguarded it crashed the command with an exit
# code outside the three it documents. Six such payloads did.
#
# ReSharper reads the annotations and calls the checks impossible. Acting on it
# would delete the guards and restore that crash. See
# HeadlessBuildTests.ACharacterWithNullsWhereIdsBelongIsReportedNotThrown.
#
# The conditional-access one is the same objection about `choice?.Id`, where the
# entry itself can be null — `{"Pros":[null]}` — as well as its id.
resharper_condition_is_always_true_or_false_according_to_nullable_api_contract_highlighting = none
resharper_conditional_access_qualifier_is_non_nullable_according_to_api_contract_highlighting = none

[engine/CharacterSheetJson.cs]
# This file reads JSON somebody else wrote — a browser's stored character, or one
# submitted to the build command — and its whole job is that the declared types
# are not to be trusted. System.Text.Json hands back null for a property whose
# type says it cannot be null — an absent key, an older build's payload, a file
# edited by hand — so every null check here is a check against something that has
# actually happened, not against the annotation.
#
# ReSharper reads the annotations and calls the checks impossible. Acting on it
# would delete the guards and restore the bug they were written for: a stored
# {"Version":1,"Mode":0} threw before the first render, so the app did not start
# at all. There are tests for each one; see CharacterStoreTests and
# HeadlessBuildTests.ACharacterWithNullsWhereIdsBelongIsReportedNotThrown.
#
# The exception used to be scoped to web/Services/CharacterStore.cs, which is
# where this code was until both front ends needed it.
resharper_condition_is_always_true_or_false_according_to_nullable_api_contract_highlighting = none
resharper_null_coalescing_condition_is_always_not_null_according_to_api_contract_highlighting = none
# `f?.FeatureId`, where the list entry itself can be null as well as its id.
resharper_conditional_access_qualifier_is_non_nullable_according_to_api_contract_highlighting = none

[sheets/CharacterSheetRenderer.cs]
# JsonValue.Create(...) is declared to return JsonValue?, so the null-forgiving
# operator is load-bearing: removing it fails the warnings-as-errors build. The
# inspection has been wrong here since the JSON export was written.
resharper_redundant_suppress_nullable_warning_expression_highlighting = none

[tests/**.cs]
# xunit constructs RulesFixture through ICollectionFixture<T>, which the
# inspection cannot see.
resharper_class_never_instantiated_global_highlighting = none

# CanonicalPowers.Entry.Printed and PrebuiltHeroes.Hero.Page/Note record where in
# the rulebook a value came from. Nothing reads them, deliberately: they are
# there so the next person can check the entry against the printed page rather
# than trust the transcription.
resharper_not_accessed_positional_property_global_highlighting = none

# A test's whole job is to assert on its parameter. ReSharper reads
# Assert.False(...) as a precondition guard — right in production code, wrong in
# the body of a [Theory].
resharper_parameter_only_used_for_precondition_check_local_highlighting = none

# Same JsonValue.Create story as CharacterSheetRenderer, in the test that mirrors
# its output.
resharper_redundant_suppress_nullable_warning_expression_highlighting = none

# RulebookCorpusTests.Chapter/Section and ProConApplicabilityTests.Chapter/Section
# are the shape of data/rulebook/*.json, private to the file that reads it and
# constructed only by System.Text.Json through reflection. The `.Local` variant
# rather than the `.Global` one above for the same reason as
# engine/TranscriptLibrary.cs: nothing outside the reader should know the format.
#
# Acting on it would delete the record and with it the test's ability to read the
# corpus at all.
resharper_class_never_instantiated_local_highlighting = none

# ValidationIssueStructureTests builds characters with nulls where ids belong —
# {"Pros":[null]}, a null FeatureId — because that is what the validator has to
# survive and what the headless command shipped a crash on. The declared types
# say those cannot be null; the payloads say otherwise, which is the whole point
# of the case list. Same objection as engine/CharacterValidator.cs and
# engine/CharacterSheetJson.cs, in the tests that drive them.
resharper_condition_is_always_true_or_false_according_to_nullable_api_contract_highlighting = none
resharper_conditional_access_qualifier_is_non_nullable_according_to_api_contract_highlighting = none
resharper_null_coalescing_condition_is_always_not_null_according_to_api_contract_highlighting = none

[tools/**.cs]
# ChapterFile and Section are the shape of the JSON this tool writes: every
# positional property is read by System.Text.Json when it serializes them and by
# nothing else. Acting on it would drop a field from data/rulebook/*.json, which
# is not a build error — it is a corpus quietly missing its page references.
resharper_not_accessed_positional_property_global_highlighting = none

# `const int PageOffset` and `const string ExtractionNote` are compile-time
# constants and are spelled the way constants are spelled everywhere else here.
# ReSharper's "Local constants" rule wants camelCase, which would make a constant
# look like a variable; the offset in particular is a fact about the book, not a
# working value. Scoped to this tool, which is the only place the two live.
resharper_inconsistent_naming_highlighting = none
