{
  "mcpServers": {
    "prowlers-and-paragons": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "mcp/ProwlersAndParagons.Mcp.csproj",
        "--configuration",
        "Release",
        "--verbosity",
        "quiet",
        "--no-build"
      ],
      "env": {
        "DOTNET_NOLOGO": "1",
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
        "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1"
      }
    }
  }
}
